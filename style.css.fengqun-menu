:root {
  color-scheme: light;
  --bg: #f5f6fb;
  --side: #ffffff;
  --card: #ffffff;
  --text: #1f2225;
  --muted: #60646c;
  --soft: #8b9099;
  --line: #e5e7eb;
  --line-strong: #d8dce3;
  --active: #eef0f2;
  --accent: #18a058;
  --accent-deep: #0e7a3f;
  --danger: #d03050;
  --warning: #f0a020;
}

/* compact-20260625 */
.app-layout {
  grid-template-columns: 208px minmax(0, 1fr);
}

.side-brand {
  height: 54px;
  padding: 0 16px;
  font-size: 16px;
}

.brand-mark {
  width: 28px;
  height: 28px;
  border-radius: 5px;
  font-size: 16px;
}

.side-menu {
  gap: 3px;
  padding: 4px 4px 18px;
}

.side-group {
  margin: 14px 12px 5px;
  font-size: 12px;
}

.side-item {
  grid-template-columns: 22px 1fr;
  gap: 9px;
  min-height: 36px;
  padding: 0 12px;
  font-size: 13px;
}

.side-item.active::before {
  left: -4px;
  height: 36px;
}

.side-icon {
  width: 20px;
  height: 20px;
  transform: scale(.86);
}

.topbar {
  height: 52px;
  padding: 0 14px;
}

.breadcrumb,
.account-pill {
  gap: 7px;
}

.avatar-dot {
  width: 24px;
  height: 24px;
}

.top-link {
  height: 28px;
  padding: 0 9px;
  font-size: 13px;
}

.shell {
  min-height: calc(100vh - 52px);
  padding: 12px;
}

.page-title {
  margin: 2px 0 12px;
}

h1 {
  font-size: 20px;
}

h2 {
  font-size: 16px;
}

h3 {
  margin-bottom: 8px;
  font-size: 17px;
}

.notice-card {
  min-height: 132px;
  margin-bottom: 12px;
  padding: 18px 20px;
}

.notice-card::after {
  right: 8%;
  top: 18px;
  width: 250px;
  height: 118px;
  border-width: 12px;
}

.notice-card span {
  height: 26px;
  margin-bottom: 28px;
  padding: 0 8px;
  font-size: 13px;
}

.notice-card h1 {
  margin-bottom: 8px;
  font-size: 18px;
}

.notice-card p {
  font-size: 14px;
}

.n-card,
.panel,
.metric,
.notice {
  margin-bottom: 12px;
  border-radius: 5px;
}

.n-card-header {
  min-height: 48px;
  padding: 0 16px;
}

.n-card-content {
  padding: 0 16px 16px;
}

.sub-card {
  gap: 12px;
}

.sub-main h3 {
  margin-bottom: 10px;
}

.sub-main p {
  margin-bottom: 8px;
}

.usage-line {
  height: 6px;
}

.shortcut-row {
  grid-template-columns: minmax(0, 1fr) 76px;
  gap: 12px;
  min-height: 52px;
  padding: 8px 16px;
}

.shortcut-row b {
  font-size: 14px;
}

.shortcut-row p {
  font-size: 13px;
}

.grid.plans {
  grid-template-columns: repeat(auto-fill, minmax(238px, 1fr));
  gap: 12px;
}

.plan {
  min-height: 0;
}

.plan-head {
  min-height: 58px;
  padding: 14px 16px 8px;
}

.plan-head h2 {
  margin-bottom: 4px;
}

.plan-head b {
  font-size: 21px;
}

.plan-body {
  padding: 0 16px 12px;
}

.plan-body p {
  margin-bottom: 8px;
}

.plan-body ul {
  gap: 6px;
}

.plan form {
  padding: 12px 16px;
}

.radio-tabs span {
  min-height: 30px;
  padding: 0 11px;
  font-size: 13px;
}

.panel {
  padding: 18px;
}

.panel.narrow {
  max-width: 460px;
  margin: 24px auto;
}

.form {
  gap: 12px;
}

label {
  gap: 5px;
  font-size: 13px;
}

input,
select,
textarea {
  min-height: 36px;
  padding: 7px 10px;
}

button,
.button,
.copy-action {
  min-height: 30px;
  padding: 0 12px;
  font-size: 13px;
}

th,
td {
  padding: 10px 12px;
}

th {
  font-size: 12px;
}

.badge {
  min-height: 22px;
  padding: 1px 7px;
  font-size: 12px;
}

.payment-placeholder {
  min-height: 138px;
  margin: 12px 0;
}

.stack {
  gap: 10px;
}

.kv {
  gap: 7px 12px;
}

.notice {
  padding: 10px 12px;
}

.empty-state {
  gap: 8px;
  padding: 8px 0;
}

.docs-title {
  align-items: flex-end;
}

.docs-title p {
  margin: 4px 0 0;
}

.docs-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.doc-card {
  margin-bottom: 0;
}

.doc-copy {
  color: #33363b;
}

.doc-copy p,
.doc-copy ul,
.doc-copy ol,
.doc-copy dl {
  margin-top: 0;
  margin-bottom: 10px;
}

.doc-copy ul,
.doc-copy ol {
  padding-left: 20px;
}

.doc-copy li {
  margin-bottom: 5px;
}

.faq-list {
  display: grid;
  gap: 8px;
}

.faq-list dt {
  font-weight: 700;
}

.faq-list dd {
  margin: -6px 0 0;
  color: var(--muted);
}

@media (max-width: 980px) {
  .app-layout {
    grid-template-columns: 1fr;
  }

  .side-brand {
    height: 50px;
  }

  .docs-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .topbar {
    height: auto;
    padding: 10px 12px;
  }

  .notice-card {
    min-height: 128px;
    padding: 16px;
  }

  .notice-card span {
    margin-bottom: 18px;
  }

  .shortcut-row {
    grid-template-columns: 1fr auto;
    padding: 8px 12px;
  }

  .n-card-header,
  .n-card-content {
    padding-left: 14px;
    padding-right: 14px;
  }
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--bg);
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font: 14px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

a:hover {
  color: var(--accent);
}

.app-layout {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  min-height: 100vh;
}

.sidebar {
  position: sticky;
  top: 0;
  align-self: start;
  height: 100vh;
  overflow-y: auto;
  background: var(--side);
  border-right: 1px solid var(--line);
}

.side-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 66px;
  padding: 0 20px;
  color: #202124;
  font-size: 17px;
  font-weight: 700;
  border-bottom: 1px solid var(--line);
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 31px;
  height: 31px;
  border-radius: 6px;
  background: #d92d42;
  color: #ffffff;
  font-size: 18px;
  font-weight: 900;
}

.side-menu {
  display: grid;
  gap: 6px;
  padding: 0 5px 24px;
}

.side-group {
  margin: 20px 13px 8px;
  color: #7b818c;
  font-size: 14px;
}

.side-item {
  position: relative;
  display: grid;
  grid-template-columns: 26px 1fr;
  align-items: center;
  gap: 10px;
  min-height: 42px;
  padding: 0 14px;
  border-radius: 3px;
  color: #25272b;
  font-size: 14px;
}

.side-item.active {
  background: var(--active);
  color: #15171a;
  font-weight: 650;
}

.side-item.active::before {
  content: "";
  position: absolute;
  left: -5px;
  top: 0;
  width: 4px;
  height: 42px;
  background: #1f2328;
}

.side-item:hover {
  background: #f3f4f6;
  color: #15171a;
}

.side-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 4px;
  color: #2c2f35;
}

.side-icon::before,
.side-icon::after {
  content: "";
  position: absolute;
  display: block;
}

.icon-home::before {
  width: 11px;
  height: 9px;
  bottom: 4px;
  border: 2px solid #20242a;
  border-top: 0;
}

.icon-home::after {
  width: 10px;
  height: 10px;
  top: 4px;
  border-left: 2px solid #20242a;
  border-top: 2px solid #20242a;
  transform: rotate(45deg);
}

.icon-doc::before {
  width: 13px;
  height: 15px;
  border: 2px solid #20242a;
  border-radius: 2px;
}

.icon-doc::after {
  width: 8px;
  height: 5px;
  top: 8px;
  border-top: 2px solid #20242a;
  border-bottom: 2px solid #20242a;
}

.icon-list::before {
  width: 14px;
  height: 10px;
  border-top: 2px solid #20242a;
  border-bottom: 2px solid #20242a;
}

.icon-list::after {
  width: 14px;
  border-top: 2px solid #20242a;
}

.icon-bag::before {
  width: 13px;
  height: 12px;
  bottom: 3px;
  border: 2px solid #20242a;
  border-radius: 2px;
}

.icon-bag::after {
  width: 7px;
  height: 5px;
  top: 4px;
  border: 2px solid #20242a;
  border-bottom: 0;
  border-radius: 7px 7px 0 0;
}

.icon-status::before {
  width: 15px;
  height: 15px;
  border: 2px solid #20242a;
  border-radius: 50%;
}

.icon-status::after {
  width: 7px;
  height: 4px;
  border-left: 2px solid #20242a;
  border-bottom: 2px solid #20242a;
  transform: rotate(-45deg);
}

.icon-user::before {
  width: 7px;
  height: 7px;
  top: 3px;
  border: 2px solid #20242a;
  border-radius: 50%;
}

.icon-user::after {
  width: 15px;
  height: 7px;
  bottom: 3px;
  border: 2px solid #20242a;
  border-radius: 12px 12px 0 0;
  border-bottom: 0;
}

.icon-admin::before {
  width: 14px;
  height: 14px;
  border: 2px solid #20242a;
  border-radius: 50%;
}

.icon-admin::after {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #20242a;
}

.icon-invite::before {
  width: 14px;
  height: 10px;
  bottom: 4px;
  border: 2px solid #20242a;
  border-radius: 2px;
}

.icon-invite::after {
  width: 8px;
  height: 8px;
  top: 4px;
  right: 2px;
  border-top: 2px solid #20242a;
  border-right: 2px solid #20242a;
  transform: rotate(45deg);
}

.icon-ticket::before {
  width: 15px;
  height: 12px;
  border: 2px solid #20242a;
  border-radius: 3px;
}

.icon-ticket::after {
  width: 7px;
  border-top: 2px dashed #20242a;
  transform: rotate(90deg);
}

.icon-traffic::before {
  width: 14px;
  height: 14px;
  border-left: 2px solid #20242a;
  border-bottom: 2px solid #20242a;
}

.icon-traffic::after {
  width: 11px;
  height: 8px;
  border-top: 2px solid #20242a;
  border-right: 2px solid #20242a;
  transform: rotate(-35deg);
}

.muted-item {
  color: #4b5563;
}

.workspace {
  min-width: 0;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 60px;
  padding: 0 16px;
  background: #ffffff;
  border-bottom: 1px solid #eef0f3;
}

.breadcrumb,
.account-pill {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
}

.breadcrumb {
  color: #25272b;
  font-size: 14px;
}

.breadcrumb b {
  font-weight: 600;
}

.menu-mark {
  width: 18px;
  height: 14px;
  border-top: 2px solid #30343a;
  border-bottom: 2px solid #30343a;
}

.menu-mark::after {
  content: "";
  display: block;
  margin-top: 4px;
  border-top: 2px solid #30343a;
}

.account-pill {
  color: #2f3338;
  white-space: nowrap;
}

.avatar-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #2f3338;
}

.top-link {
  display: inline-flex;
  align-items: center;
  height: 30px;
  padding: 0 10px;
  border: 1px solid var(--line);
  border-radius: 4px;
  color: #33363b;
}

.shell {
  min-height: calc(100vh - 60px);
  padding: 16px;
  background: var(--bg);
}

.page-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 8px 0 22px;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 0;
  font-size: 24px;
  line-height: 1.3;
  font-weight: 650;
}

h2 {
  margin: 0;
  font-size: 18px;
  line-height: 1.35;
  font-weight: 600;
}

h3 {
  margin-bottom: 12px;
  font-size: 20px;
  line-height: 1.35;
  font-weight: 650;
}

.muted {
  color: var(--muted);
}

.notice-card {
  position: relative;
  min-height: 240px;
  margin-bottom: 20px;
  padding: 30px 22px;
  overflow: hidden;
  border-radius: 6px;
  background: #858585;
  color: #ffffff;
}

.notice-card::after {
  content: "";
  position: absolute;
  right: 12%;
  top: 36px;
  width: 360px;
  height: 180px;
  border: 18px solid rgba(255, 255, 255, .08);
  border-left: 0;
  border-radius: 0 120px 120px 0;
  transform: rotate(-10deg);
}

.notice-card span {
  display: inline-flex;
  align-items: center;
  height: 32px;
  padding: 0 10px;
  margin-bottom: 78px;
  border-radius: 2px;
  background: #f06b00;
  color: #ffffff;
  font-weight: 650;
}

.notice-card h1 {
  position: relative;
  z-index: 1;
  margin-bottom: 20px;
  font-size: 22px;
  color: #ffffff;
}

.notice-card p {
  position: relative;
  z-index: 1;
  max-width: 760px;
  margin-bottom: 0;
  color: rgba(255, 255, 255, .92);
  font-size: 16px;
}

.n-card,
.panel,
.metric,
.notice {
  margin-bottom: 20px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--card);
}

.n-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68px;
  padding: 0 24px;
  border-bottom: 0;
}

.n-card-content {
  padding: 0 24px 24px;
}

.subscription-panel .n-card-content {
  padding-top: 0;
}

.sub-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 18px;
}

.sub-main h3 {
  margin-bottom: 18px;
}

.sub-main p {
  margin-bottom: 14px;
  color: #4b5563;
}

.usage-line {
  width: 100%;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #ececec;
}

.usage-line span {
  display: block;
  height: 100%;
  min-width: 4px;
  border-radius: inherit;
  background: #2cb85c;
}

.traffic-note {
  margin-top: 8px;
  margin-bottom: 0;
}

.sub-actions,
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.shortcut-list {
  padding: 0;
}

.shortcut-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 88px;
  align-items: center;
  gap: 18px;
  min-height: 68px;
  padding: 12px 20px;
  border-top: 1px solid var(--line);
  color: var(--text);
}

.shortcut-row:first-child {
  border-top: 0;
}

.shortcut-row:hover {
  background: #fbfbfc;
  color: var(--text);
}

.shortcut-row b {
  display: block;
  margin-bottom: 2px;
  font-size: 16px;
  font-weight: 600;
}

.shortcut-row p {
  margin: 0;
  color: var(--muted);
  line-height: 1.45;
}

.row-arrow {
  justify-self: end;
  color: #33363b;
  font-weight: 900;
}

.grid.plans {
  display: grid;
  grid-template-columns: repeat(3, minmax(260px, 1fr));
  gap: 20px;
}

.plan {
  display: grid;
  grid-template-rows: auto 1fr auto;
  min-height: 490px;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: #ffffff;
  cursor: pointer;
  transition: border-color .16s ease, box-shadow .16s ease;
}

.plan:hover {
  border-color: #c8ccd3;
  box-shadow: 0 10px 28px rgba(15, 23, 42, .08);
}

.plan-head {
  min-height: 75px;
  padding: 20px 24px 12px;
}

.plan-head h2 {
  margin-bottom: 8px;
}

.plan-head p {
  margin: 0;
}

.plan-head b {
  color: #d03050;
  font-size: 24px;
}

.plan-head span {
  margin-left: 4px;
  color: #60646c;
}

.plan-body {
  padding: 0 24px 18px;
}

.plan-body p {
  margin-bottom: 12px;
  font-weight: 600;
}

.plan-body ul {
  display: grid;
  gap: 10px;
  padding-left: 18px;
  margin: 0;
  color: #33363b;
}

.plan form {
  padding: 16px 24px;
  background: #fafafc;
  border-radius: 0 0 3px 3px;
}

.radio-tabs {
  display: inline-flex;
  align-items: center;
  gap: 0;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: 4px;
  background: #ffffff;
}

.radio-tabs span {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 0 14px;
  border-left: 1px solid var(--line);
  color: #4b5563;
}

.radio-tabs span:first-child {
  border-left: 0;
}

.radio-tabs .active {
  color: var(--accent);
  background: #f0faf5;
}

.panel {
  padding: 24px;
}

.panel.narrow {
  max-width: 520px;
  margin: 36px auto;
}

.form {
  display: grid;
  gap: 16px;
}

.grid-form {
  grid-template-columns: repeat(4, minmax(130px, 1fr));
  align-items: end;
}

label {
  display: grid;
  gap: 7px;
  color: #33363b;
  font-weight: 600;
}

input,
select,
textarea {
  width: 100%;
  min-height: 40px;
  padding: 8px 12px;
  border: 1px solid #dcdfe6;
  border-radius: 3px;
  background: #ffffff;
  color: var(--text);
  font: inherit;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--accent);
  outline: 2px solid rgba(24, 160, 88, .14);
}

textarea {
  min-height: 126px;
  resize: vertical;
}

input[readonly] {
  color: #4b5563;
  background: #f7f8fa;
}

.check {
  display: flex;
  gap: 10px;
  align-items: center;
  min-height: 40px;
}

.check input {
  width: auto;
  min-height: auto;
}

button,
.button,
.copy-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  padding: 0 15px;
  border: 1px solid var(--accent);
  border-radius: 3px;
  background: var(--accent);
  color: #ffffff;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

button:hover,
.button:hover,
.copy-action:hover {
  background: var(--accent-deep);
  border-color: var(--accent-deep);
  color: #ffffff;
}

button:disabled,
.copy-action:disabled {
  cursor: not-allowed;
  border-color: #d7dbe2;
  background: #eef0f3;
  color: #8b9099;
}

.button.secondary,
.copy-action.secondary {
  border-color: #d7dbe2;
  background: #ffffff;
  color: #33363b;
}

.button.secondary:hover,
.copy-action.secondary:hover {
  border-color: var(--accent);
  color: var(--accent);
  background: #ffffff;
}

.table-wrap {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #ffffff;
}

th,
td {
  padding: 13px 14px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: middle;
}

th {
  color: #60646c;
  font-size: 13px;
  font-weight: 600;
  background: #fafafa;
}

tr:last-child td {
  border-bottom: 0;
}

td form {
  margin: 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 24px;
  padding: 2px 9px;
  border-radius: 3px;
  background: #f0f1f3;
  color: #4b5563;
  font-size: 12px;
  font-weight: 600;
}

.badge.ok {
  background: #e8f7ef;
  color: var(--accent-deep);
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(120px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}

.metric {
  padding: 20px;
}

.metric b {
  display: block;
  margin-bottom: 2px;
  color: var(--accent);
  font-size: 30px;
  line-height: 1;
}

.metric span {
  color: var(--muted);
  font-weight: 600;
}

.payment-layout {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

.panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.panel-title h2 {
  margin: 0;
}

.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.settings-grid label:has(textarea) {
  grid-column: 1 / -1;
}

.pay-options {
  display: grid;
  gap: 12px;
}

.pay-option {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 4px;
  background: #fff;
}

.pay-option input {
  width: auto;
  min-height: auto;
}

.pay-option span {
  display: grid;
  gap: 3px;
}

.pay-option small {
  color: var(--muted);
  font-weight: 500;
}

.flow {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 14px;
}

.flow div {
  display: grid;
  gap: 8px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 4px;
  background: #fff;
}

.flow b {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: #f0faf5;
  color: var(--accent);
}

.payment-placeholder {
  display: grid;
  place-items: center;
  min-height: 180px;
  margin: 18px 0;
  border: 1px dashed #9ed8b8;
  border-radius: 4px;
  background: #f4fbf7;
  color: var(--accent);
  font-weight: 800;
  text-align: center;
}

.payment-placeholder span {
  display: block;
  margin-top: 8px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
}

.stack {
  display: grid;
  gap: 14px;
}

.kv {
  display: grid;
  grid-template-columns: 96px 1fr;
  gap: 10px 16px;
}

.kv dt {
  color: var(--muted);
  font-weight: 600;
}

.kv dd {
  margin: 0;
}

.notice {
  padding: 14px 16px;
}

.notice.danger {
  border-color: #f5c2cc;
  background: #fff1f3;
  color: var(--danger);
}

.empty-state {
  display: grid;
  gap: 10px;
  padding: 12px 0;
}

.empty-state p {
  margin-bottom: 8px;
  color: var(--muted);
}

@media (max-width: 980px) {
  .app-layout {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: static;
    height: auto;
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }

  .side-brand {
    height: 58px;
  }

  .side-menu {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    padding: 6px;
  }

  .side-group {
    display: none;
  }

  .side-item {
    grid-template-columns: auto 1fr;
    min-width: max-content;
  }

  .side-item.active::before {
    display: none;
  }

  .grid.plans {
    grid-template-columns: repeat(2, minmax(240px, 1fr));
  }

  .metrics,
  .payment-layout,
  .flow {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .topbar {
    align-items: flex-start;
    flex-direction: column;
    height: auto;
    padding: 12px;
  }

  .account-pill {
    width: 100%;
    justify-content: space-between;
  }

  .shell {
    padding: 12px;
  }

  .notice-card {
    min-height: 210px;
    padding: 20px;
  }

  .notice-card span {
    margin-bottom: 52px;
  }

  .page-title,
  .sub-card {
    align-items: stretch;
    grid-template-columns: 1fr;
    flex-direction: column;
  }

  .page-title {
    display: grid;
  }

  .grid.plans,
  .grid-form,
  .metrics,
  .payment-layout,
  .settings-grid,
  .flow {
    grid-template-columns: 1fr;
  }

  .shortcut-row {
    grid-template-columns: 1fr auto;
    padding: 12px 14px;
  }

  .n-card-header,
  .n-card-content {
    padding-left: 16px;
    padding-right: 16px;
  }

  .panel.narrow {
    margin: 20px auto;
  }

  table {
    min-width: 680px;
  }

  .kv {
    grid-template-columns: 1fr;
    gap: 4px;
  }
}

/* compact-20260625-final */
.app-layout { grid-template-columns: 208px minmax(0, 1fr); }
.side-brand { height: 54px; padding: 0 16px; font-size: 16px; }
.brand-mark { width: 28px; height: 28px; border-radius: 5px; font-size: 16px; }
.side-menu { gap: 3px; padding: 4px 4px 18px; }
.side-group { margin: 14px 12px 5px; font-size: 12px; }
.side-item { grid-template-columns: 22px 1fr; gap: 9px; min-height: 36px; padding: 0 12px; font-size: 13px; }
.side-item.active::before { left: -4px; height: 36px; }
.side-icon { width: 20px; height: 20px; transform: scale(.86); }
.topbar { height: 52px; padding: 0 14px; }
.breadcrumb, .account-pill { gap: 7px; }
.avatar-dot { width: 24px; height: 24px; }
.top-link { height: 28px; padding: 0 9px; font-size: 13px; }
.shell { min-height: calc(100vh - 52px); padding: 12px; }
.page-title { margin: 2px 0 12px; }
h1 { font-size: 20px; }
h2 { font-size: 16px; }
h3 { margin-bottom: 8px; font-size: 17px; }
.notice-card { min-height: 132px; margin-bottom: 12px; padding: 18px 20px; }
.notice-card::after { right: 8%; top: 18px; width: 250px; height: 118px; border-width: 12px; }
.notice-card span { height: 26px; margin-bottom: 28px; padding: 0 8px; font-size: 13px; }
.notice-card h1 { margin-bottom: 8px; font-size: 18px; }
.notice-card p { font-size: 14px; }
.n-card, .panel, .metric, .notice { margin-bottom: 12px; border-radius: 5px; }
.n-card-header { min-height: 48px; padding: 0 16px; }
.n-card-content { padding: 0 16px 16px; }
.sub-card { gap: 12px; }
.sub-main h3 { margin-bottom: 10px; }
.sub-main p { margin-bottom: 8px; }
.usage-line { height: 6px; }
.shortcut-row { grid-template-columns: minmax(0, 1fr) 76px; gap: 12px; min-height: 52px; padding: 8px 16px; }
.shortcut-row b { font-size: 14px; }
.shortcut-row p { font-size: 13px; }
.grid.plans { grid-template-columns: repeat(auto-fill, minmax(238px, 1fr)); gap: 12px; }
.plan { min-height: 0; }
.plan-head { min-height: 58px; padding: 14px 16px 8px; }
.plan-head h2 { margin-bottom: 4px; }
.plan-head b { font-size: 21px; }
.plan-body { padding: 0 16px 12px; }
.plan-body p { margin-bottom: 8px; }
.plan-body ul { gap: 6px; }
.plan form { padding: 12px 16px; }
.radio-tabs span { min-height: 30px; padding: 0 11px; font-size: 13px; }
.panel { padding: 18px; }
.panel.narrow { max-width: 460px; margin: 24px auto; }
.form { gap: 12px; }
label { gap: 5px; font-size: 13px; }
input, select, textarea { min-height: 36px; padding: 7px 10px; }
button, .button, .copy-action { min-height: 30px; padding: 0 12px; font-size: 13px; }
th, td { padding: 10px 12px; }
th { font-size: 12px; }
.badge { min-height: 22px; padding: 1px 7px; font-size: 12px; }
.payment-placeholder { min-height: 138px; margin: 12px 0; }
.stack { gap: 10px; }
.kv { gap: 7px 12px; }
.notice { padding: 10px 12px; }
.empty-state { gap: 8px; padding: 8px 0; }

@media (max-width: 980px) {
  .app-layout { grid-template-columns: 1fr; }
  .side-brand { height: 50px; }
  .docs-grid { grid-template-columns: 1fr; }
}

@media (max-width: 720px) {
  .topbar { height: auto; padding: 10px 12px; }
  .notice-card { min-height: 128px; padding: 16px; }
  .notice-card span { margin-bottom: 18px; }
  .shortcut-row { grid-template-columns: 1fr auto; padding: 8px 12px; }
  .n-card-header, .n-card-content { padding-left: 14px; padding-right: 14px; }
}

/* refined-plan-card-20260625 */
.grid.plans {
  grid-template-columns: repeat(auto-fill, minmax(246px, 1fr));
  gap: 14px;
  align-items: stretch;
}

.plan {
  position: relative;
  display: grid;
  grid-template-rows: auto 1fr auto;
  min-height: 312px;
  overflow: hidden;
  border: 1px solid #dfe3ea;
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(252, 253, 255, .98)),
    #ffffff;
  box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
  transition: transform .16s ease, border-color .16s ease, box-shadow .16s ease;
}

.plan:hover {
  transform: translateY(-3px);
  border-color: rgba(24, 160, 88, .42);
  box-shadow: 0 14px 34px rgba(15, 23, 42, .10);
}

.plan-ribbon {
  height: 4px;
  background: linear-gradient(90deg, #18a058, #50c878);
}

.plan.featured .plan-ribbon {
  background: linear-gradient(90deg, #d03050, #f0a020);
}

.plan-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
  min-height: auto;
  padding: 15px 16px 10px;
  border-bottom: 1px solid #f0f2f5;
}

.plan-badge {
  display: inline-flex;
  align-items: center;
  height: 20px;
  padding: 0 7px;
  margin-bottom: 8px;
  border-radius: 999px;
  background: #eef8f2;
  color: #087f42;
  font-size: 12px;
  font-weight: 700;
}

.plan.featured .plan-badge {
  background: #fff2e8;
  color: #b45309;
}

.plan-head h2 {
  margin: 0;
  color: #171a1f;
  font-size: 16px;
  line-height: 1.25;
  font-weight: 750;
}

.plan-price {
  display: flex;
  align-items: baseline;
  gap: 5px;
  margin: 0;
}

.plan-price b {
  color: #d03050;
  font-size: 24px;
  line-height: 1;
  font-weight: 850;
}

.plan-price span {
  color: #6b7280;
  font-size: 13px;
}

.plan-body {
  display: grid;
  gap: 12px;
  padding: 12px 16px 14px;
}

.plan-feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.plan-feature-grid div {
  min-width: 0;
  padding: 9px 8px;
  border: 1px solid #edf0f4;
  border-radius: 6px;
  background: #fafbfc;
}

.plan-feature-grid b,
.plan-feature-grid span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-feature-grid b {
  color: #20242a;
  font-size: 13px;
  font-weight: 750;
}

.plan-feature-grid span {
  margin-top: 2px;
  color: #7b818c;
  font-size: 12px;
}

.plan-benefits {
  display: grid;
  gap: 7px;
  padding: 0;
  margin: 0;
  list-style: none;
  color: #333842;
  font-size: 13px;
}

.plan-benefits li {
  position: relative;
  padding-left: 18px;
}

.plan-benefits li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .55em;
  width: 9px;
  height: 5px;
  border-left: 2px solid #18a058;
  border-bottom: 2px solid #18a058;
  transform: rotate(-45deg);
}

.plan-cta {
  padding: 12px 16px 14px;
  background: #fbfcfd;
  border-top: 1px solid #f0f2f5;
}

.plan-cta button {
  width: 100%;
  min-height: 34px;
  border-radius: 6px;
  box-shadow: 0 6px 14px rgba(24, 160, 88, .16);
}

.plan.featured .plan-cta button {
  background: #16a05a;
  border-color: #16a05a;
}

@media (max-width: 720px) {
  .grid.plans {
    grid-template-columns: 1fr;
  }

  .plan {
    min-height: 0;
  }
}

/* fengqun-menu-pages-20260625 */
.compact-page-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin: 0 0 12px;
}

.compact-page-title h1 {
  margin: 0 0 6px;
  color: #171a1f;
  font-size: 19px;
  line-height: 1.25;
  font-weight: 760;
}

.compact-page-title p {
  max-width: 720px;
  margin: 0;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.profile-action-card {
  display: grid;
  gap: 12px;
  align-content: start;
}

.profile-action-card .button {
  width: fit-content;
}

.empty-card {
  display: grid;
  gap: 8px;
  min-height: 128px;
  align-content: center;
  padding: 20px;
  border: 1px dashed #d8dde6;
  border-radius: 7px;
  background: #fbfcfd;
}

.empty-card b {
  color: #171a1f;
  font-size: 15px;
}

.empty-card p {
  max-width: 720px;
  margin: 0;
  color: #6b7280;
  line-height: 1.8;
}

.compact-table {
  min-width: 720px;
}

.compact-table th,
.compact-table td {
  height: 44px;
  vertical-align: middle;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 0 8px;
  border: 1px solid #d8dde6;
  border-radius: 999px;
  background: #f8fafc;
  color: #4b5563;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.status-pill.ok {
  border-color: #b7e4c7;
  background: #effaf3;
  color: #087f42;
}

.status-pill.neutral {
  border-color: #d8dde6;
  background: #f8fafc;
  color: #374151;
}

.table-note {
  margin: 10px 0 0;
  font-size: 13px;
}

@media (max-width: 720px) {
  .compact-page-title h1 {
    font-size: 18px;
  }

  .profile-grid {
    grid-template-columns: 1fr;
  }

  .empty-card {
    min-height: 112px;
    padding: 16px;
  }
}
