def reset_password_page(token, email=""):
    account = f"<p class='muted'>正在重置：{html.escape(email)}</p>" if email else ""
    return f"""
    <section class="panel narrow">
      <h1>重置密码</h1>
      {account}
      <form method="post" action="/reset-password" class="form">
        <input type="hidden" name="token" value="{html.escape(token)}">
        <label>新密码<input name="password" type="password" minlength="8" required></label>
        <label>确认新密码<input name="password_confirm" type="password" minlength="8" required></label>
        <button type="submit">保存新密码</button>
      </form>
    </section>
    """


def mask_saved(value):
    return "已保存，留空则不修改" if value else "未填写"


def input_text(name, label, value="", input_type="text", placeholder=""):
    return f"""<label>{label}<input name="{name}" type="{input_type}" value="{html.escape(str(value or ''))}" placeholder="{html.escape(placeholder)}"></label>"""


def textarea_field(name, label, value="", secret=False):
    if secret:
        return f"""<label>{label}<textarea name="{name}" rows="5" placeholder="{html.escape(mask_saved(value))}"></textarea></label>"""
    return f"""<label>{label}<textarea name="{name}" rows="5">{html.escape(str(value or ''))}</textarea></label>"""


def payment_config_panel(provider, row):
    config = decode_json(row["config_json"])
    enabled = "checked" if row["enabled"] else ""
    ready = payment_setting_ready(row)
    badge_text = "已启用" if ready else ("资料不完整" if row["enabled"] else "未启用")
    badge_class = "badge ok" if ready else "badge"
    if provider == "wechat":
        title = "微信支付"
        callback_url = PUBLIC_SUB_BASE.rstrip("/") + "/payment/wechat/notify"
        fields = f"""
          {input_text('appid', '公众号/小程序/AppID', config.get('appid', ''))}
          {input_text('mch_id', '商户号 mch_id', config.get('mch_id', ''))}
          {input_text('merchant_serial_no', '商户证书序列号', config.get('merchant_serial_no', ''))}
          {input_text('notify_url', '支付回调地址', config.get('notify_url') or callback_url)}
          {input_text('api_v3_key', 'API v3 密钥', '', 'password', mask_saved(config.get('api_v3_key')))}
          {textarea_field('private_key_pem', '商户 API 私钥 PEM', config.get('private_key_pem'), secret=True)}
          {textarea_field('platform_cert_pem', '微信支付平台证书 PEM', config.get('platform_cert_pem'), secret=True)}
        """
    else:
        title = "支付宝"
        notify_url = PUBLIC_PAYMENT_BASE + "/payment/alipay/notify"
        return_url = PUBLIC_PAYMENT_BASE + "/payment/alipay/return"
        fields = f"""
          {input_text('app_id', '应用 AppID', config.get('app_id', ''))}
          {input_text('gateway_url', '网关地址', config.get('gateway_url') or 'https://openapi.alipay.com/gateway.do')}
          {input_text('notify_url', '异步通知地址', config.get('notify_url') or notify_url)}
          {input_text('return_url', '同步返回地址', config.get('return_url') or return_url)}
          {input_text('sign_type', '签名类型', config.get('sign_type') or 'RSA2')}
          {textarea_field('merchant_private_key', '应用私钥', config.get('merchant_private_key'), secret=True)}
          {textarea_field('alipay_public_key', '支付宝公钥', config.get('alipay_public_key'), secret=True)}
        """
    return f"""
    <section class="panel payment-panel">
      <div class="panel-title">
        <h2>{title}</h2>
        <span class="{badge_class}">{badge_text}</span>
      </div>
      <form method="post" action="/admin/payments" class="form">
        <input type="hidden" name="provider" value="{provider}">
        <label class="check"><input name="enabled" type="checkbox" {enabled}> 启用{title}</label>
        <div class="settings-grid">{fields}</div>
        <button type="submit">保存{title}配置</button>
      </form>
    </section>
    """


def payment_method_choices(enabled_methods, compact=False):
    options = []
    labels = {"wechat": "微信支付", "alipay": "支付宝"}
    icons = {"wechat": "微", "alipay": "支"}
    for provider in enabled_methods:
        hint = "付款后等待确认" if compact else "创建支付订单，付款后等待后台确认开通"
        options.append(
            f"""
            <label class="pay-option" data-pay-provider="{provider}">
              <input type="radio" name="payment_method" value="{provider}" required>
              <span class="pay-icon pay-icon-{provider}" aria-hidden="true">{icons[provider]}</span>
              <span class="pay-copy"><b>{labels[provider]}</b><small>{hint}</small></span>
            </label>
            """
        )
    manual_hint = "人工收款后开通" if compact else "用于人工收款，提交后等待管理员确认开通"
    options.append(
        f"""
        <label class="pay-option" data-pay-provider="manual">
          <input type="radio" name="payment_method" value="manual" required>
          <span class="pay-icon pay-icon-manual" aria-hidden="true">手</span>
          <span class="pay-copy"><b>手动</b><small>{manual_hint}</small></span>
        </label>
        """
    )
    return "<div class='pay-options'>" + "".join(options) + "</div>"


def checkout_period_variants(con, order):
    family = normalize_product_family(
        row_value(order, "product_family", ""),
        row_value(order, "product_type", "subscription"),
        row_value(order, "traffic_gb", 0),
    )
    if family not in ("unlimited", "limited"):
        return {}
    rows = con.execute(
        """
        select *
        from products
        where active=1
          and product_type='subscription'
          and product_family=?
          and billing_period in ('monthly','quarterly','yearly')
        order by sort_order,id
        """,
        (family,),
    ).fetchall()
    variants = {}
    for row in rows:
        period = row["billing_period"]
        if period not in variants:
            variants[period] = row
    current_period = row_value(order, "billing_period", "")
    if current_period in ("monthly", "quarterly", "yearly") and current_period not in variants:
        variants[current_period] = order
    return variants


def checkout_period_tabs(order, variants):
    if not variants:
        return ""
    items = []
    current_product_id = int(order["product_id"])
    for period in ("monthly", "quarterly", "yearly"):
        product = variants.get(period)
        label = billing_period_label(period)
        if product:
            active = " active" if int(product["id"]) == current_product_id else ""
            disabled = " disabled" if active else ""
            items.append(
                f"""
                <form method="post" action="/orders/{order['id']}/switch-product">
                  <input type="hidden" name="product_id" value="{product['id']}">
                  <button type="submit" class="checkout-period-option{active}"{disabled}>
                    <span>{label}</span><b>{money(product['price_cents'])}</b>
                  </button>
                </form>
                """
            )
        else:
            items.append(f"<button type='button' class='checkout-period-option' disabled><span>{label}</span><b>未上架</b></button>")
    return "<div class='checkout-period-tabs'>" + "".join(items) + "</div>"


def payment_pending_page(order, provider, tx):
    label = "微信支付" if provider == "wechat" else ("支付宝" if provider == "alipay" else "人工确认")
    provider_no = tx["provider_order_no"] if tx else order["payment_ref"] or "-"
    placeholder = "请按工作人员提供的方式完成付款" if provider == "manual" else "付款完成后等待订单状态更新"
    customer_hint = "您的订单将由后台工作人员受理，受理完成后即开通网络套餐。"
    return f"""
    <section class="panel narrow payment-status-card">
      <h1>{label}</h1>
      <dl class="kv payment-compact-details">
        <dt>订单号</dt><dd>{html.escape(order['order_no'])}</dd>
        <dt>支付单号</dt><dd>{html.escape(provider_no)}</dd>
        <dt>套餐</dt><dd>{html.escape(order['product_name'])}</dd>
        <dt>金额</dt><dd>{money(order['amount_cents'])}</dd>
        <dt>状态</dt><dd>等待收款确认</dd>
      </dl>
      <div class="payment-status-box"><b>{label}</b><span>{placeholder}</span></div>
      <p class="payment-user-copy">{customer_hint}</p>
      <div class="actions payment-actions"><a class="button payment-primary-action" href="/dashboard">查看套餐</a></div>
    </section>
    """


def product_form(action, p=None):
    p = dict(p) if p is not None else {}
    checked = "checked" if p.get("active", 1) else ""
    display_checked = "checked" if p.get("display_in_plans", 1) else ""
    price_yuan = (p.get("price_cents", 0) or 0) / 100
    device_limit = parse_positive_int(p.get("device_limit", 1))
    product_type = normalize_product_type(p.get("product_type", "subscription"))
    product_family = normalize_product_family(p.get("product_family", ""), product_type, p.get("traffic_gb", 0))
    duration_hidden = "" if product_type == "traffic_pack" else " hidden"
    return f"""
    <form method="post" action="{action}" class="form grid-form">
      <label>名称<input name="name" value="{html.escape(str(p.get('name','')))}" required></label>
      <label>产品类别
        <select name="product_family">
          {option('unlimited','不限量',product_family)}
          {option('limited','限量',product_family)}
          {option('traffic_pack','流量包',product_family)}
        </select>
      </label>
      <label>商品形态
        <select name="product_type">
          {option('subscription','周期套餐',product_type)}
          {option('traffic_pack','流量包',product_type)}
        </select>
      </label>
      <label>周期
        <select name="billing_period">
          {option('monthly','月付',p.get('billing_period'))}
          {option('quarterly','季付',p.get('billing_period'))}
          {option('yearly','年付',p.get('billing_period'))}
          {option('traffic_pack','流量包',p.get('billing_period'))}
        </select>
      </label>
      <label data-duration-field{duration_hidden}>流量包有效期<input name="duration_days" type="number" min="0" value="{p.get('duration_days',30)}" required><small>填 0 表示不限期。周期套餐按月付/季付/年付自动计算截止时间。</small></label>
      <label>流量 GB<input name="traffic_gb" type="number" min="0" value="{p.get('traffic_gb',100)}" required></label>
      <label>设备数<input name="device_limit" type="number" min="1" value="{device_limit}" required></label>
      <label>价格 元<input name="price_yuan" type="number" min="0" step="0.01" value="{price_yuan:.2f}" required></label>
      <label>排序<input name="sort_order" type="number" value="{p.get('sort_order',100)}"></label>
      <label class="check"><input name="active" type="checkbox" {checked}> 上架</label>
      <label class="check"><input name="display_in_plans" type="checkbox" {display_checked}> 展示在套餐列表</label>
      <button type="submit">保存</button>
    </form>
    """


def option(value, label, selected):
    return f"<option value='{value}' {'selected' if selected == value else ''}>{label}</option>"


def product_row(p):
    status = "上架" if p["active"] else "下架"
    display = "展示" if int(row_value(p, "display_in_plans", 1) or 0) else "隐藏"
    action = "disable" if p["active"] else "enable"
    action_label = "下架" if p["active"] else "上架"
    return (
        "<tr>"
        f"<td>{html.escape(p['name'])}</td>"
        f"<td>{int(row_value(p, 'sort_order', 100) or 100)}</td>"
        f"<td>{product_family_label(row_value(p, 'product_family', 'limited'))}</td>"
        f"<td>{product_type_label(row_value(p, 'product_type', 'subscription'))}</td>"
        f"<td>{product_period_display(p)}</td>"
        f"<td>{product_traffic_label(p)}</td>"
        f"<td>{device_limit_label(row_value(p, 'device_limit', 1))}</td>"
        f"<td>{money(p['price_cents'])}</td>"
        f"<td>{display}</td>"
        f"<td><span class='badge'>{status}</span></td>"
        f"<td><a href='/admin/products/{p['id']}/edit'>编辑</a>"
        f"<form method='post' action='/admin/products/{p['id']}/{action}' class='inline-form'><button type='submit'>{action_label}</button></form>"
        f"<form method='post' action='/admin/products/{p['id']}/delete' class='inline-form'><button type='submit' onclick=\"return confirm('确定删除该套餐？')\">删除</button></form></td>"
        "</tr>"
    )


def payment_provider_label(provider):
    return {"wechat": "微信支付", "alipay": "支付宝", "manual": "人工确认", "wallet": "余额支付"}.get(provider or "", provider or "-")


def admin_payment_transaction_rows(con):
    rows = con.execute(
        """
        select t.*, o.order_no, u.email user_email
        from payment_transactions t
        join orders o on o.id=t.order_id
        join users u on u.id=o.user_id
        order by t.id desc
        limit 80
        """
    ).fetchall()
    if not rows:
        return "<tr><td colspan='7'>暂无支付交易</td></tr>"
    return "".join(
        "<tr>"
        f"<td>{html.escape(r['provider_order_no'])}</td>"
        f"<td>{html.escape(r['order_no'])}</td>"
        f"<td>{html.escape(r['user_email'])}</td>"
        f"<td>{payment_provider_label(r['provider'])}</td>"
        f"<td>{money(r['amount_cents'])}</td>"
        f"<td><span class='badge'>{html.escape(r['status'])}</span></td>"
        f"<td>{ms_to_date(r['created_at'])}</td>"
        "</tr>"
        for r in rows
    )


def admin_node_rows(con):
    rows = con.execute(
        """
        select * from nodes
        order by sort_order,id
        """
    ).fetchall()
    if not rows:
        return "<tr><td colspan='8'>暂无节点</td></tr>"
    rendered = []
    for node in rows:
        endpoint = f"{html.escape(node['connect_host'])}:{int(node['port'])}"
        protocol = f"{html.escape(node['protocol'])} / {html.escape(node['security'])}"
        capacity = "未限制" if int(row_value(node, "capacity_gb", 0) or 0) <= 0 else f"{int(node['capacity_gb'])} GB"
        rendered.append(
            "<tr>"
            f"<td>{html.escape(node['name'])}</td>"
            f"<td>{html.escape(node['region'])}</td>"
            f"<td>{html.escape(node['role'])}</td>"
            f"<td>{protocol}</td>"
            f"<td>{endpoint}</td>"
            f"<td>{int(node['inbound_id'])}</td>"
            f"<td>{capacity}</td>"
            f"<td><span class='badge'>{html.escape(node['status'])}</span></td>"
            "</tr>"
        )
    return "".join(rendered)


def admin_fair_use_policy_rows(con):
    rows = con.execute(
        """
        select * from fair_use_policies
        order by product_family
        """
    ).fetchall()
    if not rows:
        return "<tr><td colspan='5'>暂无公平使用策略</td></tr>"
    rendered = []
    for p in rows:
        rendered.append(
            "<tr>"
            f"<td>{product_family_label(p['product_family'])}</td>"
            f"<td>{int(p['watch_gb'])} GB</td>"
            f"<td>{int(p['review_gb'])} GB</td>"
            f"<td>{int(p['restrict_gb'])} GB</td>"
            f"<td>{html.escape(p['action_note'])}</td>"
            "</tr>"
        )
    return "".join(rendered)


def _admin_subscription_query(con):
    return con.execute(
        """
        select s.*, u.email user_email, coalesce(o.order_product_name,p.name) product_name,
               p.product_family product_family, o.order_no, o.status order_status
        from subscriptions s
        join users u on u.id=s.user_id
        join products p on p.id=s.product_id
        join orders o on o.id=s.order_id
        order by s.id desc
        limit 300
        """
    ).fetchall()


def _subscription_matches_search(s, q):
    if not q:
        return True
    needle = q.lower()
    fields = [
        row_value(s, "user_email", ""),
        row_value(s, "product_name", ""),
        row_value(s, "sub_id", ""),
        row_value(s, "email_label", ""),
        row_value(s, "uuid", ""),
        row_value(s, "order_no", ""),
    ]
    return any(needle in str(value).lower() for value in fields)


def _subscription_matches_risk(con, s, risk):
    selected = risk or "all"
    if selected == "all":
        return True
    status = subscription_fair_use_status(con, s)
    if selected == "high":
        return status["level"] in ("watch", "review", "restrict")
    return status["level"] == selected


def fair_use_subscription_count(con, risk="high"):
    return sum(1 for s in _admin_subscription_query(con) if _subscription_matches_risk(con, s, risk))


def fair_use_total_usage_gb(con):
    total_bytes = 0
    for s in _admin_subscription_query(con):
        up, down = subscription_usage_bytes(s)
        total_bytes += up + down
    return int(round(total_bytes / 1024**3))


def admin_subscription_rows(con, q="", risk="all", limit=120):
    rows = con.execute(
        """
        select s.*, u.email user_email, coalesce(o.order_product_name,p.name) product_name,
               p.product_family product_family, o.order_no, o.status order_status
        from subscriptions s
        join users u on u.id=s.user_id
        join products p on p.id=s.product_id
        join orders o on o.id=s.order_id
        order by s.id desc
        limit 300
        """
    ).fetchall()
    rows = [
        s for s in rows
        if _subscription_matches_search(s, q) and _subscription_matches_risk(con, s, risk)
    ][:limit]
    if not rows:
        return "<tr><td colspan='11'>暂无订阅</td></tr>"
    rendered = []
    for s in rows:
        up, down = subscription_usage_bytes(s)
        used = up + down
        traffic = f"{gb_label(used / 1024**3)} / {subscription_traffic_label(s)}"
        devices = subscription_admin_device_html(s)
        fair_use = subscription_fair_use_status(con, s)
        fair_use_html = (
            f"<span class='badge'>{fair_use_level_label(fair_use['level'])}</span>"
            f"<small>{html.escape(fair_use['label'])}</small>"
        )
        status = f"{html.escape(s['xui_status'])} · {html.escape(s['order_status'])}"
        if int(row_value(s, "revoked_at", 0) or 0) > 0 or int(s["expires_at"] or 0) <= 0:
            action = "<span class='muted'>不可补偿</span>"
        else:
            action = f"""
            <form method="post" action="/admin/subscriptions/{s['id']}/extend" class="inline-form subscription-extend-form">
              <input name="days" type="number" min="1" max="3650" placeholder="天数" required>
              <input name="note" type="text" maxlength="120" placeholder="备注">
              <button type="submit">补偿</button>
            </form>
            """
        rendered.append(
            "<tr>"
            f"<td class='admin-cell-strong'>{html.escape(s['user_email'])}</td>"
            f"<td>{html.escape(s['product_name'])}</td>"
            f"<td class='admin-cell-code'>{html.escape(s['sub_id'])}</td>"
            f"<td class='admin-cell-code'>{html.escape(s['email_label'])}</td>"
            f"<td class='admin-cell-metric'>{traffic}</td>"
            f"<td class='admin-cell-devices'>{devices}</td>"
            f"<td class='admin-cell-status'>{fair_use_html}</td>"
            f"<td class='admin-cell-date'>{expiry_label(s['expires_at'])}</td>"
            f"<td class='admin-cell-status'><span class='badge'>{status}</span></td>"
            f"<td class='admin-cell-code'>{html.escape(s['order_no'])}</td>"
            f"<td class='admin-cell-action'>{action}</td>"
            "</tr>"
        )
    return "".join(rendered)


def order_row(o, admin=False, customer=False):
    gross = row_value(o, "gross_amount_cents", o["amount_cents"]) or o["amount_cents"]
    discount = row_value(o, "balance_discount_cents", 0) or 0
    net = o["amount_cents"]
    amount_html = f"{money(net)}"
    if discount:
        amount_html += f"<br><span class='muted'>原价 {money(gross)} · 余额抵扣 {money(discount)}</span>"
    commission = row_value(o, "commission_amount_cents", 0) or 0
    commission_status = row_value(o, "commission_status", "none") or "none"
    if admin:
        actions = []
        if o["status"] == "pending_payment":
            actions.append(f"<form method='post' action='/admin/orders/{o['id']}/mark-paid'><button>确认收款并开通</button></form>")
            actions.append(f"<form method='post' action='/admin/orders/{o['id']}/cancel'><button class='button secondary'>取消</button></form>")
        if o["status"] == "provision_failed":
            actions.append(f"<form method='post' action='/admin/orders/{o['id']}/provision'><button>重试开通</button></form>")
        action = f"<div class='admin-order-actions'>{''.join(actions)}</div>" if actions else "-"
        payment_text = payment_provider_label(row_value(o, "payment_method", "manual"))
        if row_value(o, "payment_ref", ""):
            payment_text += f"<br><span class='muted'>{html.escape(o['payment_ref'])}</span>"
        commission_text = "-" if not commission else f"{money(commission)} · {html.escape(commission_status)}"
        return f"<tr><td>{html.escape(o['order_no'])}</td><td>{html.escape(o['user_email'])}</td><td>{html.escape(o['product_name'])}</td><td>{amount_html}</td><td>{payment_text}</td><td>{commission_text}</td><td><span class='badge'>{o['status']}</span></td><td>{action}</td></tr>"
    action = f"<a href='/checkout?id={o['id']}'>去支付</a>" if o["status"] == "pending_payment" else "-"
    return f"<tr><td>{html.escape(o['order_no'])}</td><td>{html.escape(o['product_name'])}</td><td>{amount_html}</td><td><span class='badge'>{o['status']}</span></td><td>{action}</td></tr>"


def xhttp_mode(s):
    if str(row_value(s, "sub_id", "")) in NODE_XHTTP_STREAM_UP_SUB_IDS:
        return "stream-up"
    return NODE_XHTTP_MODE


def xhttp_path(s):
    if str(row_value(s, "sub_id", "")) in NODE_XHTTP_STREAM_UP_SUB_IDS and NODE_XHTTP_STREAM_UP_PATH:
        return NODE_XHTTP_STREAM_UP_PATH
    return NODE_XHTTP_PATH


def use_ws_transport(s, for_clash=False):
    sub_id = str(row_value(s, "sub_id", ""))
    ws_ids = NODE_WS_SUB_IDS | (NODE_WS_CLASH_SUB_IDS if for_clash else set())
    return NODE_TRANSPORT == "xhttp" and NODE_WS_PATH and (NODE_WS_ALL or sub_id in ws_ids)


def build_node_url(s):
    if use_ws_transport(s):
        query = {
            "encryption": "none",
            "security": "tls",
            "sni": NODE_WS_HOST,
            "type": "ws",
            "host": NODE_WS_HOST,
            "path": NODE_WS_PATH,
            "fp": "chrome",
        }
        remark = f"{NODE_REMARK_PREFIX}-{s['sub_id']}"
        return (
            f"vless://{urllib.parse.quote(str(s['uuid']), safe='')}@{NODE_CONNECT_HOST}:{NODE_DIRECT_PORT}"
            f"?{urllib.parse.urlencode(query)}#{urllib.parse.quote(remark)}"
        )

    if NODE_TRANSPORT == "xhttp":
        query = {
            "encryption": "none",
            "security": "tls",
            "sni": NODE_XHTTP_HOST,
            "type": "xhttp",
            "host": NODE_XHTTP_HOST,
            "path": xhttp_path(s),
            "mode": xhttp_mode(s),
            "fp": "chrome",
        }
        remark = f"{NODE_REMARK_PREFIX}-{s['sub_id']}"
        return (
            f"vless://{urllib.parse.quote(str(s['uuid']), safe='')}@{NODE_CONNECT_HOST}:{NODE_DIRECT_PORT}"
            f"?{urllib.parse.urlencode(query)}#{urllib.parse.quote(remark)}"
        )

    query = {
        "type": "tcp",
        "security": "reality",
        "encryption": "none",
        "flow": "xtls-rprx-vision",
        "fp": "chrome",
        "pbk": NODE_REALITY_PUBLIC_KEY,
        "sni": NODE_REALITY_SNI,
        "sid": NODE_REALITY_SHORT_ID,
        "spx": "/",
    }
    remark = f"{NODE_REMARK_PREFIX}-{s['sub_id']}"
    return (
        f"vless://{urllib.parse.quote(str(s['uuid']), safe='')}@{NODE_CONNECT_HOST}:{NODE_DIRECT_PORT}"
        f"?{urllib.parse.urlencode(query)}#{urllib.parse.quote(remark)}"
    )


def build_clash_config(s):
    name = f"{NODE_REMARK_PREFIX}-{s['sub_id']}"
    if use_ws_transport(s, for_clash=True):
        return f"""port: 7890
socks-port: 7891
allow-lan: false
ipv6: false
mode: rule
log-level: info

{CLASH_DNS_CONFIG}

proxies:
  - name: {yaml_quote(name)}
    type: vless
    server: {yaml_quote(NODE_CONNECT_HOST)}
    port: {NODE_DIRECT_PORT}
    uuid: {yaml_quote(s['uuid'])}
    network: ws
    tls: true
    udp: true
    servername: {yaml_quote(NODE_WS_HOST)}
    client-fingerprint: chrome
    ws-opts:
      path: {yaml_quote(NODE_WS_PATH)}
      headers:
        Host: {yaml_quote(NODE_WS_HOST)}

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - {yaml_quote(name)}

rules:
  - MATCH,PROXY
"""

    if NODE_TRANSPORT == "xhttp":
        return f"""port: 7890
socks-port: 7891
allow-lan: false
ipv6: false
mode: rule
log-level: info

{CLASH_DNS_CONFIG}

proxies:
  - name: {yaml_quote(name)}
    type: vless
    server: {yaml_quote(NODE_CONNECT_HOST)}
    port: {NODE_DIRECT_PORT}
    uuid: {yaml_quote(s['uuid'])}
    network: xhttp
    tls: true
    udp: true
    servername: {yaml_quote(NODE_XHTTP_HOST)}
    client-fingerprint: chrome
    xhttp-opts:
      path: {yaml_quote(xhttp_path(s))}
      host: {yaml_quote(NODE_XHTTP_HOST)}
      mode: {yaml_quote(xhttp_mode(s))}

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - {yaml_quote(name)}

rules:
  - MATCH,PROXY
"""

    return f"""port: 7890
socks-port: 7891
allow-lan: false
ipv6: false
mode: rule
log-level: info

{CLASH_DNS_CONFIG}

proxies:
  - name: {yaml_quote(name)}
    type: vless
    server: {yaml_quote(NODE_CONNECT_HOST)}
    port: {NODE_DIRECT_PORT}
    uuid: {yaml_quote(s['uuid'])}
    network: tcp
    tls: true
    udp: true
    flow: xtls-rprx-vision
    servername: {yaml_quote(NODE_REALITY_SNI)}
    client-fingerprint: chrome
    reality-opts:
      public-key: {yaml_quote(NODE_REALITY_PUBLIC_KEY)}
      short-id: {yaml_quote(NODE_REALITY_SHORT_ID)}
      spider-x: "/"

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - {yaml_quote(name)}

rules:
  - MATCH,PROXY
"""


def build_invite_share_text(invite_url):
    return "\n".join([
        "Node1 订阅服务邀请",
        "通过这个链接注册后可选择套餐开通：",
        invite_url,
    ])


def build_plan_share_url(product):
    return PUBLIC_SUB_BASE.rstrip("/") + "/plans?" + urllib.parse.urlencode({"plan": product["id"]})


def build_plan_share_text(product, plan_url):
    devices = f"{device_limit_label(row_value(product, 'device_limit', 1))}设备"
    return "\n".join([
        f"Node1 {product['name']}",
        f"{money(product['price_cents'])} / {product_period_display(product)}",
        f"{product_traffic_label(product)} 可用流量 · {product_period_display(product)} · {devices}",
        plan_url,
    ])


def telegram_share_url(text, url):
    return "https://t.me/share/url?" + urllib.parse.urlencode({"url": url, "text": text})


def share_panel(panel_id, label, url, text, kind=""):
    safe_id = html.escape(panel_id, quote=True)
    safe_kind = html.escape(kind, quote=True)
    safe_label = html.escape(label)
    safe_url = html.escape(url, quote=True)
    telegram_url = html.escape(telegram_share_url(text, url), quote=True)
    sheet_title = "邀请有奖励" if kind == "invite" else label
    return f"""
    <details class="share-panel" data-share-panel="{safe_id}" data-share-kind="{safe_kind}" data-share-mode="sheet">
      <summary>{safe_label}</summary>
      <div class="share-sheet">
        <div class="share-sheet-head">
          <b class="share-sheet-title">{html.escape(sheet_title)}</b>
          <button class="share-sheet-close" type="button" data-share-close aria-label="关闭分享弹窗">关闭</button>
        </div>
        <div class="share-actions">
          {copy_button("复制文案", text, "secondary")}
          {copy_button("复制链接", url, "secondary")}
          <a class="share-link telegram" target="_blank" rel="noopener" href="{telegram_url}">分享到 Telegram</a>
        </div>
        <div class="wechat-fallback">
          <b>发到微信</b>
          <span>复制后粘贴到微信，或把链接发给好友。</span>
          <code>{safe_url}</code>
        </div>
      </div>
    </details>
    """


def copy_button(label, value, extra_class="", aria_label=""):
    aria = f" aria-label='{html.escape(aria_label, quote=True)}'" if aria_label else ""
    if not value:
        return f"<button class='copy-action {extra_class}' type='button'{aria} disabled>{label}</button>"
    return f"<button class='copy-action {extra_class}' type='button'{aria} data-copy-value='{html.escape(value, quote=True)}'>{label}</button>"


def diamond_rank():
    diamond_svg = (
        '<svg class="diamond-icon" viewBox="0 0 1024 1024" version="1.1" width="18" height="18" '
        'xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">'
        '<path d="M512.8 216l185.6 200H327.2l185.6-200z m273.6 200h172.8l-224-288h-56l107.2 288z '
        'm-273.6 413.6L732 448H292.8l220 381.6zM647.2 128H377.6L276 412.8 512.8 168l236.8 245.6L647.2 128z '
        'm121.6 320l-256 450.4-256-450.4H87.2L512 963.2 933.6 448H768.8z m-530.4-32l107.2-288h-56L68 416h170.4z" '
        'fill="#1296db"></path></svg>'
    )
    diamonds = diamond_svg * 5
    return f'<span class="diamond-rank" aria-label="五钻会员">{diamonds}</span>'


def profile_identity(user, paid_user=False):
    if user["role"] == "admin":
        return "管理员"
    if paid_user:
        return diamond_rank()
    return "普通用户"


def dashboard_account_card(user):
    role = "管理员" if user["role"] == "admin" else "用户"
    return f"""
