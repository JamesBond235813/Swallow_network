def now_ms():
    return int(time.time() * 1000)


def one_time_token(prefix="tok"):
    return prefix + "_" + secrets.token_urlsafe(12).replace("-", "").replace("_", "")


def hash_password(password, salt=None):
    salt = salt or secrets.token_hex(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 180_000).hex()
    return f"pbkdf2_sha256${salt}${digest}"


def verify_password(password, stored):
    try:
        method, salt, digest = stored.split("$", 2)
    except ValueError:
        return False
    if method != "pbkdf2_sha256":
        return False
    return hmac.compare_digest(hash_password(password, salt), stored)


def money(cents):
    return f"¥{cents / 100:.2f}"


def mask_email(email):
    raw = html.escape(email or "")
    if "@" not in raw:
        return raw[:2] + "***" if raw else "-"
    name, domain = raw.split("@", 1)
    if len(name) <= 2:
        masked = name[:1] + "***"
    else:
        masked = name[:2] + "***" + name[-1:]
    return masked + "@" + domain


def active_nav_key(path):
    if path in ("/", "/dashboard"):
        return "dashboard"
    if path == "/docs":
        return "docs"
    if path.startswith("/plans") or path.startswith("/checkout"):
        return "plans"
    if path in ("/invitations", "/nodes", "/tickets", "/traffic"):
        return "dashboard"
    if path in ("/profile", "/login", "/register", "/forgot-password", "/reset-password"):
        return "profile"
    if path == "/admin":
        return "admin"
    if path == "/admin/products" or (path.startswith("/admin/products/") and path.endswith("/edit")):
        return "admin-products"
    if path == "/admin/payments":
        return "admin-payments"
    if path == "/admin/orders":
        return "admin-orders"
    if path == "/admin/subscriptions":
        return "admin-subscriptions"
    if path == "/admin/nodes":
        return "admin-nodes"
    if path == "/admin/fair-use":
        return "admin-fair-use"
    if path == "/admin/affiliates":
        return "admin-affiliates"
    if path == "/admin/feedbacks":
        return "admin-feedbacks"
    return ""


def nav_active(path, key):
    return "active" if active_nav_key(path) == key else ""


