    @require_admin
    def post_admin_order_action(self, path):
        parts = path.strip("/").split("/")
        order_id = int(parts[2])
        action = parts[3]
        con = get_db()
        if action == "mark-paid":
            con.execute("update orders set status='paid',payment_ref=?,paid_at=?,updated_at=? where id=? and status='pending_payment'", ("manual-" + secrets.token_hex(5), now_ms(), now_ms(), order_id))
            con.commit()
        elif action == "cancel":
            con.execute("update orders set status='cancelled',updated_at=? where id=? and status in ('created','pending_payment')", (now_ms(), order_id))
            con.commit()
        con.close()
        if action in ("mark-paid", "provision"):
            threading.Timer(2.0, provision_order, args=(order_id,)).start()
        return self.redirect("/admin/orders")


def provision_order(order_id):
    con = get_db()
    order = con.execute(
        f"""
        select o.*, u.email user_email, {ORDER_PRODUCT_SELECT}
        from orders o join users u on u.id=o.user_id join products p on p.id=o.product_id
        where o.id=?
        """,
        (order_id,),
    ).fetchone()
    if not order or order["status"] not in ("paid", "provision_failed"):
        con.close()
        return
    existing = con.execute("select id from subscriptions where order_id=?", (order_id,)).fetchone()
    if existing:
        con.execute("update orders set status='provisioned',provisioned_at=coalesce(provisioned_at,?),updated_at=? where id=?", (now_ms(), now_ms(), order_id))
        credit_order_commission(order_id, con)
        con.commit()
        con.close()
        return
    client_uuid = str(uuid.uuid4())
    sub_id = "u" + secrets.token_urlsafe(8).replace("-", "").replace("_", "")
    label = "user-" + str(order["user_id"]) + "-" + sub_id
    traffic_bytes = int(order["traffic_gb"]) * 1024**3
    traffic_reset_days = product_traffic_reset_days(order)
    device_limit = parse_positive_int(row_value(order, "device_limit", 1))
    expires_at = subscription_expires_at_for_order(order)
    result = provision_xui(label, sub_id, client_uuid, traffic_bytes, expires_at, device_limit, traffic_reset_days)
    clash_url = f"{PUBLIC_SUB_BASE}/clashx/{sub_id}"
    universal_url = f"{PUBLIC_SUB_BASE}/sub/{sub_id}"
    if result["ok"]:
        cursor = con.execute(
            """
            insert into subscriptions(user_id,order_id,product_id,email_label,sub_id,uuid,traffic_bytes,traffic_reset_days,expires_at,clash_url,universal_url,xui_status,xui_message,device_limit,created_at)
            values(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (order["user_id"], order_id, order["product_id"], label, sub_id, client_uuid, traffic_bytes, traffic_reset_days, expires_at, clash_url, universal_url, result["mode"], result["message"], device_limit, now_ms()),
        )
        new_subscription_id = cursor.lastrowid
        prior_subscriptions = con.execute(
            """
            select s.id, s.email_label
            from subscriptions s join orders o on o.id=s.order_id
            where s.user_id=?
              and s.id!=?
              and coalesce(s.revoked_at,0)=0
              and o.status='provisioned'
              and (s.expires_at=0 or s.expires_at>?)
            """,
            (order["user_id"], new_subscription_id, now_ms()),
        ).fetchall()
        prior_emails = [row["email_label"] for row in prior_subscriptions]
        revoke_result = revoke_xui_clients(prior_emails)
        revoked_message = "Replaced by order %s." % order_id
        if prior_subscriptions:
            con.executemany(
                """
                update subscriptions
                set revoked_at=?, revoked_by_order_id=?, revoked_reason='replaced',
                    xui_status='replaced', xui_message=?
                where id=?
                """,
                [(now_ms(), order_id, revoked_message + " " + revoke_result["message"], row["id"]) for row in prior_subscriptions],
            )
        con.execute("update orders set status='provisioned',provisioned_at=?,updated_at=? where id=?", (now_ms(), now_ms(), order_id))
        credit_order_commission(order_id, con)
    else:
        con.execute("update orders set status='provision_failed',updated_at=? where id=?", (now_ms(), order_id))
    con.commit()
    con.close()


def form_page(title, action, include_name=False, button="提交", invite_code=""):
    helper = "请使用已创建的账户登录。管理员初始账号由服务器环境变量配置。"
    return f"""
    <section class="panel narrow">
      <h1>{title}</h1>
      <form method="post" action="{action}" class="form">
        <label>邮箱<input name="email" required></label>
        <label>密码<input name="password" type="password" minlength="8" required></label>
        {f'<label>邀请码<input name="invite_code" value="{html.escape(invite_code)}" readonly></label>' if invite_code else ''}
        <button type="submit">{button}</button>
      </form>
      <p class="muted">{helper}</p>
    </section>
    """


