    def admin_affiliates_content(self, notice=""):
        con = get_db()
        bps = get_affiliate_commission_bps(con)
        users = con.execute(
            """
            select u.id,u.email,u.invite_code,u.wallet_balance_cents,
              (select count(*) from users c where c.inviter_id=u.id) invited_count,
              (select coalesce(sum(amount_cents),0) from wallet_ledger l where l.user_id=u.id and l.entry_type='affiliate_commission') total_commission
            from users u
            order by invited_count desc, u.id desc
            limit 80
            """
        ).fetchall()
        con.close()
        rows = "".join(
            f"<tr><td>{html.escape(u['email'])}</td><td>{html.escape(u['invite_code'] or '-')}</td><td>{u['invited_count']}</td><td>{money(u['total_commission'])}</td><td>{money(u['wallet_balance_cents'] or 0)}</td></tr>"
            for u in users
        ) or "<tr><td colspan='5'>暂无用户</td></tr>"
        return f"""
        {notice}
        <section class="hero compact"><h1>邀请设置</h1><p>设置被邀请人开通订单后的返佣比例。返佣按订单实付金额计算，并计入邀请人余额。</p></section>
