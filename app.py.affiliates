    )
    admin = con.execute("select id from users where email=?", (SHOP_ADMIN_EMAIL,)).fetchone()
    if admin:
        con.execute("update users set role='admin' where email=?", (SHOP_ADMIN_EMAIL,))
        if SHOP_SYNC_ADMIN_PASSWORD or SHOP_ADMIN_PASSWORD != DEFAULT_ADMIN_PASSWORD:
            con.execute(
                "update users set password_hash=? where email=?",
                (hash_password(SHOP_ADMIN_PASSWORD), SHOP_ADMIN_EMAIL),
