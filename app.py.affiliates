              <dl class="kv profile-kv">
                <dt>邮箱</dt><dd>{email}</dd>
                <dt>身份</dt><dd>{role}</dd>
                <dt>余额</dt><dd><b>{money(self.user['wallet_balance_cents'] or 0)}</b></dd>
                <dt>状态</dt><dd><span class="status-pill ok">正常</span></dd>
              </dl>
            </div>
          </article>
          <section class="n-card mobile-account-orders">
            <div class="n-card-header"><h2>账户订单</h2></div>
            <div class="n-card-content mobile-order-list">{mobile_orders}</div>
          </section>
          <article class="n-card">
            <div class="n-card-header"><h2>账户安全</h2></div>
            <div class="n-card-content profile-action-card">
              <p class="muted">如忘记密码，可通过已绑定邮箱发起重置。请勿把订阅链接或单节点链接公开转发。</p>
              <a class="button" href="/forgot-password">重置密码</a>
              <a class="button secondary mobile-profile-logout" href="/logout">退出登录</a>
            </div>
          </article>
        </section>
        """
        return self.render("个人中心", content)

    @require_user
    def get_invitations(self):
        con = get_db()
        invite_code = ensure_user_invite_code(con, self.user["id"])
        user_row = con.execute("select wallet_balance_cents from users where id=?", (self.user["id"],)).fetchone()
        invited = con.execute(
            "select id,email,created_at from users where inviter_id=? order by id desc",
            (self.user["id"],),
        ).fetchall()
        commission_rows = con.execute(
            """
            select l.*, o.order_no
            from wallet_ledger l left join orders o on o.id=l.order_id
            where l.user_id=? and l.entry_type='affiliate_commission'
            order by l.id desc limit 20
            """,
            (self.user["id"],),
        ).fetchall()
        total_commission = con.execute(
            "select coalesce(sum(amount_cents),0) from wallet_ledger where user_id=? and entry_type='affiliate_commission'",
            (self.user["id"],),
        ).fetchone()[0]
        con.commit()
        con.close()
        invite_url = PUBLIC_SUB_BASE.rstrip("/") + "/register?invite=" + urllib.parse.quote(invite_code)
        invite_share_text = build_invite_share_text(invite_url)
        invited_rows = "".join(
            f"<tr><td>{mask_email(row['email'])}</td><td>{ms_to_date(row['created_at'])}</td></tr>"
            for row in invited
        ) or "<tr><td colspan='2'>暂无邀请用户</td></tr>"
        ledger_rows = "".join(
            f"<tr><td>{html.escape(row['order_no'] or '-')}</td><td>{money(row['amount_cents'])}</td><td>{ms_to_date(row['created_at'])}</td></tr>"
            for row in commission_rows
        ) or "<tr><td colspan='3'>暂无返佣记录</td></tr>"
        content = f"""
        <section class="page-title compact-page-title">
          <div>
            <h1>我的邀请</h1>
            <p class="muted">好友注册并开通后，按后台比例返余额。</p>
          </div>
        </section>
        <section class="metrics affiliate-metrics">
          <div class="metric"><b>{len(invited)}</b><span>已邀请用户</span></div>
          <div class="metric"><b>{money(total_commission)}</b><span>累计返佣</span></div>
          <div class="metric"><b>{money(user_row['wallet_balance_cents'] if user_row else 0)}</b><span>可用余额</span></div>
        </section>
        <section class="n-card">
          <div class="n-card-header"><h2>邀请链接</h2></div>
          <div class="n-card-content">
            <div class="invite-box">
              <div>
                <span>邀请码</span>
                <b>{html.escape(invite_code)}</b>
                <p>注册链接已生成</p>
              </div>
              <div class="invite-actions">
                {copy_button("复制邀请链接", invite_url)}
                {share_panel("invite-link", "分享邀请", invite_url, invite_share_text, "invite")}
              </div>
            </div>
          </div>
        </section>
        <section class="grid two">
          <article class="n-card">
            <div class="n-card-header"><h2>邀请用户</h2></div>
            <div class="n-card-content table-wrap">
              <table><thead><tr><th>用户</th><th>注册时间</th></tr></thead><tbody>{invited_rows}</tbody></table>
            </div>
          </article>
          <article class="n-card">
            <div class="n-card-header"><h2>返佣流水</h2></div>
            <div class="n-card-content table-wrap">
              <table><thead><tr><th>订单</th><th>金额</th><th>入账时间</th></tr></thead><tbody>{ledger_rows}</tbody></table>
            </div>
          </article>
        </section>
        """
        return self.render("我的邀请", content)

