for locale_key, support_mapping in SUPPORT_TRANSLATIONS.items():
    TRANSLATIONS[locale_key].update(support_mapping)


def locale_from_accept_language(header):
    if not header:
        return "zh-CN"
    candidates = []
    for item in header.split(","):
        parts = item.strip().split(";")
        tag = parts[0].strip().lower().replace("_", "-")
        if not tag:
            continue
        quality = 1.0
        for part in parts[1:]:
            part = part.strip()
            if part.startswith("q="):
                try:
                    quality = float(part[2:])
                except ValueError:
                    quality = 0.0
        candidates.append((quality, tag))
    for _, tag in sorted(candidates, reverse=True):
        if tag in LOCALE_ALIASES:
            return LOCALE_ALIASES[tag]
        root = tag.split("-", 1)[0]
        if root in LOCALE_ALIASES:
            return LOCALE_ALIASES[root]
    return "zh-CN"


def translate_text(text, locale):
    if locale == "zh-CN":
        return text
    mapping = TRANSLATIONS.get(locale, {})
    for source in sorted(mapping, key=len, reverse=True):
        text = text.replace(source, mapping[source])
    return text


def html_lang_attr(locale):
    lang = "zh-TW" if locale == "zh-TW" else locale
    direction = ' dir="rtl"' if locale == "fa" else ""
    return f'lang="{lang}"{direction}'


def site_name(locale):
    return SITE_NAME_BY_LOCALE.get(locale, SITE_NAME_BY_LOCALE["zh-CN"])


def layout_classes(is_admin_workspace=False):
    return {
        "bodyClass": "admin-body" if is_admin_workspace else "",
        "layoutClass": "app-layout admin-layout" if is_admin_workspace else "app-layout",
        "shellClass": "shell admin-shell" if is_admin_workspace else "shell",
    }


def build_partial_payload(title, content, path, locale="zh-CN", is_admin_workspace=False):
    localized_title = translate_text(title, locale)
    payload = {
        "title": localized_title,
        "documentTitle": f"{localized_title} · {site_name(locale)}",
        "crumb": localized_title,
        "content": translate_text(content, locale),
        "path": path,
        "navKey": active_nav_key(path),
    }
    payload.update(layout_classes(is_admin_workspace))
    return payload


def default_home_for_user(user):
    return "/admin" if user and user["role"] == "admin" else "/dashboard"


def static_cache_headers():
    return {
        "Cache-Control": "public, max-age=604800, immutable",
        "Vary": "Accept-Encoding",
    }


def row_value(row, key, default=None):
    return row[key] if key in row.keys() else default


def gb_label(gb):
    return f"{gb:g} GB"


def used_gb_label(gb):
    return f"{float(gb):.2f} GB"


def traffic_capacity_label(gb):
    try:
        value = float(gb)
    except (TypeError, ValueError):
        value = 0
    return "不限GB" if value <= 0 else gb_label(value)


MONTHLY_TRAFFIC_RESET_DAYS = 30


def traffic_capacity_label_with_reset(gb, reset_days):
    label = traffic_capacity_label(gb)
    return f"{label}/月" if int(reset_days or 0) > 0 and label != "不限GB" else label


def product_type_label(product_type):
    return "流量包" if product_type == "traffic_pack" else "周期套餐"


def normalize_product_type(value):
    return "traffic_pack" if value == "traffic_pack" else "subscription"


def normalize_product_family(value, product_type="subscription", traffic_gb=None):
    if normalize_product_type(product_type) == "traffic_pack":
        return "traffic_pack"
    if value in ("unlimited", "limited"):
        return value
    try:
        traffic_value = float(traffic_gb or 0)
    except (TypeError, ValueError):
        traffic_value = 0
    return "unlimited" if traffic_value <= 0 else "limited"


def product_family_label(family):
    return {
        "unlimited": "不限量",
        "limited": "限量",
        "traffic_pack": "流量包",
    }.get(family or "", "限量")


def product_plan_badge(product):
    family = normalize_product_family(
        row_value(product, "product_family", ""),
        row_value(product, "product_type", "subscription"),
        row_value(product, "traffic_gb", 0),
    )
    return "推荐" if family == "unlimited" else "畅享"


def billing_period_label(period):
    return {
        "monthly": "月付",
        "quarterly": "季付",
        "yearly": "年付",
        "traffic_pack": "不限期",
    }.get(period or "", period or "-")


BILLING_PERIOD_MONTHS = {
    "monthly": 1,
    "quarterly": 3,
    "yearly": 12,
}


def periodic_subscription_expires_at(start_ms, billing_period):
    months = BILLING_PERIOD_MONTHS.get(billing_period)
    if not months:
        return 0
    start = time.localtime(start_ms / 1000)
    month_index = start.tm_mon - 1 + months
    target_year = start.tm_year + month_index // 12
    target_month = month_index % 12 + 1
    target_last_day = calendar.monthrange(target_year, target_month)[1]
    if start.tm_mday <= target_last_day:
        target_day = start.tm_mday
        rollback_ms = (86400 + 1) * 1000
    else:
        target_day = target_last_day
        rollback_ms = 1000
    target_ms = int(
        time.mktime(
            (
                target_year,
                target_month,
                target_day,
                start.tm_hour,
                start.tm_min,
                start.tm_sec,
                0,
                0,
                -1,
            )
        )
        * 1000
    )
    return target_ms - rollback_ms


def subscription_expires_at_for_order(order):
    product_type = normalize_product_type(row_value(order, "product_type", "subscription"))
    duration_days = int(row_value(order, "duration_days", 0) or 0)
    base_ms = int(row_value(order, "paid_at", 0) or now_ms())
    if product_type == "traffic_pack":
        return 0 if duration_days <= 0 else base_ms + duration_days * 86400 * 1000
    period_expiry = periodic_subscription_expires_at(
        base_ms,
        row_value(order, "billing_period", ""),
    )
    if period_expiry:
        return period_expiry
    return 0 if duration_days <= 0 else base_ms + duration_days * 86400 * 1000


def normalize_product_payload(form):
    product_type = normalize_product_type(form.get("product_type", "subscription"))
    raw_traffic = int(form.get("traffic_gb", "100") or 0)
    product_family = normalize_product_family(form.get("product_family", ""), product_type, raw_traffic)
    if product_family == "traffic_pack":
        product_type = "traffic_pack"
    elif product_family == "unlimited":
        product_type = "subscription"
        raw_traffic = 0
    else:
        product_type = "subscription"
    reset_days = 0 if product_type == "traffic_pack" or raw_traffic <= 0 else MONTHLY_TRAFFIC_RESET_DAYS
    return {
        "name": form.get("name", "").strip(),
        "product_type": product_type,
        "product_family": product_family,
        "billing_period": form.get("billing_period", "traffic_pack" if product_type == "traffic_pack" else "monthly"),
        "duration_days": max(0, int(form.get("duration_days", "30") or 0)),
        "traffic_gb": raw_traffic,
        "traffic_reset_days": reset_days,
        "device_limit": parse_positive_int(form.get("device_limit", "1")),
        "price_cents": int(float(form.get("price_yuan", "0") or 0) * 100),
        "active": 1 if form.get("active") == "on" else 0,
        "display_in_plans": 1 if form.get("display_in_plans") == "on" else 0,
        "sort_order": int(form.get("sort_order", "100") or 100),
    }


def product_traffic_reset_days(product):
    if normalize_product_type(row_value(product, "product_type", "subscription")) == "traffic_pack":
        return 0
    try:
        traffic_gb = float(row_value(product, "traffic_gb", 0) or 0)
    except (TypeError, ValueError):
        traffic_gb = 0
    if traffic_gb <= 0:
        return 0
    reset_days = int(row_value(product, "traffic_reset_days", MONTHLY_TRAFFIC_RESET_DAYS) or 0)
    return reset_days if reset_days > 0 else MONTHLY_TRAFFIC_RESET_DAYS


def product_traffic_label(product):
    return traffic_capacity_label_with_reset(row_value(product, "traffic_gb", 0), product_traffic_reset_days(product))


ORDER_PRODUCT_SELECT = """
coalesce(o.order_product_name,p.name) product_name,
coalesce(o.order_product_type,p.product_type) product_type,
coalesce(o.order_product_family,p.product_family) product_family,
coalesce(o.order_billing_period,p.billing_period) billing_period,
coalesce(o.order_duration_days,p.duration_days) duration_days,
coalesce(o.order_traffic_gb,p.traffic_gb) traffic_gb,
coalesce(o.order_traffic_reset_days,p.traffic_reset_days) traffic_reset_days,
coalesce(o.order_device_limit,p.device_limit) device_limit
"""


def order_product_snapshot(product):
    return {
        "order_product_name": row_value(product, "name", ""),
        "order_product_type": normalize_product_type(row_value(product, "product_type", "subscription")),
        "order_product_family": normalize_product_family(
            row_value(product, "product_family", ""),
            row_value(product, "product_type", "subscription"),
            row_value(product, "traffic_gb", 0),
        ),
        "order_billing_period": row_value(product, "billing_period", "monthly"),
        "order_duration_days": int(row_value(product, "duration_days", 30) or 0),
        "order_traffic_gb": int(row_value(product, "traffic_gb", 0) or 0),
        "order_traffic_reset_days": product_traffic_reset_days(product),
        "order_device_limit": parse_positive_int(row_value(product, "device_limit", 1)),
    }


def subscription_traffic_label(subscription):
    reset_days = int(row_value(subscription, "traffic_reset_days", 0) or 0)
    return traffic_capacity_label_with_reset(row_value(subscription, "traffic_bytes", 0) / 1024**3, reset_days)


def xui_client_traffic(email_label):
    if not email_label or not os.path.exists(XUI_DB_PATH):
        return {"up": 0, "down": 0, "last_online": 0}
    try:
        con = sqlite3.connect(f"file:{XUI_DB_PATH}?mode=ro", uri=True, timeout=2)
        con.row_factory = sqlite3.Row
        try:
            row = con.execute(
                """
                select coalesce(up,0) up, coalesce(down,0) down, coalesce(last_online,0) last_online
                from client_traffics
                where inbound_id=? and email=?
                """,
                (XUI_INBOUND_ID, email_label),
            ).fetchone()
        except sqlite3.OperationalError:
            row = con.execute(
                """
                select coalesce(up,0) up, coalesce(down,0) down
                from client_traffics
                where inbound_id=? and email=?
                """,
                (XUI_INBOUND_ID, email_label),
            ).fetchone()
        con.close()
    except sqlite3.Error:
        return {"up": 0, "down": 0, "last_online": 0}
    if not row:
        return {"up": 0, "down": 0, "last_online": 0}
    return {
        "up": int(row["up"] or 0),
        "down": int(row["down"] or 0),
        "last_online": int(row["last_online"] or 0) if "last_online" in row.keys() else 0,
    }


def yaml_quote(value):
    text = str(value)
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def subscription_usage_bytes(s):
    email_label = row_value(s, "email_label", "")
    traffic = xui_client_traffic(email_label)
    return traffic["up"], traffic["down"]


def subscription_device_usage_count(s):
    email_label = row_value(s, "email_label", "")
    if not email_label or not os.path.exists(XUI_DB_PATH):
        return 0
    ips_json = ""
    try:
        con = sqlite3.connect(f"file:{XUI_DB_PATH}?mode=ro", uri=True, timeout=2)
        con.row_factory = sqlite3.Row
        row = con.execute(
            "select ips from inbound_client_ips where client_email=?",
            (email_label,),
        ).fetchone()
        con.close()
    except sqlite3.Error:
        row = None
    if row and row["ips"]:
        ips_json = row["ips"]
    try:
        items = json.loads(ips_json) if ips_json else []
    except (TypeError, json.JSONDecodeError):
        items = []
    unique_ips = {
        str(item.get("ip", "")).strip()
        for item in items
        if isinstance(item, dict) and str(item.get("ip", "")).strip()
    }
    if unique_ips:
        return len(unique_ips)
    traffic = xui_client_traffic(email_label)
    return 1 if traffic["last_online"] > 0 else 0


def normalize_xui_time_ms(value):
    try:
        ts = int(value or 0)
    except (TypeError, ValueError):
        return 0
    if ts <= 0:
        return 0
    return ts * 1000 if ts < 10**12 else ts


def subscription_last_online_label(s):
    traffic = xui_client_traffic(row_value(s, "email_label", ""))
    last_online = normalize_xui_time_ms(traffic["last_online"])
    return ms_to_datetime(last_online) if last_online else "-"


def subscription_admin_device_html(s):
    used = subscription_device_usage_count(s)
    limit = parse_positive_int(row_value(s, "device_limit", 1))
    last_online = subscription_last_online_label(s)
    return (
        f"<span class='admin-device-count'>{used} / {limit}</span>"
        f"<small>最后在线 {html.escape(last_online)}</small>"
    )


def subscription_activity_score(s):
    upload, download = subscription_usage_bytes(s)
    used_bytes = upload + download
    traffic = xui_client_traffic(row_value(s, "email_label", ""))
    device_count = subscription_device_usage_count(s)
    is_available = 0 if subscription_unavailable_reason(s) else 1
    has_activity = 1 if device_count > 0 or used_bytes > 0 or traffic["last_online"] > 0 else 0
    return (
        is_available,
        has_activity,
        device_count,
        traffic["last_online"],
        used_bytes,
        int(row_value(s, "id", 0) or 0),
    )


def select_dashboard_subscription(subscriptions):
    if not subscriptions:
        return None
    active = [
        s
        for s in subscriptions
        if int(row_value(s, "revoked_at", 0) or 0) == 0
        and not subscription_unavailable_reason(s)
    ]
    candidates = active or list(subscriptions)
    return max(
        candidates,
        key=lambda s: (
            0 if subscription_unavailable_reason(s) else 1,
            int(row_value(s, "created_at", 0) or 0),
            int(row_value(s, "id", 0) or 0),
        ),
    )


def subscription_response_headers(s):
    upload, download = subscription_usage_bytes(s)
    total = int(row_value(s, "traffic_bytes", 0) or 0)
    expire = int((row_value(s, "expires_at", 0) or 0) / 1000)
    return {
        "Subscription-Userinfo": f"upload={upload}; download={download}; total={total}; expire={expire}",
        "Profile-Update-Interval": "24",
    }


def subscription_is_time_expired(s):
    expires_at = int(row_value(s, "expires_at", 0) or 0)
    return expires_at > 0 and expires_at <= now_ms()


def subscription_is_traffic_exhausted(s):
    total = int(row_value(s, "traffic_bytes", 0) or 0)
    if total <= 0:
        return False
    upload, download = subscription_usage_bytes(s)
    return upload + download >= total


def subscription_unavailable_reason(s):
    if int(row_value(s, "revoked_at", 0) or 0) > 0:
        reason = row_value(s, "revoked_reason", "") or "revoked"
        return "subscription replaced" if reason == "replaced" else "subscription revoked"
    if subscription_is_time_expired(s):
        return "subscription expired"
    if subscription_is_traffic_exhausted(s):
        return "subscription traffic exhausted"
    return None


def get_fair_use_policy(con, product_family):
    family = product_family or "unlimited"
    row = con.execute(
        "select * from fair_use_policies where product_family=?",
        (family,),
    ).fetchone()
    if row:
        return row
    return con.execute(
        "select * from fair_use_policies where product_family='unlimited'",
    ).fetchone()


def subscription_fair_use_status(con, subscription):
    family = row_value(subscription, "product_family", "")
    if not family:
        product_id = row_value(subscription, "product_id", None)
        if product_id:
            row = con.execute("select product_family from products where id=?", (product_id,)).fetchone()
            family = row["product_family"] if row else ""
    if family != "unlimited":
        return {"level": "normal", "used_gb": 0, "label": "限量套餐"}
    policy = get_fair_use_policy(con, "unlimited")
    upload, download = subscription_usage_bytes(subscription)
    used_gb = int(round((upload + download) / 1024**3))
    if not policy:
        return {"level": "normal", "used_gb": used_gb, "label": "未配置公平使用"}
    if used_gb >= int(policy["restrict_gb"]):
        return {"level": "restrict", "used_gb": used_gb, "label": f"超过 {policy['restrict_gb']} GB，建议限制"}
    if used_gb >= int(policy["review_gb"]):
        return {"level": "review", "used_gb": used_gb, "label": f"超过 {policy['review_gb']} GB，人工复核"}
    if used_gb >= int(policy["watch_gb"]):
        return {"level": "watch", "used_gb": used_gb, "label": f"超过 {policy['watch_gb']} GB，持续观察"}
    return {"level": "normal", "used_gb": used_gb, "label": "正常"}


def fair_use_level_label(level):
    return {
        "normal": "正常",
        "watch": "观察",
        "review": "复核",
        "restrict": "限制",
    }.get(level or "", "正常")


def ms_to_date(ms):
    if not ms:
        return "-"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ms / 1000))


def ms_to_datetime(ms):
    if not ms:
        return "-"
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ms / 1000))


def expiry_label(ms):
    return "不限期" if not ms else ms_to_date(ms)


def expiry_datetime_label(ms):
    return "不限期" if not ms else ms_to_datetime(ms)


def expiry_datetime_parts(ms):
    if not ms:
        return "不限期", ""
    text = ms_to_datetime(ms)
    date, clock = text.split(" ", 1)
    return date, clock


def duration_label(days):
    if int(days or 0) <= 0:
        return "不限期"
    if days >= 360:
        return "包年"
    if days >= 90:
        return "季度"
    if days >= 30:
        return "月付"
    return f"{days} 天"


def validity_period_label(days):
    days = int(days or 0)
    return "不限期" if days <= 0 else f"{days} 天"


def product_period_display(product):
    product_type = normalize_product_type(row_value(product, "product_type", "subscription"))
    period = row_value(product, "billing_period", "")
    if product_type == "subscription" and period in BILLING_PERIOD_MONTHS:
        return billing_period_label(period)
    return validity_period_label(row_value(product, "duration_days", 0))


def parse_positive_int(value, default=1):
    try:
        return max(1, int(value))
    except (TypeError, ValueError):
        return default


def parse_nonnegative_int(value, default=0):
    try:
        return max(0, int(value))
    except (TypeError, ValueError):
        return default


def device_limit_label(value):
    return f"{parse_positive_int(value)} 台"


def get_db():
    os.makedirs(DATA_DIR, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    con.execute("pragma foreign_keys=on")
    return con


def table_columns(con, table):
    return {row["name"] for row in con.execute(f"pragma table_info({table})").fetchall()}


def ensure_column(con, table, column, definition):
    if column not in table_columns(con, table):
        con.execute(f"alter table {table} add column {column} {definition}")


def init_db():
    con = get_db()
    con.executescript(
        """
        create table if not exists users (
            id integer primary key autoincrement,
            email text unique not null,
            password_hash text not null,
            role text not null default 'customer',
            created_at integer not null
        );

        create table if not exists products (
            id integer primary key autoincrement,
            name text not null,
            billing_period text not null,
            duration_days integer not null,
            traffic_gb integer not null,
            price_cents integer not null,
            active integer not null default 1,
            sort_order integer not null default 100,
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists orders (
            id integer primary key autoincrement,
            order_no text unique not null,
            user_id integer not null references users(id),
            product_id integer not null references products(id),
            amount_cents integer not null,
            status text not null,
            payment_method text not null default 'manual',
            payment_ref text,
            paid_at integer,
            provisioned_at integer,
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists subscriptions (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            order_id integer not null references orders(id),
            product_id integer not null references products(id),
            email_label text not null,
            sub_id text not null,
            uuid text not null,
            traffic_bytes integer not null,
            expires_at integer not null,
            clash_url text not null,
            universal_url text not null,
            xui_status text not null,
            xui_message text,
            revoked_at integer not null default 0,
            revoked_by_order_id integer references orders(id),
            revoked_reason text,
            created_at integer not null
        );

        create table if not exists password_reset_tokens (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            token_hash text unique not null,
            expires_at integer not null,
            used_at integer,
            created_at integer not null
        );

        create index if not exists idx_password_reset_tokens_hash
        on password_reset_tokens(token_hash);

        create index if not exists idx_password_reset_tokens_user
        on password_reset_tokens(user_id);

        create table if not exists payment_settings (
            provider text primary key,
            enabled integer not null default 0,
            config_json text not null default '{}',
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists payment_transactions (
            id integer primary key autoincrement,
            order_id integer not null references orders(id),
            provider text not null,
            provider_order_no text unique not null,
            amount_cents integer not null,
            status text not null,
            request_json text not null default '{}',
            response_json text not null default '{}',
            created_at integer not null,
            updated_at integer not null
        );

        create index if not exists idx_payment_transactions_order
        on payment_transactions(order_id);

        create table if not exists support_feedback (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            message text not null,
            admin_reply text,
            status text not null default 'open',
            replied_at integer,
            created_at integer not null,
            updated_at integer not null
        );

        create index if not exists idx_support_feedback_user
        on support_feedback(user_id, id);

        create index if not exists idx_support_feedback_status
        on support_feedback(status, id);

        create table if not exists subscription_compensations (
            id integer primary key autoincrement,
            subscription_id integer not null references subscriptions(id),
            admin_user_id integer references users(id),
            days integer not null,
            old_expires_at integer not null,
            new_expires_at integer not null,
            note text,
            created_at integer not null
        );

        create index if not exists idx_subscription_compensations_sub
        on subscription_compensations(subscription_id, id);

        create table if not exists site_settings (
            key text primary key,
            value text not null,
            updated_at integer not null
        );

        create table if not exists wallet_ledger (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            amount_cents integer not null,
            balance_after_cents integer not null,
            entry_type text not null,
            order_id integer references orders(id),
            note text,
            created_at integer not null
        );

        create index if not exists idx_wallet_ledger_user
        on wallet_ledger(user_id, id);

        create index if not exists idx_wallet_ledger_order
        on wallet_ledger(order_id);

        create table if not exists nodes (
            id integer primary key autoincrement,
            code text unique not null,
            name text not null,
            region text not null,
            role text not null default 'primary',
            public_host text not null,
            connect_host text not null,
            port integer not null,
            protocol text not null,
            transport text not null,
            security text not null,
            inbound_id integer not null,
            capacity_gb integer not null default 0,
            status text not null default 'active',
            sort_order integer not null default 100,
            created_at integer not null,
            updated_at integer not null
        );

        create index if not exists idx_nodes_status
        on nodes(status, sort_order);

        create table if not exists fair_use_policies (
            id integer primary key autoincrement,
            product_family text unique not null,
            watch_gb integer not null,
            review_gb integer not null,
            restrict_gb integer not null,
            action_note text not null default '',
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists admin_audit_logs (
            id integer primary key autoincrement,
            admin_user_id integer references users(id),
            action text not null,
            target_type text,
            target_id text,
            details text not null default '{}',
            created_at integer not null
        );
