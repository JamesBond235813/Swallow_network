            con.execute(
                "insert into payment_settings(provider,enabled,config_json,created_at,updated_at) values(?,?,?,?,?)",
                (provider, 0, "{}", now_ms(), now_ms()),
            )
    con.commit()
    ensure_all_invite_codes(con)
    reconcile_replaced_subscriptions(con)
    con.commit()
    con.close()


def generate_invite_code(con):
    for _ in range(20):
        code = secrets.token_urlsafe(5).replace("-", "").replace("_", "")[:8].upper()
        exists = con.execute("select id from users where invite_code=?", (code,)).fetchone()
        if not exists:
            return code
    return "N" + secrets.token_hex(6).upper()


def ensure_user_invite_code(con, user_id):
    row = con.execute("select invite_code from users where id=?", (user_id,)).fetchone()
    if row and row["invite_code"]:
        return row["invite_code"]
    code = generate_invite_code(con)
    con.execute("update users set invite_code=? where id=?", (code, user_id))
    return code


def ensure_all_invite_codes(con):
    rows = con.execute("select id from users where invite_code is null or invite_code=''").fetchall()
    for row in rows:
        ensure_user_invite_code(con, row["id"])


def set_site_setting(key, value):
    con = get_db()
    con.execute(
        "insert into site_settings(key,value,updated_at) values(?,?,?) on conflict(key) do update set value=excluded.value, updated_at=excluded.updated_at",
        (key, str(value), now_ms()),
    )
    con.commit()
    con.close()


def get_site_setting(key, default=""):
    con = get_db()
    row = con.execute("select value from site_settings where key=?", (key,)).fetchone()
    con.close()
    return row["value"] if row else default


def get_affiliate_commission_bps(con=None):
    close = False
    if con is None:
        con = get_db()
        close = True
    row = con.execute("select value from site_settings where key='affiliate_commission_bps'").fetchone()
    if close:
        con.close()
    try:
        return max(0, min(10000, int(row["value"] if row else "1000")))
    except ValueError:
        return 1000


def normalize_account_identifier(value):
    return (value or "").strip().lower()


def email_identifier_valid(value):
    account = normalize_account_identifier(value)
    if not account or any(ch.isspace() for ch in account):
        return False
    local, _, domain = account.partition("@")
    return bool(local and domain and "." in domain and len(account) <= 254)


REGISTER_REQUIREMENTS_MESSAGE = "注册请使用邮箱；密码至少 8 位。"


def user_identifier_exists(identifier):
    con = get_db()
    try:
        return bool(con.execute("select 1 from users where email=?", (normalize_account_identifier(identifier),)).fetchone())
    finally:
        con.close()


def create_customer_user(email, password, invite_code=""):
    email = normalize_account_identifier(email)
    if not email_identifier_valid(email) or len(password) < 8:
        raise ValueError("invalid email or password")
    con = get_db()
    inviter_id = None
    if invite_code:
        inviter = con.execute("select id from users where invite_code=?", (invite_code.strip().upper(),)).fetchone()
        inviter_id = inviter["id"] if inviter else None
    user_invite_code = generate_invite_code(con)
    con.execute(
        "insert into users(email,password_hash,role,created_at,invite_code,inviter_id,wallet_balance_cents) values(?,?,?,?,?,?,0)",
        (email, hash_password(password), "customer", now_ms(), user_invite_code, inviter_id),
    )
    con.commit()
    uid = con.execute("select id from users where email=?", (email,)).fetchone()[0]
    con.close()
    return uid


def adjust_wallet_balance(user_id, amount_cents, entry_type, note="", order_id=None, con=None):
    close = False
    if con is None:
        con = get_db()
        close = True
    row = con.execute("select wallet_balance_cents from users where id=?", (user_id,)).fetchone()
    if not row:
        if close:
            con.close()
        raise ValueError("user not found")
    balance = int(row["wallet_balance_cents"] or 0) + int(amount_cents)
    if balance < 0:
        if close:
            con.close()
        raise ValueError("insufficient wallet balance")
    con.execute("update users set wallet_balance_cents=? where id=?", (balance, user_id))
    con.execute(
        "insert into wallet_ledger(user_id,amount_cents,balance_after_cents,entry_type,order_id,note,created_at) values(?,?,?,?,?,?,?)",
        (user_id, int(amount_cents), balance, entry_type, order_id, note, now_ms()),
    )
    if close:
        con.commit()
        con.close()
    return balance


def create_order_for_user(user_id, product_id, use_balance=True):
    con = get_db()
    product = con.execute("select * from products where id=? and active=1 and deleted_at=0", (product_id,)).fetchone()
    user = con.execute("select * from users where id=?", (user_id,)).fetchone()
    if not product or not user:
        con.close()
        raise ValueError("product or user not found")
    gross = int(product["price_cents"])
    current_balance = int(user["wallet_balance_cents"] or 0)
    discount = min(current_balance, gross) if use_balance else 0
    payable = gross - discount
    inviter_id = user["inviter_id"]
    bps = get_affiliate_commission_bps(con) if inviter_id else 0
    commission = payable * bps // 10000 if inviter_id and payable > 0 else 0
    commission_status = "pending" if commission > 0 else "none"
    order_status = "paid" if payable == 0 else "created"
    paid_at = now_ms() if payable == 0 else None
    payment_ref = "wallet-full" if payable == 0 else None
    order_no = "O" + time.strftime("%Y%m%d") + secrets.token_hex(4).upper()
    snapshot = order_product_snapshot(product)
    con.execute(
        """
        insert into orders(
            order_no,user_id,product_id,amount_cents,status,payment_method,payment_ref,paid_at,created_at,updated_at,
            gross_amount_cents,balance_discount_cents,commission_user_id,commission_rate_bps,commission_amount_cents,commission_status,
            order_product_name,order_product_type,order_product_family,order_billing_period,order_duration_days,order_traffic_gb,order_traffic_reset_days,order_device_limit
        )
        values(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
        """,
        (
            order_no,
            user_id,
            product_id,
            payable,
            order_status,
            "wallet" if payable == 0 else "",
            payment_ref,
            paid_at,
            now_ms(),
            now_ms(),
            gross,
            discount,
            inviter_id,
            bps,
            commission,
            commission_status,
            snapshot["order_product_name"],
            snapshot["order_product_type"],
            snapshot["order_product_family"],
            snapshot["order_billing_period"],
            snapshot["order_duration_days"],
            snapshot["order_traffic_gb"],
            snapshot["order_traffic_reset_days"],
            snapshot["order_device_limit"],
        ),
    )
    order_id = con.execute("select last_insert_rowid()").fetchone()[0]
    if discount:
        adjust_wallet_balance(user_id, -discount, "balance_discount", "订阅订单余额抵扣", order_id, con)
    con.commit()
    con.close()
    return order_id


def update_pending_order_product(con, order, product):
    if order["status"] not in ("created", "pending_payment"):
        return False
    gross = int(product["price_cents"])
    old_discount = int(row_value(order, "balance_discount_cents", 0) or 0)
    new_discount = 0
    if old_discount:
        user = con.execute("select wallet_balance_cents from users where id=?", (order["user_id"],)).fetchone()
        available_balance = int(user["wallet_balance_cents"] or 0) + old_discount if user else old_discount
        new_discount = min(available_balance, gross)
        wallet_delta = old_discount - new_discount
        if wallet_delta:
            adjust_wallet_balance(
                order["user_id"],
                wallet_delta,
                "balance_discount_adjustment",
                "切换套餐周期余额调整",
                order["id"],
                con,
            )
    payable = gross - new_discount
    inviter_id = row_value(order, "commission_user_id", None)
    bps = int(row_value(order, "commission_rate_bps", 0) or 0)
    commission = payable * bps // 10000 if inviter_id and payable > 0 else 0
    status = "paid" if payable == 0 else order["status"]
    payment_ref = "wallet-full" if payable == 0 else None
    paid_at = now_ms() if payable == 0 else None
    snapshot = order_product_snapshot(product)
    con.execute(
        """
        update orders
        set product_id=?, amount_cents=?, gross_amount_cents=?, balance_discount_cents=?,
            commission_amount_cents=?, commission_status=?, status=?, payment_ref=?, paid_at=?, updated_at=?,
            order_product_name=?, order_product_type=?, order_product_family=?, order_billing_period=?,
            order_duration_days=?, order_traffic_gb=?, order_traffic_reset_days=?, order_device_limit=?
        where id=?
        """,
        (
            product["id"],
            payable,
            gross,
            new_discount,
            commission,
            "pending" if commission > 0 else "none",
            status,
            payment_ref,
            paid_at,
            now_ms(),
            snapshot["order_product_name"],
            snapshot["order_product_type"],
            snapshot["order_product_family"],
            snapshot["order_billing_period"],
            snapshot["order_duration_days"],
            snapshot["order_traffic_gb"],
            snapshot["order_traffic_reset_days"],
            snapshot["order_device_limit"],
            order["id"],
        ),
    )
    return True


def credit_order_commission(order_id, con):
    order = con.execute("select * from orders where id=?", (order_id,)).fetchone()
    if not order or order["commission_status"] != "pending":
        return
    if not order["commission_user_id"] or int(order["commission_amount_cents"] or 0) <= 0:
        con.execute("update orders set commission_status='none' where id=?", (order_id,))
        return
    adjust_wallet_balance(
        order["commission_user_id"],
        int(order["commission_amount_cents"]),
        "affiliate_commission",
        f"订单 {order['order_no']} 邀请返佣",
        order_id,
        con,
    )
    con.execute("update orders set commission_status='credited', updated_at=? where id=?", (now_ms(), order_id))


def sign(value):
    sig = hmac.new(SESSION_SECRET.encode(), value.encode(), hashlib.sha256).hexdigest()
    return f"{value}.{sig}"


def unsign(value):
    if not value or "." not in value:
        return None
    raw, sig = value.rsplit(".", 1)
    good = hmac.new(SESSION_SECRET.encode(), raw.encode(), hashlib.sha256).hexdigest()
    if hmac.compare_digest(sig, good):
        return raw
    return None


def parse_form(body):
    return {k: v[-1] for k, v in urllib.parse.parse_qs(body.decode(), keep_blank_values=True).items()}


def decode_json(value):
    try:
        return json.loads(value or "{}")
    except json.JSONDecodeError:
        return {}


