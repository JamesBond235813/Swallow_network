        "secret": ("api_v3_key", "private_key_pem", "platform_cert_pem"),
    },
    "alipay": {
        "title": "支付宝",
        "public": ("app_id", "gateway_url", "notify_url", "return_url", "sign_type"),
        "secret": ("merchant_private_key", "alipay_public_key"),
    },
}


def get_payment_setting(con, provider):
    row = con.execute("select * from payment_settings where provider=?", (provider,)).fetchone()
    if row:
        return row
    con.execute(
        "insert into payment_settings(provider,enabled,config_json,created_at,updated_at) values(?,?,?,?,?)",
        (provider, 0, "{}", now_ms(), now_ms()),
    )
    con.commit()
    return con.execute("select * from payment_settings where provider=?", (provider,)).fetchone()


def get_all_payment_settings(con):
    return {provider: get_payment_setting(con, provider) for provider in PAYMENT_CONFIG_FIELDS}


def update_payment_setting(con, provider, form):
    fields = PAYMENT_CONFIG_FIELDS[provider]
    old = decode_json(get_payment_setting(con, provider)["config_json"])
    config = {}
    for key in fields["public"]:
        value = (form.get(key, "") or "").strip()
        config[key] = value
    for key in fields["secret"]:
        value = form.get(key, "")
        config[key] = value if value else old.get(key, "")
    con.execute(
        "update payment_settings set enabled=?, config_json=?, updated_at=? where provider=?",
        (1 if form.get("enabled") == "on" else 0, json.dumps(config, ensure_ascii=False), now_ms(), provider),
    )
    con.commit()


def payment_setting_ready(row):
    if not row or not row["enabled"]:
        return False
    config = decode_json(row["config_json"])
    if row["provider"] == "wechat":
        required = ("appid", "mch_id", "api_v3_key", "merchant_serial_no", "private_key_pem")
    elif row["provider"] == "alipay":
        required = ("app_id", "merchant_private_key", "alipay_public_key")
    else:
        return False
    return all((config.get(k) or "").strip() for k in required)


def create_payment_transaction(con, order_id, provider, amount_cents):
    prefix = "PWX" if provider == "wechat" else "PAL"
    provider_order_no = prefix + time.strftime("%Y%m%d%H%M%S") + secrets.token_hex(4).upper()
    now = now_ms()
    con.execute(
        """
        insert into payment_transactions(order_id,provider,provider_order_no,amount_cents,status,request_json,response_json,created_at,updated_at)
        values(?,?,?,?,?,?,?,?,?)
        """,
        (order_id, provider, provider_order_no, amount_cents, "created", "{}", "{}", now, now),
    )
    con.execute(
        "update orders set status='pending_payment', payment_method=?, payment_ref=?, updated_at=? where id=?",
        (provider, provider_order_no, now, order_id),
    )
    con.commit()
    return {
        "id": con.execute("select last_insert_rowid()").fetchone()[0],
        "provider_order_no": provider_order_no,
        "amount_cents": amount_cents,
    }


def normalize_pem_key(value, marker):
    raw = (value or "").strip()
    if not raw:
        return ""
    if "BEGIN " in raw:
        return raw
    body = "".join(raw.split())
    lines = "\n".join(body[i : i + 64] for i in range(0, len(body), 64))
    return f"-----BEGIN {marker}-----\n{lines}\n-----END {marker}-----\n"


def alipay_sign_content(params):
    items = []
    for key in sorted(params):
        value = params[key]
        if key == "sign" or value is None or value == "":
            continue
        items.append(f"{key}={value}")
    return "&".join(items)


def alipay_sign_params(params, private_key_text):
    key_text = normalize_pem_key(private_key_text, "PRIVATE KEY")
    try:
        key = serialization.load_pem_private_key(key_text.encode(), password=None)
    except ValueError:
        key_text = normalize_pem_key(private_key_text, "RSA PRIVATE KEY")
        key = serialization.load_pem_private_key(key_text.encode(), password=None)
    signature = key.sign(
        alipay_sign_content(params).encode("utf-8"),
        padding.PKCS1v15(),
        hashes.SHA256(),
    )
    return base64.b64encode(signature).decode()


def alipay_verify_params(params, alipay_public_key_text):
    signature = params.get("sign", "")
    if not signature:
        return False
    key_text = normalize_pem_key(alipay_public_key_text, "PUBLIC KEY")
    try:
        public_key = serialization.load_pem_public_key(key_text.encode())
        public_key.verify(
            base64.b64decode(signature),
            alipay_sign_content(params).encode("utf-8"),
            padding.PKCS1v15(),
            hashes.SHA256(),
        )
        return True
    except (ValueError, InvalidSignature, TypeError):
        return False


def alipay_amount_to_cents(value):
    try:
        return int((Decimal(str(value)) * 100).quantize(Decimal("1")))
    except (InvalidOperation, ValueError):
        return -1


def build_alipay_wap_pay_params(order, tx, config):
    biz_content = {
        "out_trade_no": tx["provider_order_no"],
        "total_amount": f"{int(order['amount_cents']) / 100:.2f}",
        "subject": f"Swallow Subscription {order['order_no']}",
        "product_code": "QUICK_WAP_WAY",
    }
    params = {
        "app_id": (config.get("app_id") or "").strip(),
        "method": "alipay.trade.wap.pay",
        "format": "JSON",
        "charset": "utf-8",
        "sign_type": (config.get("sign_type") or "RSA2").strip() or "RSA2",
        "timestamp": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime()),
        "version": "1.0",
        "notify_url": (config.get("notify_url") or PUBLIC_PAYMENT_BASE + "/payment/alipay/notify").strip(),
        "return_url": (config.get("return_url") or PUBLIC_PAYMENT_BASE + "/payment/alipay/return").strip(),
        "biz_content": json.dumps(biz_content, ensure_ascii=False, separators=(",", ":")),
    }
    params["sign"] = alipay_sign_params(params, config.get("merchant_private_key", ""))
    return params


def alipay_auto_submit_page(order, tx, params, gateway_url):
    inputs = "\n".join(
        f'<input type="hidden" name="{html.escape(k)}" value="{html.escape(str(v), quote=True)}">'
        for k, v in params.items()
    )
    order_no = html.escape(order["order_no"])
    amount = money(order["amount_cents"])
    return f"""
    <section class="panel narrow payment-status-card alipay-wap-card">
      <h1>正在打开支付宝</h1>
      <p class="payment-user-copy">请在支付宝完成付款，支付成功后套餐会自动开通。</p>
      <dl class="kv payment-compact-details">
        <dt>订单号</dt><dd>{order_no}</dd>
        <dt>支付单号</dt><dd>{html.escape(tx['provider_order_no'])}</dd>
        <dt>套餐</dt><dd>{html.escape(order['product_name'])}</dd>
        <dt>金额</dt><dd>{amount}</dd>
      </dl>
      <form id="alipay-wap-pay" method="post" action="{html.escape(gateway_url, quote=True)}">
        {inputs}
        <button type="submit" class="button payment-primary-action">打开支付宝付款</button>
      </form>
      <script>document.getElementById('alipay-wap-pay').submit();</script>
    </section>
    """


def token_digest(token):
    return hashlib.sha256(token.encode()).hexdigest()


def create_password_reset_token(con, user_id):
    token = secrets.token_urlsafe(32)
    now = now_ms()
    con.execute(
        "update password_reset_tokens set used_at=? where user_id=? and used_at is null",
        (now, user_id),
    )
    con.execute(
        """
        insert into password_reset_tokens(user_id,token_hash,expires_at,created_at)
        values(?,?,?,?)
        """,
        (user_id, token_digest(token), now + PASSWORD_RESET_TTL_MS, now),
    )
    con.execute("delete from password_reset_tokens where expires_at < ? or used_at is not null", (now - PASSWORD_RESET_TTL_MS,))
    con.commit()
    return token


def find_valid_password_reset_token(con, token):
    if not token:
        return None
    return con.execute(
        """
        select t.*, u.email
        from password_reset_tokens t
        join users u on u.id=t.user_id
        where t.token_hash=? and t.used_at is null and t.expires_at>=?
        """,
        (token_digest(token), now_ms()),
    ).fetchone()


def reset_password_with_token(token, new_password):
    if len(new_password or "") < 8:
        return False
    con = get_db()
    row = find_valid_password_reset_token(con, token)
    if not row:
        con.close()
        return False
    now = now_ms()
    con.execute("update users set password_hash=? where id=?", (hash_password(new_password), row["user_id"]))
    con.execute("update password_reset_tokens set used_at=? where id=?", (now, row["id"]))
    con.commit()
    con.close()
    return True


def send_password_reset_email(email, reset_url):
    if not RESEND_API_KEY:
        return False, "RESEND_API_KEY 未配置"
    delivery_email = PASSWORD_RESET_OPERATOR_EMAIL or email
    operator_mode = bool(PASSWORD_RESET_OPERATOR_EMAIL)
    subject = "重置你的 Node1 登录密码"
    heading = "Node1 账号安全通知"
    intro = "你正在为 Node1 管理前端申请重置密码。为保护账号安全，这个链接 30 分钟内有效，且只能使用一次。"
    security_note = "本邮件只用于本次密码找回。Node1 不会通过邮件索要你的密码、验证码或付款信息。"
    text_intro = (
        "你正在为 Node1 管理前端申请重置密码。请打开下面的链接设置新密码，"
        "链接 30 分钟内有效且只能使用一次："
    )
    text_security_note = "本邮件只用于本次密码找回。Node1 不会通过邮件索要你的密码、验证码或付款信息。"
    if operator_mode:
        subject = f"Node1 用户密码重置请求：{email}"
        heading = "用户密码重置请求"
        intro = f"用户 {html.escape(email)} 申请重置 Node1 登录密码。请确认后把下面的一次性链接转交给该用户。"
        security_note = "此链接只用于本次密码找回。转交前请确认申请人身份，避免泄露账号访问权。"
        text_intro = f"用户 {email} 申请重置 Node1 登录密码。请确认后把下面的一次性链接转交给该用户："
        text_security_note = "此链接只用于本次密码找回。转交前请确认申请人身份，避免泄露账号访问权。"
    payload = {
        "from": RESEND_FROM_EMAIL,
        "to": [delivery_email],
        "subject": subject,
        "html": f"""
        <div style="font-family:-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif;line-height:1.7;color:#172033;max-width:560px">
          <p style="margin:0 0 12px;color:#667085;font-size:13px">Node1 Support · 账号安全邮件</p>
          <h2 style="margin:0 0 16px;color:#101828">{heading}</h2>
          <p>{intro}</p>
          <p style="background:#f2f4f7;border-left:4px solid #667085;padding:10px 12px;color:#344054">{security_note}</p>
          <p><a href="{html.escape(reset_url)}" style="display:inline-block;padding:10px 16px;background:#1f2937;color:#fff;text-decoration:none;border-radius:6px">设置新密码</a></p>
          <p>如果按钮无法打开，请复制下面的链接到浏览器地址栏：</p>
          <p style="word-break:break-all;color:#475467">{html.escape(reset_url)}</p>
          <hr style="border:0;border-top:1px solid #eaecf0;margin:20px 0">
          <p style="color:#667085;font-size:13px">如果不是你本人操作，可以忽略这封邮件。请不要把这封邮件或重置链接转发给他人。</p>
          <p style="color:#667085;font-size:13px">发件域名：node1.talking202606.dpdns.org</p>
        </div>
        """,
        "text": (
            f"Node1 Support - 账号安全邮件\n\n"
            f"{text_intro}\n{reset_url}\n\n"
            f"{text_security_note}\n\n"
            "如果不是你本人操作，可以忽略这封邮件。请不要把这封邮件或重置链接转发给他人。\n"
            "发件域名：node1.talking202606.dpdns.org"
        ),
    }
    req = urllib.request.Request(
        "https://api.resend.com/emails",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {RESEND_API_KEY}",
            "Content-Type": "application/json",
            "User-Agent": "subscription-shop/1.0 (+https://node1.talking202606.dpdns.org)",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            if 200 <= resp.status < 300:
                return True, body
            return False, body
    except urllib.error.HTTPError as exc:
        return False, exc.read().decode("utf-8", errors="replace")
    except urllib.error.URLError as exc:
        return False, str(exc.reason)


def current_user(handler):
    jar = cookies.SimpleCookie(handler.headers.get("Cookie"))
    morsel = jar.get("sid")
    uid = unsign(morsel.value) if morsel else None
    if not uid:
        return None
    con = get_db()
    user = con.execute("select * from users where id=?", (uid,)).fetchone()
    con.close()
    return user


def require_user(fn):
    @functools.wraps(fn)
    def wrapper(self, *args, **kwargs):
        user = current_user(self)
        if not user:
            return self.redirect("/login")
        self.user = user
        return fn(self, *args, **kwargs)
    return wrapper


def require_admin(fn):
    @functools.wraps(fn)
    def wrapper(self, *args, **kwargs):
        user = current_user(self)
        if not user:
            return self.redirect("/login")
        if user["role"] != "admin":
            return self.render("无权限", "<div class='notice danger'>需要管理员权限。</div>", 403)
        self.user = user
        return fn(self, *args, **kwargs)
    return wrapper


def support_feedback_for_user(con, user_id, limit=5):
    return con.execute(
        """
        select *
        from support_feedback
        where user_id=?
        order by id desc
        limit ?
        """,
        (user_id, limit),
    ).fetchall()


def support_feedback_panel(user):
    if not user:
        return """
        <div id="feedback" class="support-feedback-box">
          <div class="support-feedback-head">
            <b>反馈问题</b>
            <span>登录后可提交问题并查看回复。</span>
          </div>
          <a class="button secondary support-login-link" href="/login">登录反馈</a>
        </div>
        """
    con = get_db()
    rows = support_feedback_for_user(con, user["id"])
    con.close()
    history = "".join(user_feedback_item(row) for row in rows) or "<p class='muted support-empty'>暂无反馈记录。</p>"
    return f"""
    <div id="feedback" class="support-feedback-box">
      <div class="support-feedback-head">
        <b>反馈问题</b>
        <span>把现象、客户端和设备写清楚，工作人员会在这里回复。</span>
      </div>
      <form method="post" action="/support-feedback" class="support-feedback-form">
        <textarea name="message" rows="3" maxlength="600" placeholder="例如：安卓端订阅导入失败，客户端是 Clash Meta。" required></textarea>
        <button type="submit">提交反馈</button>
      </form>
      <div class="support-feedback-history">
        {history}
      </div>
    </div>
    """


def user_feedback_item(row):
    status = "已回复" if row["admin_reply"] else "待回复"
    reply = (
        f"<div class='support-reply'><b>回复</b><p>{html.escape(row['admin_reply'])}</p></div>"
        if row["admin_reply"]
        else ""
    )
    return f"""
    <div class="support-feedback-item">
      <div class="support-feedback-meta"><span>{status}</span><time>{ms_to_date(row['created_at'])}</time></div>
      <p>{html.escape(row['message'])}</p>
      {reply}
    </div>
    """


def admin_feedback_rows(con):
    rows = con.execute(
        """
        select f.*, u.email user_email
        from support_feedback f join users u on u.id=f.user_id
        order by f.id desc
        limit 200
        """
    ).fetchall()
    if not rows:
        return "<tr><td colspan='6'>暂无反馈</td></tr>"
    items = []
    for row in rows:
        reply_value = html.escape(row["admin_reply"] or "")
        status = "已回复" if row["admin_reply"] else "待回复"
        reply_form = f"""
        <form method="post" action="/admin/feedbacks/reply" class="admin-feedback-reply">
          <input type="hidden" name="feedback_id" value="{row['id']}">
          <textarea name="reply" rows="2" maxlength="600" placeholder="回复用户">{reply_value}</textarea>
          <button type="submit">保存回复</button>
        </form>
        """
        items.append(
            f"<tr><td>{html.escape(row['user_email'])}</td><td>{html.escape(row['message'])}</td><td><span class='badge'>{status}</span></td><td>{ms_to_datetime(row['created_at'])}</td><td>{ms_to_datetime(row['replied_at'])}</td><td>{reply_form}</td></tr>"
        )
    return "".join(items)


def run_ssh(command, timeout=30):
    target = f"{XUI_SSH_USER}@{XUI_HOST}"
    cmd = [
        "ssh",
        "-i",
        XUI_SSH_KEY,
        "-o",
        "BatchMode=yes",
        "-o",
        "PasswordAuthentication=no",
        "-o",
        "StrictHostKeyChecking=no",
        target,
        command,
    ]
    return subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)


def provision_xui(email_label, sub_id, client_uuid, traffic_bytes, expires_at_ms, device_limit=1, traffic_reset_days=0):
    if XUI_MODE == "mock":
        return {"ok": True, "mode": "mock", "message": "Mock provisioned. Set XUI_MODE=ssh or local for real 3X-UI provisioning."}

    client_flow = "xtls-rprx-vision" if NODE_TRANSPORT == "reality" else ""
    script = f"""
import json, sqlite3, time
p={XUI_DB_PATH!r}
inbound_id={XUI_INBOUND_ID}
ws_inbound_id={XUI_WS_INBOUND_ID}
email={email_label!r}
sub_id={sub_id!r}
uuid={client_uuid!r}
traffic={int(traffic_bytes)}
expiry={int(expires_at_ms)}
device_limit={parse_positive_int(device_limit)}
reset_days={parse_nonnegative_int(traffic_reset_days)}
flow={client_flow!r}
now=int(time.time()*1000)
con=sqlite3.connect(p); con.row_factory=sqlite3.Row
row=con.execute('select id from clients where email=?', (email,)).fetchone()
if row:
    con.execute('update clients set sub_id=?, uuid=?, flow=?, limit_ip=?, total_gb=?, expiry_time=?, enable=1, updated_at=? where email=?',
                (sub_id, uuid, flow, device_limit, traffic, expiry, now, email))
    client_id=row['id']
else:
    con.execute('insert into clients(email,sub_id,uuid,flow,limit_ip,total_gb,expiry_time,enable,created_at,updated_at) values(?,?,?,?,?,?,?,?,?,?)',
                (email, sub_id, uuid, flow, device_limit, traffic, expiry, 1, now, now))
    client_id=con.execute('select last_insert_rowid()').fetchone()[0]

def bind_inbound(target_inbound_id, target_flow, update_traffic):
    inb=con.execute('select settings from inbounds where id=?', (target_inbound_id,)).fetchone()
    if not inb:
        raise SystemExit('inbound not found: %s' % target_inbound_id)
    settings=json.loads(inb['settings'])
    clients=settings.setdefault('clients', [])
    client={{
      'comment':'',
      'created_at':now,
      'updated_at':now,
      'email':email,
      'enable':True,
      'expiryTime':expiry,
      'flow':target_flow,
      'id':uuid,
      'limitIp':device_limit,
      'reset':reset_days,
      'subId':sub_id,
      'tgId':0,
      'totalGB':traffic
    }}
    for i,c in enumerate(clients):
        if c.get('email') == email:
            clients[i]=client
            break
    else:
        clients.append(client)
    con.execute('update inbounds set settings=? where id=?', (json.dumps(settings, ensure_ascii=False, indent=2), target_inbound_id))
    con.execute('insert or ignore into client_inbounds(client_id,inbound_id,flow_override,created_at) values(?,?,?,?)',
                (client_id, target_inbound_id, target_flow, now))
    con.execute('update client_inbounds set flow_override=? where client_id=? and inbound_id=?',
                (target_flow, client_id, target_inbound_id))
    if update_traffic:
        ct=con.execute('select id from client_traffics where inbound_id=? and email=?', (target_inbound_id, email)).fetchone()
        if ct:
            con.execute('update client_traffics set enable=1,total=?,expiry_time=?,reset=? where inbound_id=? and email=?',
                        (traffic, expiry, reset_days, target_inbound_id, email))
        else:
            existing=con.execute('select id from client_traffics where email=?', (email,)).fetchone()
            if existing:
                con.execute('update client_traffics set inbound_id=?, enable=1, total=?, expiry_time=?, reset=? where email=?',
                            (target_inbound_id, traffic, expiry, reset_days, email))
            else:
                con.execute('insert into client_traffics(inbound_id,enable,email,up,down,expiry_time,total,reset,last_online) values(?,?,?,?,?,?,?,?,?)',
                            (target_inbound_id, 1, email, 0, 0, expiry, traffic, reset_days, 0))

bind_inbound(inbound_id, flow, True)
if ws_inbound_id and ws_inbound_id != inbound_id:
    bind_inbound(ws_inbound_id, '', False)
con.commit()
print('OK')
"""
    if XUI_MODE == "local":
        result = subprocess.run(["python3", "-c", script], text=True, capture_output=True, timeout=30)
        if result.returncode == 0:
            try:
                subprocess.run(["systemctl", "restart", "x-ui"], text=True, capture_output=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                pass
            return {"ok": True, "mode": "local", "message": result.stdout.strip()}
        return {"ok": False, "mode": "local", "message": result.stderr.strip() or result.stdout.strip()}
    if XUI_MODE == "ssh":
        remote = "python3 - <<'PY'\n" + script + "\nPY\nsystemctl restart x-ui\n"
        result = run_ssh(remote, timeout=45)
        if result.returncode == 0:
            return {"ok": True, "mode": "ssh", "message": result.stdout.strip()}
        return {"ok": False, "mode": "ssh", "message": result.stderr.strip() or result.stdout.strip()}
    return {"ok": False, "mode": XUI_MODE, "message": "Unknown XUI_MODE"}


def revoke_xui_clients(email_labels):
    email_labels = [e for e in dict.fromkeys(email_labels) if e]
    if not email_labels:
        return {"ok": True, "mode": XUI_MODE, "message": "No clients to revoke."}
    if XUI_MODE == "mock":
        return {"ok": True, "mode": "mock", "message": "Mock revoked."}
    script = f"""
import json, sqlite3, time
p={XUI_DB_PATH!r}
inbound_id={XUI_INBOUND_ID}
emails={email_labels!r}
now=int(time.time()*1000)
con=sqlite3.connect(p); con.row_factory=sqlite3.Row
try:
    inb=con.execute('select settings from inbounds where id=?', (inbound_id,)).fetchone()
except sqlite3.Error:
    inb=None
if inb:
    try:
        settings=json.loads(inb['settings'])
        for client in settings.get('clients', []):
            if client.get('email') in emails:
                client['enable']=False
                client['updated_at']=now
        con.execute('update inbounds set settings=? where id=?', (json.dumps(settings, ensure_ascii=False, indent=2), inbound_id))
    except (json.JSONDecodeError, sqlite3.Error, TypeError):
        pass
for email in emails:
    try:
        con.execute('update clients set enable=0, updated_at=? where email=?', (now, email))
    except sqlite3.Error:
        pass
    try:
        con.execute('update client_traffics set enable=0 where inbound_id=? and email=?', (inbound_id, email))
    except sqlite3.Error:
        pass
con.commit()
print('OK')
"""
    if XUI_MODE == "local":
        result = subprocess.run(["python3", "-c", script], text=True, capture_output=True, timeout=30)
        if result.returncode == 0:
            try:
                subprocess.run(["systemctl", "restart", "x-ui"], text=True, capture_output=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                pass
            return {"ok": True, "mode": "local", "message": result.stdout.strip()}
        return {"ok": False, "mode": "local", "message": result.stderr.strip() or result.stdout.strip()}
    if XUI_MODE == "ssh":
        remote = "python3 - <<'PY'\n" + script + "\nPY\nsystemctl restart x-ui\n"
        result = run_ssh(remote, timeout=45)
        if result.returncode == 0:
            return {"ok": True, "mode": "ssh", "message": result.stdout.strip()}
        return {"ok": False, "mode": "ssh", "message": result.stderr.strip() or result.stdout.strip()}
    return {"ok": False, "mode": XUI_MODE, "message": "Unknown XUI_MODE"}


def reconcile_replaced_subscriptions(con):
    now = now_ms()
    rows = con.execute(
        """
        select s.id, s.email_label,
          (
            select s2.order_id
            from subscriptions s2 join orders o2 on o2.id=s2.order_id
            where s2.user_id=s.user_id
              and coalesce(s2.revoked_at,0)=0
              and o2.status='provisioned'
              and (s2.expires_at=0 or s2.expires_at>?)
              and (
                coalesce(s2.created_at,0)>coalesce(s.created_at,0)
                or (coalesce(s2.created_at,0)=coalesce(s.created_at,0) and s2.id>s.id)
              )
            order by coalesce(s2.created_at,0) desc, s2.id desc
            limit 1
          ) replacement_order_id
        from subscriptions s join orders o on o.id=s.order_id
        where coalesce(s.revoked_at,0)=0
          and o.status='provisioned'
          and (s.expires_at=0 or s.expires_at>?)
          and exists (
            select 1
            from subscriptions s2 join orders o2 on o2.id=s2.order_id
            where s2.user_id=s.user_id
              and coalesce(s2.revoked_at,0)=0
              and o2.status='provisioned'
              and (s2.expires_at=0 or s2.expires_at>?)
              and (
                coalesce(s2.created_at,0)>coalesce(s.created_at,0)
                or (coalesce(s2.created_at,0)=coalesce(s.created_at,0) and s2.id>s.id)
              )
          )
        """,
        (now, now, now),
    ).fetchall()
    if not rows:
        return {"count": 0, "xui": {"ok": True, "message": "No subscriptions to replace."}}
    emails = [row["email_label"] for row in rows]
    xui_result = revoke_xui_clients(emails)
    timestamp = now_ms()
    con.executemany(
        """
        update subscriptions
        set revoked_at=?, revoked_by_order_id=?, revoked_reason='replaced',
            xui_status='replaced', xui_message=?
        where id=?
        """,
        [
            (
                timestamp,
                row["replacement_order_id"],
                "Replaced by a newer subscription. " + xui_result.get("message", ""),
                row["id"],
            )
            for row in rows
        ],
    )
    return {"count": len(rows), "xui": xui_result}


def update_xui_client_expiry(email_label, expires_at_ms):
    if not email_label:
        return {"ok": False, "mode": XUI_MODE, "message": "Missing client email."}
    if XUI_MODE == "mock":
        return {"ok": True, "mode": "mock", "message": "Mock expiry updated."}
    script = f"""
import json, sqlite3, time
p={XUI_DB_PATH!r}
inbound_id={XUI_INBOUND_ID}
email={email_label!r}
expiry={int(expires_at_ms)}
now=int(time.time()*1000)
con=sqlite3.connect(p); con.row_factory=sqlite3.Row
updated=0
inb=con.execute('select settings from inbounds where id=?', (inbound_id,)).fetchone()
if inb:
    settings=json.loads(inb['settings'])
    for client in settings.get('clients', []):
        if client.get('email') == email:
            client['expiryTime']=expiry
            client['updated_at']=now
            updated+=1
    con.execute('update inbounds set settings=? where id=?', (json.dumps(settings, ensure_ascii=False, indent=2), inbound_id))
try:
    cur=con.execute('update clients set expiry_time=?, updated_at=? where email=?', (expiry, now, email))
    updated += cur.rowcount if cur.rowcount and cur.rowcount > 0 else 0
except sqlite3.Error:
    pass
try:
    cur=con.execute('update client_traffics set expiry_time=? where inbound_id=? and email=?', (expiry, inbound_id, email))
    updated += cur.rowcount if cur.rowcount and cur.rowcount > 0 else 0
except sqlite3.Error:
    pass
con.commit()
print('OK updated=' + str(updated))
"""
    if XUI_MODE == "local":
        result = subprocess.run(["python3", "-c", script], text=True, capture_output=True, timeout=30)
        if result.returncode == 0:
            try:
                subprocess.run(["systemctl", "restart", "x-ui"], text=True, capture_output=True, timeout=20)
            except (OSError, subprocess.TimeoutExpired):
                pass
            return {"ok": True, "mode": "local", "message": result.stdout.strip()}
        return {"ok": False, "mode": "local", "message": result.stderr.strip() or result.stdout.strip()}
    if XUI_MODE == "ssh":
        remote = "python3 - <<'PY'\n" + script + "\nPY\nsystemctl restart x-ui\n"
        result = run_ssh(remote, timeout=45)
        if result.returncode == 0:
            return {"ok": True, "mode": "ssh", "message": result.stdout.strip()}
        return {"ok": False, "mode": "ssh", "message": result.stderr.strip() or result.stdout.strip()}
    return {"ok": False, "mode": XUI_MODE, "message": "Unknown XUI_MODE"}


def extend_subscription_expiry(subscription_id, days, admin_user_id=None, note=""):
    try:
        days = int(days)
    except (TypeError, ValueError):
        days = 0
    if days <= 0 or days > 3650:
        return {"ok": False, "message": "补偿天数必须在 1 到 3650 之间。"}
    con = get_db()
    try:
        sub = con.execute("select * from subscriptions where id=?", (subscription_id,)).fetchone()
        if not sub:
            return {"ok": False, "message": "订阅不存在。"}
        if int(row_value(sub, "revoked_at", 0) or 0) > 0:
            return {"ok": False, "message": "已失效订阅不能补偿。"}
        old_expires_at = int(sub["expires_at"] or 0)
        if old_expires_at <= 0:
            return {"ok": False, "message": "不限期订阅无需延长。"}
        new_expires_at = old_expires_at + days * 86400 * 1000
        result = update_xui_client_expiry(sub["email_label"], new_expires_at)
        if not result["ok"]:
            return {"ok": False, "message": "3X-UI 同步失败：" + result["message"]}
        ts = now_ms()
        message = f"Extended by {days} days. {result['message']}"
        con.execute(
            """
            update subscriptions
            set expires_at=?, xui_message=?, xui_status=case when xui_status='replaced' then xui_status else ? end
            where id=?
            """,
            (new_expires_at, message, result["mode"], subscription_id),
        )
        con.execute(
            """
            insert into subscription_compensations(subscription_id,admin_user_id,days,old_expires_at,new_expires_at,note,created_at)
            values(?,?,?,?,?,?,?)
            """,
            (subscription_id, admin_user_id, days, old_expires_at, new_expires_at, note[:300], ts),
        )
        con.commit()
        return {"ok": True, "message": message, "old_expires_at": old_expires_at, "new_expires_at": new_expires_at}
    finally:
        con.close()


class App(BaseHTTPRequestHandler):
    routes = {}

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args))

    def send_html(self, status, body, headers=None):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, status, payload, headers=None):
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, path):
        self.send_response(303)
        self.send_header("Location", path)
        self.end_headers()

    def get_body(self):
        length = int(self.headers.get("Content-Length", 0))
        return self.rfile.read(length) if length else b""

    def render(self, title, content, status=200):
        user = current_user(self)
        path = urllib.parse.urlparse(self.path).path
        locale = "zh-CN" if path.startswith("/admin") else locale_from_accept_language(self.headers.get("Accept-Language", ""))
        is_admin_workspace = bool(user and user["role"] == "admin" and path.startswith("/admin"))
        if self.headers.get("X-Node1-Partial") == "1":
            return self.send_json(status, build_partial_payload(title, content, path, locale, is_admin_workspace))
        active = {
            "dashboard": nav_active(path, "dashboard"),
            "docs": nav_active(path, "docs"),
            "plans": nav_active(path, "plans"),
            "orders": "",
            "invitations": nav_active(path, "invitations"),
            "nodes": nav_active(path, "nodes"),
            "tickets": nav_active(path, "tickets"),
            "traffic": nav_active(path, "traffic"),
            "profile": nav_active(path, "profile"),
            "admin": nav_active(path, "admin"),
            "admin_products": nav_active(path, "admin-products"),
            "admin_payments": nav_active(path, "admin-payments"),
            "admin_orders": nav_active(path, "admin-orders"),
            "admin_subscriptions": nav_active(path, "admin-subscriptions"),
            "admin_nodes": nav_active(path, "admin-nodes"),
            "admin_fair_use": nav_active(path, "admin-fair-use"),
            "admin_affiliates": nav_active(path, "admin-affiliates"),
            "admin_feedbacks": nav_active(path, "admin-feedbacks"),
        }
        if user:
            account = html.escape(user["email"])
            if is_admin_workspace:
                side = f"""
                {brand_html("side-brand", "admin", "/admin")}
                <nav class="side-menu" aria-label="管理后台">
                  <a class="side-item {active['admin']}" data-nav-link data-nav-key="admin" href="/admin"><span class="side-icon icon-admin"></span><span>管理概览</span></a>
                  <a class="side-item {active['admin_products']}" data-nav-link data-nav-key="admin-products" href="/admin/products"><span class="side-icon icon-bag"></span><span>订阅套餐</span></a>
                  <a class="side-item {active['admin_orders']}" data-nav-link data-nav-key="admin-orders" href="/admin/orders"><span class="side-icon icon-list"></span><span>订单管理</span></a>
                  <a class="side-item {active['admin_subscriptions']}" data-nav-link data-nav-key="admin-subscriptions" href="/admin/subscriptions"><span class="side-icon icon-status"></span><span>订阅管理</span></a>
                  <a class="side-item {active['admin_nodes']}" data-nav-link data-nav-key="admin-nodes" href="/admin/nodes"><span class="side-icon icon-status"></span><span>节点管理</span></a>
                  <a class="side-item {active['admin_payments']}" data-nav-link data-nav-key="admin-payments" href="/admin/payments"><span class="side-icon icon-bag"></span><span>支付配置</span></a>
                  <a class="side-item {active['admin_fair_use']}" data-nav-link data-nav-key="admin-fair-use" href="/admin/fair-use"><span class="side-icon icon-list"></span><span>公平使用</span></a>
                  <a class="side-item {active['admin_feedbacks']}" data-nav-link data-nav-key="admin-feedbacks" href="/admin/feedbacks"><span class="side-icon icon-doc"></span><span>用户反馈</span></a>
                  <a class="side-item {active['admin_affiliates']}" data-nav-link data-nav-key="admin-affiliates" href="/admin/affiliates"><span class="side-icon icon-invite"></span><span>邀请返现</span></a>
                  <a class="side-item" data-nav-link data-nav-key="dashboard" href="/dashboard"><span class="side-icon icon-home"></span><span>返回用户端</span></a>
                </nav>
                """
            else:
                admin_entry = f"""<a class="side-item" data-nav-link data-nav-key="admin" href="/admin"><span class="side-icon icon-admin"></span><span>管理后台</span></a>""" if user["role"] == "admin" else ""
                side = f"""
                {brand_html("side-brand", "dashboard", "/dashboard")}
                <nav class="side-menu" aria-label="主菜单">
                  <a class="side-item {active['dashboard']}" data-nav-link data-nav-key="dashboard" href="/dashboard"><span class="side-icon icon-home"></span><span>总览</span></a>
                  <a class="side-item {active['plans']}" data-nav-link data-nav-key="plans" href="/plans"><span class="side-icon icon-bag"></span><span>套餐</span></a>
                  <a class="side-item {active['docs']}" data-nav-link data-nav-key="docs" href="/docs"><span class="side-icon icon-doc"></span><span>文档</span></a>
                  <a class="side-item {active['profile']}" data-nav-link data-nav-key="profile" href="/profile"><span class="side-icon icon-user"></span><span>账户</span></a>
                  {admin_entry}
                </nav>
                """
        else:
            account = ""
            side = f"""
            {brand_html("side-brand", "plans", "/plans")}
            <nav class="side-menu" aria-label="主菜单">
              <a class="side-item {active['plans']}" data-nav-link data-nav-key="plans" href="/plans"><span class="side-icon icon-bag"></span><span>套餐</span></a>
              <a class="side-item {active['docs']}" data-nav-link data-nav-key="docs" href="/docs"><span class="side-icon icon-doc"></span><span>文档</span></a>
              <a class="side-item {active['profile']}" data-nav-link data-nav-key="profile" href="/login"><span class="side-icon icon-user"></span><span>登录</span></a>
              <a class="side-item" data-nav-link data-nav-key="profile" href="/register"><span class="side-icon icon-doc"></span><span>注册</span></a>
            </nav>
            """
        crumb = html.escape(title)
        mobile_home = "/dashboard" if user else "/plans"
        mobile_key = "dashboard" if user else "plans"
        mobile_brand = brand_html("mobile-brand", mobile_key, mobile_home)
        account_pill = f"<div class=\"account-pill\"><span class=\"avatar-dot\"></span><span>{account}</span><a class='top-link' href='/logout'>退出</a></div>" if user else ""
        localized_title = translate_text(title, locale)
        classes = layout_classes(is_admin_workspace)
        body_class = f' class="{classes["bodyClass"]}"' if classes["bodyClass"] else ""
        shell_class = classes["shellClass"]
        layout_class = classes["layoutClass"]
        page = f"""<!doctype html>
<html {html_lang_attr(locale)}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{html.escape(localized_title)} · {html.escape(site_name(locale))}</title>
  <meta name="theme-color" content="#ffffff">
  <link rel="manifest" href="/manifest.webmanifest?v=swallow-pwa-20260701-white-logo">
  <link rel="icon" type="image/png" href="/static/swallow-logo.png?v=swallow-brand-20260626">
  <link rel="icon" type="image/png" sizes="192x192" href="/static/android-chrome-192x192.png?v=swallow-pwa-20260701-white-logo">
  <link rel="icon" type="image/png" sizes="512x512" href="/static/android-chrome-512x512.png?v=swallow-pwa-20260701-white-logo">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png?v=swallow-pwa-20260701-white-logo">
  <link rel="shortcut icon" href="/favicon.ico?v=swallow-brand-20260626">
  <link rel="stylesheet" href="/static/style.css?v=account-order-history-20260702">
</head>
<body{body_class} data-current-path="{html.escape(path)}">
  <div class="{layout_class}" data-node1-nav>
    <aside class="sidebar">{side}</aside>
    <section class="workspace">
      <header class="topbar">
        {mobile_brand}
        <div class="breadcrumb"><span class="menu-mark"></span><span>首页</span><span>/</span><b>{crumb}</b></div>
        {account_pill}
      </header>
      <main class="{shell_class}">
        {content}
      </main>
    </section>
  </div>
  <script>
    const shell = document.querySelector('.shell');
    const crumb = document.querySelector('.breadcrumb b');
    const layout = document.querySelector('[data-node1-nav]');

    function navKeyFromUrl(url, fallbackKey) {{
      if (url.hash === '#orders') return 'orders';
      return fallbackKey || '';
    }}

    function setActiveNav(navKey) {{
      document.querySelectorAll('[data-nav-link]').forEach(function (link) {{
        link.classList.toggle('active', !!navKey && link.getAttribute('data-nav-key') === navKey);
      }});
    }}

    function applyLayoutClasses(payload) {{
      document.body.classList.toggle('admin-body', payload.bodyClass === 'admin-body');
      if (layout && payload.layoutClass) layout.className = payload.layoutClass;
      if (shell && payload.shellClass) shell.className = payload.shellClass;
    }}

    function scrollToHash(hash) {{
      if (!hash) {{
        window.scrollTo({{ top: 0, behavior: 'smooth' }});
        return;
      }}
      const target = document.querySelector(hash);
      if (target) target.scrollIntoView({{ behavior: 'smooth', block: 'start' }});
    }}

    function updateProductDurationFields(root) {{
      (root || document).querySelectorAll('form.grid-form').forEach(function (form) {{
        const productType = form.querySelector('[name="product_type"]');
        const productFamily = form.querySelector('[name="product_family"]');
        const billingPeriod = form.querySelector('[name="billing_period"]');
        const durationField = form.querySelector('[data-duration-field]');
        if (!durationField) return;
        const isTrafficPack =
          (productType && productType.value === 'traffic_pack') ||
          (productFamily && productFamily.value === 'traffic_pack') ||
          (billingPeriod && billingPeriod.value === 'traffic_pack');
        durationField.hidden = !isTrafficPack;
      }});
    }}

    async function loadPartialPage(link) {{
      const url = new URL(link.href, window.location.href);
      if (url.origin !== window.location.origin) return false;
      const currentPath = document.body.getAttribute('data-current-path') || window.location.pathname;
      const crossesWorkspace = currentPath.startsWith('/admin') !== url.pathname.startsWith('/admin');
      if (crossesWorkspace) return false;
      document.body.classList.add('is-navigating');
      try {{
        const response = await fetch(url.pathname + url.search, {{
          headers: {{ 'X-Node1-Partial': '1' }},
          credentials: 'same-origin'
        }});
        const contentType = response.headers.get('content-type') || '';
        if (!response.ok || !contentType.includes('application/json')) return false;
        const payload = await response.json();
        applyLayoutClasses(payload);
        shell.innerHTML = payload.content || '';
        updateProductDurationFields(shell);
        crumb.textContent = payload.crumb || payload.title || '';
        document.title = payload.documentTitle || ((payload.title || '') + ' · {site_name(locale)}');
        document.body.setAttribute('data-current-path', payload.path || url.pathname);
        setActiveNav(navKeyFromUrl(url, payload.navKey));
        window.history.pushState({{ node1Partial: true }}, '', url.pathname + url.search + url.hash);
        window.requestAnimationFrame(function () {{
          document.body.classList.remove('is-navigating');
          document.body.classList.add('nav-loaded');
          window.setTimeout(function () {{ document.body.classList.remove('nav-loaded'); }}, 180);
          scrollToHash(url.hash);
        }});
        return true;
      }} catch (err) {{
        return false;
      }} finally {{
        window.setTimeout(function () {{ document.body.classList.remove('is-navigating'); }}, 350);
      }}
    }}

    window.addEventListener('popstate', function () {{
      window.location.reload();
    }});

    updateProductDurationFields(document);

    document.addEventListener('change', function (event) {{
      if (event.target.matches('[name="product_type"], [name="product_family"], [name="billing_period"]')) {{
        updateProductDurationFields(event.target.closest('form') || document);
      }}
    }});

    document.addEventListener('click', async function (event) {{
      const navLink = event.target.closest('a[data-nav-link]');
      if (navLink && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey) {{
        event.preventDefault();
        const ok = await loadPartialPage(navLink);
        if (!ok) window.location.href = navLink.href;
        return;
      }}
      const filterButton = event.target.closest('[data-plan-filter]');
      if (filterButton) {{
        const filter = filterButton.getAttribute('data-plan-filter');
        document.querySelectorAll('[data-plan-filter]').forEach(function (btn) {{ btn.classList.toggle('active', btn === filterButton); }});
        document.querySelectorAll('.plan[data-period]').forEach(function (card) {{
          const show = filter === 'all' || card.getAttribute('data-period') === filter || card.getAttribute('data-traffic-tier') === filter;
          card.hidden = !show;
        }});
        return;
      }}
      const shareSummary = event.target.closest('.share-panel summary');
      if (shareSummary) {{
        const panel = shareSummary.closest('.share-panel');
        document.querySelectorAll('.share-panel[open]').forEach(function (openPanel) {{
          if (openPanel !== panel) openPanel.removeAttribute('open');
        }});
      }}
      const shareClose = event.target.closest('[data-share-close]');
      if (shareClose) {{
        const panel = shareClose.closest('.share-panel');
        if (panel) panel.removeAttribute('open');
        return;
      }}
      const openSharePanel = document.querySelector('.share-panel[open]');
      if (openSharePanel && openSharePanel === event.target.closest('.share-panel') && !event.target.closest('.share-sheet') && !event.target.closest('summary')) {{
        openSharePanel.removeAttribute('open');
        return;
      }}
      const configLink = event.target.closest('[data-config-link]');
      if (configLink) {{
        window.setTimeout(function () {{
          const fallback = document.querySelector('[data-config-fallback]');
          if (fallback) fallback.classList.add('is-visible');
        }}, 800);
      }}
      const button = event.target.closest('[data-copy-value]');
      if (!button || button.disabled) return;
      const value = button.getAttribute('data-copy-value') || '';
      if (!value) return;
      try {{
        await navigator.clipboard.writeText(value);
        const oldText = button.textContent;
        button.textContent = '已复制';
        window.setTimeout(function () {{ button.textContent = oldText; }}, 1400);
      }} catch (err) {{
        button.textContent = '复制失败';
      }}
    }});

    document.addEventListener('keydown', function (event) {{
      if (event.key === 'Escape') {{
        document.querySelectorAll('.share-panel[open]').forEach(function (panel) {{
          panel.removeAttribute('open');
        }});
      }}
    }});
  </script>
</body>
</html>"""
        page = translate_text(page, locale)
        self.send_html(status, page)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/" + WECHAT_VERIFY_FILENAME:
            return self.static_wechat_verify()
        if path == "/static/style.css":
            return self.static_css()
        if path == "/manifest.webmanifest":
            return self.static_webmanifest()
        if path.startswith("/static/") and os.path.basename(path) in PWA_ICON_FILES:
            return self.static_icon(os.path.basename(path))
        if path == "/static/swallow-logo.png":
            return self.static_swallow_logo()
        if path == "/favicon.ico":
            return self.static_favicon()
        if path.startswith("/clashx/"):
            return self.get_clash_subscription(path)
        if path.startswith("/sub/"):
            return self.get_universal_subscription(path)
        name = "get_index" if path == "/" else "get_" + path.strip("/").replace("/", "_").replace("-", "_")
        handler = getattr(self, name, None)
        if handler:
            return handler()
        if path.startswith("/admin/products/") and path.endswith("/edit"):
            return self.get_admin_product_edit(path)
        return self.render("未找到", "<div class='notice danger'>页面不存在。</div>", 404)

    @require_user
    def get_referrals(self):
        return self.redirect("/dashboard#invite")

    def do_HEAD(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/" + WECHAT_VERIFY_FILENAME:
            return self.static_wechat_verify(head_only=True)
        if path == "/favicon.ico":
            return self.static_favicon(head_only=True)
        if path == "/manifest.webmanifest":
            return self.static_webmanifest(head_only=True)
        if path.startswith("/static/") and os.path.basename(path) in PWA_ICON_FILES:
            return self.static_icon(os.path.basename(path), head_only=True)
        if path == "/static/swallow-logo.png":
            return self.static_swallow_logo(head_only=True)
        if path.startswith("/clashx/"):
            return self.get_clash_subscription(path, head_only=True)
        if path.startswith("/sub/"):
            return self.get_universal_subscription(path, head_only=True)
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        handler = getattr(self, "post_" + path.strip("/").replace("/", "_").replace("-", "_"), None)
        if handler:
            return handler()
        if path.startswith("/admin/products/") and path.endswith("/edit"):
            return self.post_admin_product_edit(path)
        if path.startswith("/admin/products/") and (path.endswith("/enable") or path.endswith("/disable")):
            return self.post_admin_product_status(path)
        if path.startswith("/admin/products/") and path.endswith("/delete"):
            return self.post_admin_product_delete(path)
        if path.startswith("/admin/orders/"):
            return self.post_admin_order_action(path)
        if path.startswith("/admin/subscriptions/") and path.endswith("/extend"):
            return self.post_admin_subscription_extend(path)
        if path.startswith("/orders/") and path.endswith("/pay"):
            return self.post_order_pay(path)
        if path.startswith("/orders/") and path.endswith("/switch-product"):
            return self.post_order_switch_product(path)
        if path.startswith("/orders/") and path.endswith("/cancel"):
            return self.post_order_cancel(path)
        return self.render("未找到", "<div class='notice danger'>操作不存在。</div>", 404)

    def static_css(self):
        with open(os.path.join(APP_DIR, "static", "style.css"), "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/css; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        for key, value in static_cache_headers().items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def static_swallow_logo(self, head_only=False):
        with open(os.path.join(APP_DIR, "static", "swallow-logo.png"), "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "image/png")
        self.send_header("Content-Length", str(len(data)))
        for key, value in static_cache_headers().items():
            self.send_header(key, value)
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def static_icon(self, filename, head_only=False):
        with open(os.path.join(APP_DIR, "static", filename), "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "image/png")
        self.send_header("Content-Length", str(len(data)))
        for key, value in static_cache_headers().items():
            self.send_header(key, value)
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def static_webmanifest(self, head_only=False):
        data = json.dumps({
            "name": "燕子",
            "short_name": "燕子",
            "start_url": "/",
            "scope": "/",
            "display": "standalone",
            "background_color": "#ffffff",
            "theme_color": "#ffffff",
            "icons": [
                {
                    "src": "/static/android-chrome-192x192.png?v=swallow-pwa-20260701-white-logo",
                    "sizes": "192x192",
                    "type": "image/png",
                    "purpose": "any",
                },
                {
                    "src": "/static/android-chrome-512x512.png?v=swallow-pwa-20260701-white-logo",
                    "sizes": "512x512",
                    "type": "image/png",
                    "purpose": "any",
                },
                {
                    "src": "/static/maskable-icon-512x512.png?v=swallow-pwa-20260701-white-logo",
                    "sizes": "512x512",
                    "type": "image/png",
                    "purpose": "maskable",
                },
            ],
        }, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/manifest+json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        for key, value in static_cache_headers().items():
            self.send_header(key, value)
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def static_favicon(self, head_only=False):
        with open(os.path.join(APP_DIR, "static", "favicon.ico"), "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "image/x-icon")
        self.send_header("Content-Length", str(len(data)))
        for key, value in static_cache_headers().items():
            self.send_header(key, value)
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def static_wechat_verify(self, head_only=False):
        return self.send_text(200, WECHAT_VERIFY_CONTENT, head_only=head_only)

    def send_text(self, status, body, content_type="text/plain; charset=utf-8", headers=None, head_only=False):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        for key, value in (headers or {}).items():
            self.send_header(key, str(value))
        self.end_headers()
        if not head_only:
            self.wfile.write(data)

    def get_subscription_by_path(self, path, prefix):
        sub_id = urllib.parse.unquote(path[len(prefix):]).strip()
        if not sub_id or "/" in sub_id:
            return None
        con = get_db()
        row = con.execute("select * from subscriptions where sub_id=?", (sub_id,)).fetchone()
        con.close()
        return row

    def get_universal_subscription(self, path, head_only=False):
        sub = self.get_subscription_by_path(path, "/sub/")
        if not sub:
            return self.send_text(404, "subscription not found", head_only=head_only)
        unavailable = subscription_unavailable_reason(sub)
        if unavailable:
            return self.send_text(410, unavailable, head_only=head_only)
        return self.send_text(200, build_node_url(sub) + "\n", headers=subscription_response_headers(sub), head_only=head_only)

    def get_clash_subscription(self, path, head_only=False):
        sub = self.get_subscription_by_path(path, "/clashx/")
        if not sub:
            return self.send_text(404, "subscription not found", head_only=head_only)
        unavailable = subscription_unavailable_reason(sub)
        if unavailable:
            return self.send_text(410, unavailable, head_only=head_only)
        body = build_clash_config(sub)
        return self.send_text(200, body, "application/yaml; charset=utf-8", subscription_response_headers(sub), head_only=head_only)

    def get_index(self):
        user = current_user(self)
        if user:
            return self.redirect(default_home_for_user(user))
        return self.get_plans()

