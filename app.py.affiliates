    con.execute("update products set traffic_reset_days=30 where product_type!='traffic_pack' and traffic_gb>0")
    con.execute(
        """
        update orders
        set order_product_name=(select p.name from products p where p.id=orders.product_id),
            order_product_type=(select p.product_type from products p where p.id=orders.product_id),
            order_product_family=(select p.product_family from products p where p.id=orders.product_id),
            order_billing_period=(select p.billing_period from products p where p.id=orders.product_id),
            order_duration_days=(select p.duration_days from products p where p.id=orders.product_id),
            order_traffic_gb=(select p.traffic_gb from products p where p.id=orders.product_id),
            order_traffic_reset_days=(select p.traffic_reset_days from products p where p.id=orders.product_id),
            order_device_limit=(select p.device_limit from products p where p.id=orders.product_id)
        where order_product_name is null
          and exists (select 1 from products p where p.id=orders.product_id)
        """
    )
    con.execute(
        """
        update subscriptions
        set traffic_reset_days=30
        where traffic_bytes>0
          and traffic_reset_days=0
          and exists (
            select 1 from products p
            where p.id=subscriptions.product_id
              and coalesce(p.product_type,'subscription')!='traffic_pack'
          )
