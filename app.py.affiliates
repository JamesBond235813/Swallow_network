    @require_user
    def post_orders(self):
        form = parse_form(self.get_body())
        product_id = int(form.get("product_id", "0") or 0)
        try:
            order_id = create_order_for_user(self.user["id"], product_id, use_balance=True)
        except ValueError:
            return self.render("下单失败", "<div class='notice danger'>套餐不存在或已下架。</div>", 400)
        con = get_db()
        order = con.execute("select status from orders where id=?", (order_id,)).fetchone()
        con.close()
        if order and order["status"] == "paid":
            provision_order(order_id)
            return self.redirect("/dashboard")
        return self.redirect(f"/checkout?id={order_id}")

    @require_user
    def get_checkout(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        order_id = int(qs.get("id", ["0"])[0])
        con = get_db()
        order = con.execute(
            f"""
            select o.*, {ORDER_PRODUCT_SELECT}
            from orders o join products p on p.id=o.product_id
            where o.id=? and o.user_id=?
            """,
            (order_id, self.user["id"]),
        ).fetchone()
        if not order:
            con.close()
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        settings = get_all_payment_settings(con)
        enabled_methods = [p for p, row in settings.items() if payment_setting_ready(row)]
        period_tabs = checkout_period_tabs(order, checkout_period_variants(con, order))
        con.close()
        devices = f"{device_limit_label(row_value(order, 'device_limit', 1))}设备"
        duration_text = product_period_display(order)
        gross = money(order["gross_amount_cents"] or order["amount_cents"])
        discount = money(order["balance_discount_cents"])
        payable = money(order["amount_cents"])
        content = f"""
        <section class="panel narrow checkout-card user-checkout-card">
          <div class="checkout-head">
            <span>确认订单</span>
            <b>{payable}</b>
          </div>
          <div class="checkout-plan-line">
            <strong>{html.escape(order['product_name'])}</strong>
            <span>{product_traffic_label(order)} / {duration_text} / {devices}</span>
          </div>
          <div class="checkout-summary-card">
            <div class="checkout-summary-row"><span>订单号</span><b>{html.escape(order['order_no'])}</b></div>
            <div class="checkout-summary-row"><span>套餐原价</span><b>{gross}</b></div>
            <div class="checkout-summary-row"><span>余额抵扣</span><b>- {discount}</b></div>
          </div>
          <div class="checkout-total-bar">
            <span>实付金额</span>
            <b>{payable}</b>
          </div>
          {period_tabs}
          <form method="post" action="/orders/{order['id']}/pay" id="checkout-pay-{order['id']}" class="form checkout-payment">
            <div>
              <h2>支付方式</h2>
              <p class="muted">提交后等待管理员确认收款并开通。</p>
            </div>
            {payment_method_choices(enabled_methods, compact=True)}
          </form>
          <div class="checkout-action-row">
            <form method="post" action="/orders/{order['id']}/cancel" class="checkout-cancel-form">
              <button type="submit" class="checkout-cancel">取消</button>
            </form>
            <button type="submit" form="checkout-pay-{order['id']}" class="checkout-submit">继续支付</button>
          </div>
        </section>
        """
        return self.render("确认订单", content)

    @require_user
    def post_order_pay(self, path):
        order_id = int(path.split("/")[2])
        form = parse_form(self.get_body())
        payment_method = (form.get("payment_method", "") or "").strip()
        con = get_db()
        order = con.execute(
            f"""
            select o.*, {ORDER_PRODUCT_SELECT}
            from orders o join products p on p.id=o.product_id
            where o.id=? and o.user_id=?
            """,
            (order_id, self.user["id"]),
        ).fetchone()
        if not order:
            con.close()
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        if order["status"] not in ("created", "pending_payment"):
            con.close()
            return self.redirect("/dashboard")
        if payment_method not in (*PAYMENT_CONFIG_FIELDS.keys(), "manual"):
            con.close()
            return self.render("请选择支付方式", "<div class='notice danger'>请选择支付方式后再继续支付。</div>", 400)
        if payment_method in PAYMENT_CONFIG_FIELDS:
            setting = get_payment_setting(con, payment_method)
            if not payment_setting_ready(setting):
                con.close()
                return self.render("支付不可用", "<div class='notice danger'>该支付方式尚未配置完整，请选择其他支付方式。</div>", 400)
            tx = create_payment_transaction(con, order_id, payment_method, order["amount_cents"])
            if payment_method == "alipay":
                config = decode_json(setting["config_json"])
                params = build_alipay_wap_pay_params(order, tx, config)
                con.execute(
                    "update payment_transactions set request_json=?, updated_at=? where id=?",
                    (json.dumps(params, ensure_ascii=False), now_ms(), tx["id"]),
                )
                con.commit()
                gateway_url = (config.get("gateway_url") or "https://openapi.alipay.com/gateway.do").strip()
                con.close()
                return self.render("支付宝支付", alipay_auto_submit_page(order, tx, params, gateway_url))
            con.close()
            return self.render("支付订单", payment_pending_page(order, payment_method, tx))
        if payment_method == "manual":
            con.execute(
                "update orders set status='pending_payment',payment_method='manual',payment_ref=?,updated_at=? where id=?",
                ("manual-review-" + secrets.token_hex(5), now_ms(), order_id),
            )
            con.commit()
            con.close()
            return self.render("等待确认", payment_pending_page(order, "manual", None))
        con.close()
        return self.redirect("/dashboard")

    @require_user
    def post_order_switch_product(self, path):
        try:
            order_id = int(path.split("/")[2])
        except (IndexError, ValueError):
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        form = parse_form(self.get_body())
        product_id = int(form.get("product_id", "0") or 0)
        con = get_db()
        order = con.execute(
            f"""
            select o.*, {ORDER_PRODUCT_SELECT}
            from orders o join products p on p.id=o.product_id
            where o.id=? and o.user_id=?
            """,
            (order_id, self.user["id"]),
        ).fetchone()
        product = con.execute("select * from products where id=? and active=1 and deleted_at=0", (product_id,)).fetchone()
        if not order or not product:
            con.close()
            return self.redirect(f"/checkout?id={order_id}")
        current_family = normalize_product_family(row_value(order, "product_family", ""), row_value(order, "product_type", "subscription"))
        target_family = normalize_product_family(row_value(product, "product_family", ""), row_value(product, "product_type", "subscription"), row_value(product, "traffic_gb", 0))
        valid_period = row_value(product, "billing_period", "") in ("monthly", "quarterly", "yearly")
        if current_family in ("unlimited", "limited") and target_family == current_family and valid_period:
            update_pending_order_product(con, order, product)
            con.commit()
        con.close()
        return self.redirect(f"/checkout?id={order_id}")

    @require_user
    def post_order_cancel(self, path):
        try:
            order_id = int(path.split("/")[2])
        except (IndexError, ValueError):
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        con = get_db()
        con.execute(
            "update orders set status='cancelled',updated_at=? where id=? and user_id=? and status in ('created','pending_payment')",
            (now_ms(), order_id, self.user["id"]),
        )
        con.commit()
        con.close()
        return self.redirect("/profile")

    @require_admin
    def get_admin(self):
        con = get_db()
        active_subscriptions = con.execute(
            "select count(*) from subscriptions where revoked_at=0"
        ).fetchone()[0]
        active_nodes = con.execute(
            "select count(*) from nodes where status='active'"
        ).fetchone()[0]
        visible_products = con.execute(
            "select count(*) from products where active=1 and display_in_plans=1 and deleted_at=0"
        ).fetchone()[0]
        high_risk = fair_use_subscription_count(con, risk="high")
        monthly_usage = fair_use_total_usage_gb(con)
        stats = {
            "用户": con.execute("select count(*) from users where role='customer'").fetchone()[0],
            "有效订阅": active_subscriptions,
            "展示套餐": visible_products,
            "活跃节点": active_nodes,
            "风控关注": high_risk,
            "月流量GB": monthly_usage,
        }
        node_rows = admin_node_rows(con)
        policy_rows = admin_fair_use_policy_rows(con)
        high_risk_rows = admin_subscription_rows(con, risk="high", limit=5)
        con.close()
        cards = "".join(f"<div class='metric'><b>{v}</b><span>{k}</span></div>" for k, v in stats.items())
        content = f"""
        <section class="hero compact"><h1>管理后台</h1><p>统计、监控、节点、套餐和公平使用风控。</p></section>
        <section class="metrics">{cards}</section>
        <section class="n-card">
          <div class="n-card-header"><h2>运营工作台</h2></div>
          <div class="n-card-content">
            <form method="get" action="/admin/subscriptions" class="form grid-form">
              <label>定向查找<input name="q" placeholder="邮箱 / 订阅ID / 客户端 / UUID / 套餐"></label>
              <label>公平使用
                <select name="risk">
                  <option value="all">全部</option>
                  <option value="high">高消耗</option>
                  <option value="watch">观察</option>
                  <option value="review">复核</option>
                  <option value="restrict">限制</option>
                </select>
              </label>
              <button type="submit">查找订阅</button>
            </form>
          </div>
        </section>
        <section class="n-card">
          <div class="n-card-header"><h2>节点状态</h2><a href="/admin/nodes">查看全部</a></div>
          <div class="n-card-content table-wrap">
            <table><thead><tr><th>节点</th><th>地区</th><th>角色</th><th>协议</th><th>入口</th><th>入站</th><th>容量</th><th>状态</th></tr></thead><tbody>{node_rows}</tbody></table>
          </div>
        </section>
        <section class="n-card">
          <div class="n-card-header"><h2>公平使用监控</h2><a href="/admin/fair-use">查看全部</a></div>
          <div class="n-card-content table-wrap">
            <table><thead><tr><th>套餐类别</th><th>观察</th><th>复核</th><th>限制</th><th>处理说明</th></tr></thead><tbody>{policy_rows}</tbody></table>
          </div>
        </section>
        <section class="n-card">
          <div class="n-card-header"><h2>高消耗订阅</h2><a href="/admin/subscriptions?risk=high">定向处理</a></div>
          <div class="n-card-content table-wrap">
            <table><thead><tr><th>用户</th><th>套餐</th><th>订阅 ID</th><th>3X-UI 客户端</th><th>流量</th><th>设备使用</th><th>公平使用</th><th>到期时间</th><th>状态</th><th>订单</th><th>操作</th></tr></thead><tbody>{high_risk_rows}</tbody></table>
          </div>
        </section>
        """
        return self.render("管理后台", content)

    @require_admin
    def get_admin_nodes(self):
        con = get_db()
