    @require_user
    def post_support_feedback(self):
        form = parse_form(self.get_body())
        message = form.get("message", "").strip()
        if not message:
            return self.redirect("/docs#feedback")
        if len(message) > 600:
            message = message[:600]
        ts = now_ms()
        con = get_db()
        con.execute(
            """
            insert into support_feedback(user_id,message,status,created_at,updated_at)
            values(?,?,?,?,?)
            """,
            (self.user["id"], message, "open", ts, ts),
        )
        con.commit()
        con.close()
        return self.redirect("/docs#feedback")

    def get_plans(self):
        con = get_db()
        products = con.execute("select * from products where active=1 and display_in_plans=1 and deleted_at=0 order by sort_order,id").fetchall()
        con.close()
        cards = []
        for p in products:
            duration = product_period_display(p)
            traffic = product_traffic_label(p)
            devices = f"{device_limit_label(row_value(p, 'device_limit', 1))}设备"
            device_spec = f"{devices}共用"
            badge = product_plan_badge(p)
            plan_tone = "featured" if p["duration_days"] >= 90 or p["traffic_gb"] >= 500 else "standard"
            traffic_tier = "high" if p["traffic_gb"] >= 500 else "standard"
            duration_text = product_period_display(p)
            cards.append(f"""
            <article class="plan {plan_tone}" id="plan-{p['id']}" data-period="{html.escape(p['billing_period'])}" data-traffic-tier="{traffic_tier}">
              <div class="plan-ribbon"></div>
              <div class="plan-card-main">
                <div class="plan-head">
                  <div>
                    <span class="plan-badge">{badge}</span>
                    <h2>{html.escape(p['name'])}</h2>
                    <p class="plan-meta-line">{traffic} / {duration_text} / {device_spec}</p>
                  </div>
                  <p class="plan-price"><b>{money(p['price_cents'])}</b><span>/{duration}</span></p>
                </div>
                <div class="plan-feature-grid">
                  <div><b>{traffic}</b><span>流量</span></div>
                  <div><b>{duration_text}</b><span>有效期</span></div>
                  <div><b>{device_spec}</b><span>设备</span></div>
                </div>
                <div class="plan-highlights">
                  <p>低延迟 | 智能分流 | 高速稳定 | 甄选优质线路</p>
                  <p>支持 iOS/ Android/ MacOS/ Windows全平台</p>
                </div>
              </div>
              <div class="plan-actions">
                <form method="post" action="/orders" class="plan-cta">
                  <input type="hidden" name="product_id" value="{p['id']}">
                  <button type="submit">立即订阅</button>
                </form>
              </div>
            </article>
            """)
        content = f"""
        <section class="page-title">
          <h1>选择最适合您的计划</h1>
          <div class="radio-tabs" data-plan-tabs>
            <button type="button" class="active" data-plan-filter="all">全部</button>
            <button type="button" data-plan-filter="monthly">月付</button>
            <button type="button" data-plan-filter="high">大流量</button>
          </div>
        </section>
        <section class="grid plans">{''.join(cards)}</section>
        """
        return self.render("套餐", content)

    def get_register(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        invite_code = (qs.get("invite", [""])[0] or qs.get("ref", [""])[0]).strip().upper()
        return self.render("注册", form_page("注册", "/register", include_name=False, button="创建账户", invite_code=invite_code))

    def post_register(self):
        form = parse_form(self.get_body())
        email = normalize_account_identifier(form.get("email", ""))
        password = form.get("password", "")
        if user_identifier_exists(email):
            return self.render("注册", "<div class='notice danger'>账号已存在，请直接登录。</div>" + form_page("注册", "/register", button="创建账户"), 400)
        if not email_identifier_valid(email) or len(password) < 8:
            return self.render("注册", f"<div class='notice danger'>{REGISTER_REQUIREMENTS_MESSAGE}</div>" + form_page("注册", "/register", button="创建账户"), 400)
        invite_code = form.get("invite_code", "").strip().upper()
        try:
            uid = create_customer_user(email, password, invite_code)
        except sqlite3.IntegrityError:
            return self.render("注册", "<div class='notice danger'>账号已存在，请直接登录。</div>" + form_page("注册", "/register", button="创建账户"), 400)
        except ValueError:
            return self.render("注册", f"<div class='notice danger'>{REGISTER_REQUIREMENTS_MESSAGE}</div>" + form_page("注册", "/register", button="创建账户"), 400)
        return self.set_session(uid)

    def get_login(self):
        return self.render("登录", login_page())

    def post_login(self):
        form = parse_form(self.get_body())
        email = normalize_account_identifier(form.get("email", ""))
        password = form.get("password", "")
        con = get_db()
        user = con.execute("select * from users where email=?", (email,)).fetchone()
        role = user["role"] if user else ""
        con.close()
        if not user or not verify_password(password, user["password_hash"]):
            return self.render("登录", "<div class='notice danger'>账号/邮箱或密码错误。</div>" + login_page(), 401)
        return self.set_session(user["id"], "/admin" if role == "admin" else "/dashboard")

    def get_forgot_password(self):
        return self.render("找回密码", forgot_password_page())

    def post_forgot_password(self):
        form = parse_form(self.get_body())
        email = form.get("email", "").strip().lower()
        if PASSWORD_RESET_OPERATOR_EMAIL:
            generic_notice = "<div class='notice'>如果这个邮箱已注册，系统会通知管理员处理密码重置请求。</div>"
        else:
            generic_notice = "<div class='notice'>如果这个邮箱已注册，系统会发送一封密码重置邮件。请检查收件箱和垃圾邮件。</div>"
        if "@" not in email:
            return self.render("找回密码", generic_notice + forgot_password_page())
        con = get_db()
        user = con.execute("select id,email from users where email=?", (email,)).fetchone()
        if not user:
            con.close()
            return self.render("找回密码", generic_notice + forgot_password_page())
        token = create_password_reset_token(con, user["id"])
        con.close()
        reset_url = PUBLIC_SUB_BASE.rstrip("/") + "/reset-password?" + urllib.parse.urlencode({"token": token})
        ok, message = send_password_reset_email(user["email"], reset_url)
        if not ok:
            print(f"password reset email failed for user_id={user['id']}: {message}")
            return self.render(
                "找回密码",
                "<div class='notice danger'>邮件服务暂时不可用，请稍后重试或联系管理员。</div>" + forgot_password_page(),
                200,
            )
        return self.render("找回密码", generic_notice + forgot_password_page())

    def get_reset_password(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        token = qs.get("token", [""])[0]
        con = get_db()
        row = find_valid_password_reset_token(con, token)
        con.close()
        if not row:
            return self.render("重置密码", "<div class='notice danger'>重置链接无效或已过期，请重新申请。</div>" + forgot_password_page(), 400)
        return self.render("重置密码", reset_password_page(token, row["email"]))

    def post_reset_password(self):
        form = parse_form(self.get_body())
        token = form.get("token", "")
        password = form.get("password", "")
        password_confirm = form.get("password_confirm", "")
        if len(password) < 8 or password != password_confirm:
            return self.render("重置密码", "<div class='notice danger'>两次输入的密码不一致，且密码至少 8 位。</div>" + reset_password_page(token), 400)
        if not reset_password_with_token(token, password):
            return self.render("重置密码", "<div class='notice danger'>重置链接无效或已过期，请重新申请。</div>" + forgot_password_page(), 400)
        return self.render("重置完成", "<div class='notice'>密码已重置，请使用新密码登录。</div>" + login_page())

    def post_payment_wechat_notify(self):
        self.get_body()
        data = b'{"code":"SUCCESS","message":"accepted"}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def post_payment_alipay_notify(self):
        params = parse_form(self.get_body())
        response_text = "failure"
        order_to_provision = None
        con = get_db()
        try:
            setting = get_payment_setting(con, "alipay")
            config = decode_json(setting["config_json"])
            provider_order_no = params.get("out_trade_no", "")
            tx = con.execute(
                """
                select t.*, o.status order_status, o.amount_cents order_amount_cents
                from payment_transactions t join orders o on o.id=t.order_id
                where t.provider='alipay' and t.provider_order_no=?
                """,
                (provider_order_no,),
            ).fetchone()
            valid_signature = payment_setting_ready(setting) and alipay_verify_params(params, config.get("alipay_public_key", ""))
            if tx and valid_signature:
                trade_status = params.get("trade_status", "")
                response_json = json.dumps(params, ensure_ascii=False)
                if trade_status in ("TRADE_SUCCESS", "TRADE_FINISHED"):
                    paid_amount_cents = alipay_amount_to_cents(params.get("total_amount", ""))
                    if paid_amount_cents == int(tx["amount_cents"]) == int(tx["order_amount_cents"]):
                        paid_at = now_ms()
                        con.execute(
                            """
                            update payment_transactions
                            set status='paid', response_json=?, updated_at=?
                            where id=?
                            """,
                            (response_json, paid_at, tx["id"]),
                        )
                        con.execute(
                            """
                            update orders
                            set status='paid', payment_method='alipay', payment_ref=?, paid_at=coalesce(paid_at,?), updated_at=?
                            where id=? and status in ('pending_payment','provision_failed')
                            """,
                            (provider_order_no, paid_at, paid_at, tx["order_id"]),
                        )
                        order_to_provision = tx["order_id"]
                        response_text = "success"
                else:
                    con.execute(
                        "update payment_transactions set status=?, response_json=?, updated_at=? where id=?",
                        (trade_status or "notified", response_json, now_ms(), tx["id"]),
                    )
                    response_text = "success"
                con.commit()
        finally:
            con.close()
        if order_to_provision:
            provision_order(order_to_provision)
        data = response_text.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def get_payment_alipay_return(self):
        return self.redirect(PUBLIC_SUB_BASE.rstrip("/") + "/dashboard#orders")

    def set_session(self, uid, location="/dashboard"):
        self.send_response(303)
        self.send_header("Location", location)
        self.send_header("Set-Cookie", f"sid={sign(str(uid))}; HttpOnly; SameSite=Lax; Path=/")
        self.end_headers()

    def get_logout(self):
        self.send_response(303)
        self.send_header("Location", "/plans")
        self.send_header("Set-Cookie", "sid=; Max-Age=0; Path=/")
        self.end_headers()

    @require_user
    def get_dashboard(self):
        con = get_db()
        orders = con.execute(
            f"""
            select o.*, {ORDER_PRODUCT_SELECT}
            from orders o join products p on p.id=o.product_id
            where o.user_id=? and o.status!='created' order by o.id desc
            """,
            (self.user["id"],),
        ).fetchall()
        subs = con.execute(
            """
            select s.*, coalesce(o.order_product_name,p.name) product_name
            from subscriptions s
            join orders o on o.id=s.order_id
            left join products p on p.id=s.product_id
            where s.user_id=? and coalesce(s.revoked_at,0)=0 order by s.id desc
            """,
            (self.user["id"],),
        ).fetchall()
        invite_code = ensure_user_invite_code(con, self.user["id"])
        con.commit()
        con.close()
        latest_sub = select_dashboard_subscription(subs)
        sub_card = subscription_card(latest_sub) if latest_sub else empty_subscription_card()
        invite_url = PUBLIC_SUB_BASE.rstrip("/") + "/register?invite=" + urllib.parse.quote(invite_code)
        mobile_shortcuts = mobile_dashboard_shortcuts(latest_sub, invite_url)
        content = f"""
        <section class="dashboard-head user-dashboard-head mobile-hidden">
          <div>
            <h1>总览</h1>
            <p class="muted">余额 {money(self.user['wallet_balance_cents'] or 0)}</p>
          </div>
          <div class="actions"><a class="button" href="/plans">套餐</a><a class="button secondary" href="/profile">账户</a></div>
        </section>
        <section class="mobile-dashboard-head mobile-only">
          <h1>总览</h1>
        </section>
        <section id="subscription" class="n-card subscription-panel">
          <div class="n-card-header"><h2>订阅</h2></div>
          <div class="n-card-content">{sub_card}</div>
        </section>
        {mobile_shortcuts}
        """
        return self.render("用户中心", content)

    @require_user
    def get_profile(self):
        email = html.escape(self.user["email"])
        con = get_db()
        orders = con.execute(
            f"""
            select o.*, {ORDER_PRODUCT_SELECT}
            from orders o join products p on p.id=o.product_id
            where o.user_id=? and o.status!='created' order by o.id desc limit 20
            """,
            (self.user["id"],),
        ).fetchall()
        con.close()
        paid_user = any(o["status"] in ("paid", "provisioning", "provisioned") for o in orders)
        role = profile_identity(self.user, paid_user)
        mobile_orders = mobile_order_list(orders)
        content = f"""
        <section class="page-title compact-page-title">
          <div>
            <h1>个人中心</h1>
            <p class="muted">查看账户资料和安全入口。站点不会在页面中明文展示密码、节点 UUID 或订阅密钥。</p>
          </div>
