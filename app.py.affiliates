    """


def mobile_dashboard_shortcuts(s, invite_url):
    sub_url = s["clash_url"] if s else ""
    config_url = "clash://install-config?" + urllib.parse.urlencode({"url": sub_url}) if sub_url else ""
    invite_text = "\n".join([
        "邀请有奖励",
        "好友通过你的链接注册并开通后，奖励会自动进入余额。",
        invite_url,
    ])
    config_action = (
        f"<a class='button mobile-config-link' data-config-link href='{html.escape(config_url, quote=True)}'>一键配置</a>"
        if config_url
        else "<button class='button mobile-config-link' type='button' disabled>一键配置</button>"
    )
    return f"""
    <section id="invite" class="n-card mobile-shortcuts">
      <div class="n-card-header"><h2>捷径</h2></div>
      <div class="n-card-content">
        <div class="mobile-shortcut-block">
          <div>
            <b>一键配置</b>
            <p>自动唤起已安装客户端并导入订阅。</p>
          </div>
          {config_action}
          <div class="mobile-config-fallback" data-config-fallback>
            <p class="muted mobile-install-note">未唤起客户端时，先安装 Clash / Mihomo / Shadowrocket，再复制订阅链接导入。</p>
            {copy_button("复制订阅", sub_url, "secondary", aria_label="复制 Clash 订阅")}
          </div>
        </div>
        <div class="mobile-shortcut-block invite-reward">
          <div>
            <b>邀请有奖励</b>
            <p>好友通过你的链接注册并开通后，奖励自动进入余额。</p>
          </div>
          {copy_button("复制邀请链接", invite_url, "secondary")}
          {share_panel("mobile-invite", "邀请好友", invite_url, invite_text, "invite")}
        </div>
      </div>
    </section>
    """


def order_status_label(status):
    return {
        "pending_payment": "待支付",
        "paid": "已支付",
        "provisioning": "开通中",
        "provisioned": "已开通",
        "provision_failed": "开通失败",
        "cancelled": "已取消",
        "refunded": "已退款",
    }.get(status, status)


def mobile_order_list(orders):
    visible_orders = [o for o in orders if o["status"] not in ("created", "cancelled")]
    if not visible_orders:
        return "<div class='empty-card'><b>暂无订单</b><p>购买套餐后会在这里显示订单状态。</p></div>"

    def item_html(o):
        status = order_status_label(o["status"])
        action = ""
        if o["status"] == "pending_payment":
            dialog_id = f"cancel-order-{o['id']}"
            action = f"""
            <div class="mobile-order-actions">
              <button class="mobile-order-action mobile-order-cancel" type="button" onclick="document.getElementById('{dialog_id}').showModal()">取消</button>
              <a class="mobile-order-action mobile-order-pay" href="/checkout?id={o['id']}">去支付</a>
            </div>
            <dialog class="mobile-cancel-dialog" id="{dialog_id}">
              <form method="post" action="/orders/{o['id']}/cancel">
                <b>确认取消订单？</b>
                <p>取消后这笔待支付订单不会继续开通。</p>
                <div class="mobile-dialog-actions">
                  <button class="mobile-order-action mobile-order-cancel" type="button" onclick="document.getElementById('{dialog_id}').close()">不取消</button>
                  <button class="mobile-order-action mobile-order-pay" type="submit">确定取消</button>
                </div>
              </form>
            </dialog>
            """
        return (
            "<article class='mobile-order-item'>"
            f"<div><b>{html.escape(o['product_name'])}</b><span>{html.escape(o['order_no'])}</span></div>"
            f"<div><b>{money(o['amount_cents'])}</b><span>{html.escape(status)}</span></div>"
            f"{action}"
            "</article>"
        )

    latest_order = item_html(visible_orders[0])
    history_orders = visible_orders[1:]
    if not history_orders:
        return latest_order
    history_count = len(history_orders)
    history_rows = "".join(item_html(o) for o in history_orders)
    return f"""
    {latest_order}
    <details class="mobile-order-history">
      <summary>
        <span class="mobile-order-history-open">收起历史账单</span>
        <span class="mobile-order-history-closed">展开历史账单（{history_count}）</span>
      </summary>
      <div class="mobile-order-history-list">{history_rows}</div>
    </details>
    """


def empty_subscription_card():
    return """
    <div class="empty-state">
      <h3>暂无已开通订阅</h3>
      <p>购买套餐并完成开通后，这里会显示订阅状态、到期时间和复制入口。</p>
      <a class="button" href="/plans">购买订阅</a>
    </div>
    """


def subscription_card(s):
    node_url = build_node_url(s)
    product_name = html.escape(row_value(s, "product_name", "") or "通用订阅")
    traffic = subscription_traffic_label(s)
    upload, download = subscription_usage_bytes(s)
    used = used_gb_label((upload + download) / 1024**3)
    used_value = used.replace(" GB", "")
    total_capacity = traffic_capacity_label(row_value(s, "traffic_bytes", 0) / 1024**3)
    device_used = subscription_device_usage_count(s)
    device_limit = parse_positive_int(row_value(s, "device_limit", 1))
    expires = expiry_label(s["expires_at"])
    mobile_expiry_date, mobile_expiry_time = expiry_datetime_parts(s["expires_at"])
    desktop_expiry_text = "不限期" if not s["expires_at"] else f"于 {expires} 到期。"
    mobile_expiry_time_html = f"<span>{mobile_expiry_time}</span>" if mobile_expiry_time else ""
    return f"""
    <article class="sub-card">
      <div class="sub-main">
        <span class="mobile-sub-status">开通</span>
        <h3><span class="desktop-sub-title">{product_name}</span><span class="mobile-sub-title">{product_name}</span></h3>
        <p class="desktop-sub-copy">{desktop_expiry_text}</p>
        <div class="desktop-sub-stats">
          <span class="desktop-sub-stat traffic">{used_value}/{total_capacity}</span>
          <span class="desktop-sub-stat devices">{device_used}/{device_limit}</span>
          <span class="desktop-sub-stat expiry">{expires}</span>
        </div>
        <div class="mobile-sub-stats">
          <span class="mobile-sub-stat traffic">{used_value}/{total_capacity}</span>
          <span class="mobile-sub-stat devices">{device_used}/{device_limit}</span>
          <span class="mobile-sub-stat expiry"><span>{mobile_expiry_date}</span>{mobile_expiry_time_html}</span>
        </div>
        <div class="usage-line"><span style="width: 0%"></span></div>
        <p class="traffic-note desktop-sub-copy">总计 {traffic} · 开通状态：{html.escape(s['xui_status'])}</p>
      </div>
      <div class="sub-actions">
        {copy_button("Shadowrocket 节点", node_url, aria_label="复制 Shadowrocket 节点")}
        {copy_button("Clash 订阅", s['clash_url'], "secondary", aria_label="复制 Clash 订阅")}
      </div>
    </article>
    """


if __name__ == "__main__":
    init_db()
    print(f"Subscription shop running at http://{HOST}:{PORT}")
    print(f"XUI_MODE={XUI_MODE}")
    ThreadingHTTPServer((HOST, PORT), App).serve_forever()
