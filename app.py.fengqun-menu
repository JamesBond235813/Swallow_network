    @require_admin
    def post_admin_order_action(self, path):
        parts = path.strip("/").split("/")
        order_id = int(parts[2])
        action = parts[3]
        con = get_db()
        if action == "mark-paid":
            con.execute("update orders set status='paid',payment_ref=?,paid_at=?,updated_at=? where id=? and status='pending_payment'", ("manual-" + secrets.token_hex(5), now_ms(), now_ms(), order_id))
            con.commit()
        con.close()
        if action in ("mark-paid", "provision"):
            provision_order(order_id)
        return self.redirect("/admin/orders")


def provision_order(order_id):
    con = get_db()
    order = con.execute(
        """
        select o.*, u.email user_email, p.name product_name, p.duration_days, p.traffic_gb
        from orders o join users u on u.id=o.user_id join products p on p.id=o.product_id
        where o.id=?
        """,
        (order_id,),
    ).fetchone()
    if not order or order["status"] not in ("paid", "provision_failed"):
        con.close()
        return
    existing = con.execute("select id from subscriptions where order_id=?", (order_id,)).fetchone()
    if existing:
        con.execute("update orders set status='provisioned',provisioned_at=coalesce(provisioned_at,?),updated_at=? where id=?", (now_ms(), now_ms(), order_id))
        con.commit()
        con.close()
        return
    client_uuid = str(uuid.uuid4())
    sub_id = "u" + secrets.token_urlsafe(8).replace("-", "").replace("_", "")
    label = "user-" + str(order["user_id"]) + "-" + sub_id
    traffic_bytes = int(order["traffic_gb"]) * 1024**3
    expires_at = now_ms() + int(order["duration_days"]) * 86400 * 1000
    result = provision_xui(label, sub_id, client_uuid, traffic_bytes, expires_at)
    clash_url = f"{PUBLIC_SUB_BASE}/clashx/{sub_id}"
    universal_url = f"{PUBLIC_SUB_BASE}/sub/{sub_id}"
    if result["ok"]:
        con.execute(
            """
            insert into subscriptions(user_id,order_id,product_id,email_label,sub_id,uuid,traffic_bytes,expires_at,clash_url,universal_url,xui_status,xui_message,created_at)
            values(?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (order["user_id"], order_id, order["product_id"], label, sub_id, client_uuid, traffic_bytes, expires_at, clash_url, universal_url, result["mode"], result["message"], now_ms()),
        )
        con.execute("update orders set status='provisioned',provisioned_at=?,updated_at=? where id=?", (now_ms(), now_ms(), order_id))
    else:
        con.execute("update orders set status='provision_failed',updated_at=? where id=?", (now_ms(), order_id))
    con.commit()
    con.close()


def form_page(title, action, include_name=False, button="提交"):
    helper = "请使用已创建的账户登录。管理员初始账号由服务器环境变量配置。"
    return f"""
    <section class="panel narrow">
      <h1>{title}</h1>
      <form method="post" action="{action}" class="form">
        <label>账号/邮箱<input name="email" required></label>
        <label>密码<input name="password" type="password" minlength="8" required></label>
        <button type="submit">{button}</button>
      </form>
      <p class="muted">{helper}</p>
    </section>
    """


def login_page():
    return """
    <section class="panel narrow">
      <h1>登录</h1>
      <form method="post" action="/login" class="form">
        <label>账号/邮箱<input name="email" required></label>
        <label>密码<input name="password" type="password" minlength="8" required></label>
        <button type="submit">登录</button>
      </form>
      <p class="muted">忘记密码？<a href="/forgot-password">通过邮箱找回</a></p>
    </section>
    """


