def reset_password_page(token, email=""):
    account = f"<p class='muted'>正在重置：{html.escape(email)}</p>" if email else ""
    return f"""
    <section class="panel narrow">
      <h1>重置密码</h1>
      {account}
      <form method="post" action="/reset-password" class="form">
        <input type="hidden" name="token" value="{html.escape(token)}">
        <label>新密码<input name="password" type="password" minlength="8" required></label>
        <label>确认新密码<input name="password_confirm" type="password" minlength="8" required></label>
        <button type="submit">保存新密码</button>
      </form>
    </section>
    """


def mask_saved(value):
    return "已保存，留空则不修改" if value else "未填写"


def input_text(name, label, value="", input_type="text", placeholder=""):
    return f"""<label>{label}<input name="{name}" type="{input_type}" value="{html.escape(str(value or ''))}" placeholder="{html.escape(placeholder)}"></label>"""


def textarea_field(name, label, value="", secret=False):
    if secret:
        return f"""<label>{label}<textarea name="{name}" rows="5" placeholder="{html.escape(mask_saved(value))}"></textarea></label>"""
    return f"""<label>{label}<textarea name="{name}" rows="5">{html.escape(str(value or ''))}</textarea></label>"""


def payment_config_panel(provider, row):
    config = decode_json(row["config_json"])
    enabled = "checked" if row["enabled"] else ""
    ready = payment_setting_ready(row)
    badge_text = "已启用" if ready else ("资料不完整" if row["enabled"] else "未启用")
    badge_class = "badge ok" if ready else "badge"
    if provider == "wechat":
        title = "微信支付"
        callback_url = PUBLIC_SUB_BASE.rstrip("/") + "/payment/wechat/notify"
        fields = f"""
          {input_text('appid', '公众号/小程序/AppID', config.get('appid', ''))}
          {input_text('mch_id', '商户号 mch_id', config.get('mch_id', ''))}
          {input_text('merchant_serial_no', '商户证书序列号', config.get('merchant_serial_no', ''))}
          {input_text('notify_url', '支付回调地址', config.get('notify_url') or callback_url)}
          {input_text('api_v3_key', 'API v3 密钥', '', 'password', mask_saved(config.get('api_v3_key')))}
          {textarea_field('private_key_pem', '商户 API 私钥 PEM', config.get('private_key_pem'), secret=True)}
          {textarea_field('platform_cert_pem', '微信支付平台证书 PEM', config.get('platform_cert_pem'), secret=True)}
        """
    else:
        title = "支付宝"
        notify_url = PUBLIC_SUB_BASE.rstrip("/") + "/payment/alipay/notify"
        return_url = PUBLIC_SUB_BASE.rstrip("/") + "/dashboard"
        fields = f"""
          {input_text('app_id', '应用 AppID', config.get('app_id', ''))}
          {input_text('gateway_url', '网关地址', config.get('gateway_url') or 'https://openapi.alipay.com/gateway.do')}
          {input_text('notify_url', '异步通知地址', config.get('notify_url') or notify_url)}
          {input_text('return_url', '同步返回地址', config.get('return_url') or return_url)}
          {input_text('sign_type', '签名类型', config.get('sign_type') or 'RSA2')}
          {textarea_field('merchant_private_key', '应用私钥', config.get('merchant_private_key'), secret=True)}
          {textarea_field('alipay_public_key', '支付宝公钥', config.get('alipay_public_key'), secret=True)}
        """
    return f"""
    <section class="panel payment-panel">
      <div class="panel-title">
        <h2>{title}</h2>
        <span class="{badge_class}">{badge_text}</span>
      </div>
      <form method="post" action="/admin/payments" class="form">
        <input type="hidden" name="provider" value="{provider}">
        <label class="check"><input name="enabled" type="checkbox" {enabled}> 启用{title}</label>
        <div class="settings-grid">{fields}</div>
        <button type="submit">保存{title}配置</button>
      </form>
    </section>
    """


def payment_method_choices(enabled_methods):
    options = []
    labels = {"wechat": "微信支付", "alipay": "支付宝"}
    for provider in enabled_methods:
        options.append(
            f"""
            <label class="pay-option">
              <input type="radio" name="payment_method" value="{provider}" required>
              <span><b>{labels[provider]}</b><small>创建支付订单，付款后等待后台确认开通</small></span>
            </label>
            """
        )
    options.append(
        """
        <label class="pay-option">
          <input type="radio" name="payment_method" value="manual" required>
          <span><b>人工确认</b><small>用于测试或人工收款，提交后按现有流程自动开通</small></span>
        </label>
        """
    )
    return "<div class='pay-options'>" + "".join(options) + "</div>"


def payment_pending_page(order, provider, tx):
    label = "微信支付" if provider == "wechat" else "支付宝"
    return f"""
    <section class="panel narrow">
      <h1>{label}</h1>
      <dl class="kv">
        <dt>订单号</dt><dd>{html.escape(order['order_no'])}</dd>
        <dt>支付单号</dt><dd>{html.escape(tx['provider_order_no'])}</dd>
        <dt>套餐</dt><dd>{html.escape(order['product_name'])}</dd>
        <dt>金额</dt><dd>{money(order['amount_cents'])}</dd>
        <dt>状态</dt><dd>支付意向已创建，等待收款确认</dd>
      </dl>
      <div class="payment-placeholder">{label}<br><span>真实二维码/收银台将在接入支付 API 后显示</span></div>
      <p class="muted">当前系统已记录支付意向。收到款项后，管理员可在订单管理中点击“确认收款并开通”。</p>
      <div class="actions"><a class="button" href="/dashboard">返回用户中心</a></div>
    </section>
    """


def product_form(action, p=None):
    p = dict(p) if p is not None else {}
    checked = "checked" if p.get("active", 1) else ""
    price_yuan = (p.get("price_cents", 0) or 0) / 100
    return f"""
    <form method="post" action="{action}" class="form grid-form">
      <label>名称<input name="name" value="{html.escape(str(p.get('name','')))}" required></label>
      <label>周期
        <select name="billing_period">
          {option('monthly','月付',p.get('billing_period'))}
          {option('quarterly','季度',p.get('billing_period'))}
          {option('yearly','包年',p.get('billing_period'))}
        </select>
      </label>
      <label>有效天数<input name="duration_days" type="number" min="1" value="{p.get('duration_days',30)}" required></label>
      <label>流量 GB<input name="traffic_gb" type="number" min="1" value="{p.get('traffic_gb',100)}" required></label>
      <label>价格 元<input name="price_yuan" type="number" min="0" step="0.01" value="{price_yuan:.2f}" required></label>
      <label>排序<input name="sort_order" type="number" value="{p.get('sort_order',100)}"></label>
      <label class="check"><input name="active" type="checkbox" {checked}> 上架</label>
      <button type="submit">保存</button>
    </form>
    """


def option(value, label, selected):
    return f"<option value='{value}' {'selected' if selected == value else ''}>{label}</option>"


def product_row(p):
    status = "上架" if p["active"] else "下架"
    return f"<tr><td>{html.escape(p['name'])}</td><td>{duration_label(p['duration_days'])}</td><td>{gb_label(p['traffic_gb'])}</td><td>{money(p['price_cents'])}</td><td>{status}</td><td><a href='/admin/products/{p['id']}/edit'>编辑</a></td></tr>"


def order_row(o, admin=False, customer=False):
    if admin:
        actions = []
        if o["status"] == "pending_payment":
            actions.append(f"<form method='post' action='/admin/orders/{o['id']}/mark-paid'><button>确认收款并开通</button></form>")
        if o["status"] == "provision_failed":
            actions.append(f"<form method='post' action='/admin/orders/{o['id']}/provision'><button>重试开通</button></form>")
        action = "".join(actions) or "-"
        return f"<tr><td>{html.escape(o['order_no'])}</td><td>{html.escape(o['user_email'])}</td><td>{html.escape(o['product_name'])}</td><td>{money(o['amount_cents'])}</td><td><span class='badge'>{o['status']}</span></td><td>{action}</td></tr>"
    action = f"<a href='/checkout?id={o['id']}'>去支付</a>" if o["status"] == "pending_payment" else "-"
    return f"<tr><td>{html.escape(o['order_no'])}</td><td>{html.escape(o['product_name'])}</td><td>{money(o['amount_cents'])}</td><td><span class='badge'>{o['status']}</span></td><td>{action}</td></tr>"


def build_node_url(s):
    query = {
        "type": "tcp",
        "security": "reality",
        "encryption": "none",
        "flow": "xtls-rprx-vision",
        "fp": "chrome",
        "pbk": NODE_REALITY_PUBLIC_KEY,
        "sni": NODE_REALITY_SNI,
        "sid": NODE_REALITY_SHORT_ID,
        "spx": "/",
    }
    remark = f"{NODE_REMARK_PREFIX}-{s['sub_id']}"
    return (
        f"vless://{urllib.parse.quote(str(s['uuid']), safe='')}@{NODE_PUBLIC_HOST}:{NODE_DIRECT_PORT}"
        f"?{urllib.parse.urlencode(query)}#{urllib.parse.quote(remark)}"
    )


def copy_button(label, value, extra_class=""):
    if not value:
        return f"<button class='copy-action {extra_class}' type='button' disabled>{label}</button>"
    return f"<button class='copy-action {extra_class}' type='button' data-copy-value='{html.escape(value, quote=True)}'>{label}</button>"


def shortcut_panel(s):
    node_url = build_node_url(s) if s else ""
    sub_url = s["clash_url"] if s else ""
    return f"""
    <section id="guide" class="n-card shortcut-card">
      <div class="n-card-header"><h2>捷径</h2></div>
      <div class="n-card-content shortcut-list">
        <div class="shortcut-row">
          <div><b>一键拷贝节点</b><p>复制单节点链接，适合 Clash 类客户端手动添加。</p></div>
          {copy_button("复制", node_url)}
        </div>
        <div class="shortcut-row">
          <div><b>一键拷贝订阅</b><p>复制 Clash / Mihomo 订阅地址，推荐通过 URL 导入。</p></div>
          {copy_button("复制", sub_url)}
        </div>
        <a class="shortcut-row" href="/plans">
          <div><b>续费订阅</b><p>对当前节点服务购买或续期。</p></div>
          <span class="row-arrow">></span>
        </a>
        <a class="shortcut-row" href="/forgot-password">
          <div><b>账户安全</b><p>忘记密码时通过邮箱重置。</p></div>
          <span class="row-arrow">></span>
        </a>
      </div>
    </section>
    """


def empty_subscription_card():
    return """
    <div class="empty-state">
      <h3>暂无已开通订阅</h3>
      <p>购买套餐并完成开通后，这里会显示订阅状态、到期时间和复制入口。</p>
      <a class="button" href="/plans">购买订阅</a>
    </div>
    """


def subscription_card(s):
    node_url = build_node_url(s)
    return f"""
    <article class="sub-card">
      <div class="sub-main">
        <h3>通用订阅</h3>
        <p>于 {ms_to_date(s['expires_at'])} 到期。</p>
        <div class="usage-line"><span style="width: 0%"></span></div>
        <p class="traffic-note">总计 {gb_label(s['traffic_bytes'] / 1024**3)} · 开通状态：{html.escape(s['xui_status'])}</p>
      </div>
      <div class="sub-actions">
        {copy_button("复制节点", node_url)}
        {copy_button("复制订阅", s['clash_url'], "secondary")}
      </div>
    </article>
    """


if __name__ == "__main__":
    init_db()
    print(f"Subscription shop running at http://{HOST}:{PORT}")
    print(f"XUI_MODE={XUI_MODE}")
    ThreadingHTTPServer((HOST, PORT), App).serve_forever()
