    @require_user
    def post_orders(self):
        form = parse_form(self.get_body())
        product_id = int(form.get("product_id", "0") or 0)
        con = get_db()
        product = con.execute("select * from products where id=? and active=1", (product_id,)).fetchone()
        if not product:
            con.close()
            return self.render("下单失败", "<div class='notice danger'>套餐不存在或已下架。</div>", 400)
        order_no = "O" + time.strftime("%Y%m%d") + secrets.token_hex(4).upper()
        con.execute(
            "insert into orders(order_no,user_id,product_id,amount_cents,status,payment_method,created_at,updated_at) values(?,?,?,?,?,?,?,?)",
            (order_no, self.user["id"], product_id, product["price_cents"], "pending_payment", "manual", now_ms(), now_ms()),
        )
        con.commit()
        order_id = con.execute("select last_insert_rowid()").fetchone()[0]
        con.close()
        return self.redirect(f"/checkout?id={order_id}")

    @require_user
    def get_checkout(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        order_id = int(qs.get("id", ["0"])[0])
        con = get_db()
        order = con.execute(
            """
            select o.*, p.name product_name, p.traffic_gb, p.duration_days
            from orders o join products p on p.id=o.product_id
            where o.id=? and o.user_id=?
            """,
            (order_id, self.user["id"]),
        ).fetchone()
        if not order:
            con.close()
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        settings = get_all_payment_settings(con)
        enabled_methods = [p for p, row in settings.items() if payment_setting_ready(row)]
        con.close()
        content = f"""
        <section class="panel narrow">
          <h1>确认订单</h1>
          <dl class="kv">
            <dt>订单号</dt><dd>{html.escape(order['order_no'])}</dd>
            <dt>套餐</dt><dd>{html.escape(order['product_name'])} · {gb_label(order['traffic_gb'])} · {order['duration_days']} 天</dd>
            <dt>金额</dt><dd>{money(order['amount_cents'])}</dd>
            <dt>支付</dt><dd>请选择支付方式。自动回调接通前，付款完成后仍由后台确认收款并开通。</dd>
          </dl>
          <form method="post" action="/orders/{order['id']}/pay" class="form">
            {payment_method_choices(enabled_methods)}
            <button type="submit">继续支付</button>
          </form>
        </section>
        """
        return self.render("确认订单", content)

    @require_user
    def post_order_pay(self, path):
        order_id = int(path.split("/")[2])
        form = parse_form(self.get_body())
        payment_method = form.get("payment_method", "manual")
        con = get_db()
        order = con.execute(
            """
            select o.*, p.name product_name
            from orders o join products p on p.id=o.product_id
            where o.id=? and o.user_id=?
            """,
            (order_id, self.user["id"]),
        ).fetchone()
        if not order:
            con.close()
            return self.render("订单不存在", "<div class='notice danger'>订单不存在。</div>", 404)
        if payment_method in PAYMENT_CONFIG_FIELDS:
            setting = get_payment_setting(con, payment_method)
            if not payment_setting_ready(setting):
                con.close()
                return self.render("支付不可用", "<div class='notice danger'>该支付方式尚未配置完整，请选择其他支付方式。</div>", 400)
            tx = create_payment_transaction(con, order_id, payment_method, order["amount_cents"])
            con.close()
            return self.render("支付订单", payment_pending_page(order, payment_method, tx))
        if payment_method == "manual" and order["status"] == "pending_payment":
            con.execute(
                "update orders set status='paid',payment_ref=?,paid_at=?,updated_at=? where id=?",
                ("mock-" + secrets.token_hex(6), now_ms(), now_ms(), order_id),
            )
            con.commit()
            con.close()
            provision_order(order_id)
            return self.redirect("/dashboard")
        con.close()
        return self.redirect("/dashboard")

    @require_admin
    def get_admin(self):
        con = get_db()
        stats = {
            "products": con.execute("select count(*) from products").fetchone()[0],
            "orders": con.execute("select count(*) from orders").fetchone()[0],
            "subs": con.execute("select count(*) from subscriptions").fetchone()[0],
            "users": con.execute("select count(*) from users").fetchone()[0],
        }
        orders = con.execute(
            """
            select o.*, u.email user_email, p.name product_name
            from orders o join users u on u.id=o.user_id join products p on p.id=o.product_id
            order by o.id desc limit 8
            """
        ).fetchall()
        con.close()
        cards = "".join(f"<div class='metric'><b>{v}</b><span>{k}</span></div>" for k, v in stats.items())
        rows = "".join(order_row(o, admin=True) for o in orders) or "<tr><td colspan='6'>暂无订单</td></tr>"
        content = f"""
        <section class="hero compact"><h1>管理后台</h1><p>上货、改价、处理订单和订阅开通。</p></section>
        <section class="metrics">{cards}</section>
        <div class="actions"><a class="button" href="/admin/products">商品管理</a><a class="button secondary" href="/admin/orders">订单管理</a><a class="button secondary" href="/admin/payments">支付配置</a></div>
        <h2>最近订单</h2><table><thead><tr><th>订单</th><th>用户</th><th>商品</th><th>金额</th><th>状态</th><th>操作</th></tr></thead><tbody>{rows}</tbody></table>
        """
        return self.render("管理后台", content)

