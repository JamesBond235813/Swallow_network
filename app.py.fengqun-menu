          <p>{intro}</p>
          <p style="background:#f2f4f7;border-left:4px solid #667085;padding:10px 12px;color:#344054">{security_note}</p>
          <p><a href="{html.escape(reset_url)}" style="display:inline-block;padding:10px 16px;background:#1f2937;color:#fff;text-decoration:none;border-radius:6px">设置新密码</a></p>
          <p>如果按钮无法打开，请复制下面的链接到浏览器地址栏：</p>
          <p style="word-break:break-all;color:#475467">{html.escape(reset_url)}</p>
          <hr style="border:0;border-top:1px solid #eaecf0;margin:20px 0">
          <p style="color:#667085;font-size:13px">如果不是你本人操作，可以忽略这封邮件。请不要把这封邮件或重置链接转发给他人。</p>
          <p style="color:#667085;font-size:13px">发件域名：node1.talking202606.dpdns.org</p>
        </div>
        """,
        "text": (
            f"Node1 Support - 账号安全邮件\n\n"
            f"{text_intro}\n{reset_url}\n\n"
            f"{text_security_note}\n\n"
            "如果不是你本人操作，可以忽略这封邮件。请不要把这封邮件或重置链接转发给他人。\n"
            "发件域名：node1.talking202606.dpdns.org"
        ),
    }
    req = urllib.request.Request(
        "https://api.resend.com/emails",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {RESEND_API_KEY}",
            "Content-Type": "application/json",
            "User-Agent": "subscription-shop/1.0 (+https://node1.talking202606.dpdns.org)",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            if 200 <= resp.status < 300:
                return True, body
            return False, body
    except urllib.error.HTTPError as exc:
        return False, exc.read().decode("utf-8", errors="replace")
    except urllib.error.URLError as exc:
        return False, str(exc.reason)


def current_user(handler):
    jar = cookies.SimpleCookie(handler.headers.get("Cookie"))
    morsel = jar.get("sid")
    uid = unsign(morsel.value) if morsel else None
    if not uid:
        return None
    con = get_db()
    user = con.execute("select * from users where id=?", (uid,)).fetchone()
    con.close()
    return user


def require_user(fn):
    @functools.wraps(fn)
    def wrapper(self, *args, **kwargs):
        user = current_user(self)
        if not user:
            return self.redirect("/login")
        self.user = user
        return fn(self, *args, **kwargs)
    return wrapper


def require_admin(fn):
    @functools.wraps(fn)
    def wrapper(self, *args, **kwargs):
        user = current_user(self)
        if not user:
            return self.redirect("/login")
        if user["role"] != "admin":
            return self.render("无权限", "<div class='notice danger'>需要管理员权限。</div>", 403)
        self.user = user
        return fn(self, *args, **kwargs)
    return wrapper


def run_ssh(command, timeout=30):
    target = f"{XUI_SSH_USER}@{XUI_HOST}"
    cmd = [
        "ssh",
        "-i",
        XUI_SSH_KEY,
        "-o",
        "BatchMode=yes",
        "-o",
        "PasswordAuthentication=no",
        "-o",
        "StrictHostKeyChecking=no",
        target,
        command,
    ]
    return subprocess.run(cmd, text=True, capture_output=True, timeout=timeout)


def provision_xui(email_label, sub_id, client_uuid, traffic_bytes, expires_at_ms):
    if XUI_MODE == "mock":
        return {"ok": True, "mode": "mock", "message": "Mock provisioned. Set XUI_MODE=ssh or local for real 3X-UI provisioning."}

    script = f"""
import json, sqlite3, time
p={XUI_DB_PATH!r}
inbound_id={XUI_INBOUND_ID}
email={email_label!r}
sub_id={sub_id!r}
uuid={client_uuid!r}
traffic={int(traffic_bytes)}
expiry={int(expires_at_ms)}
now=int(time.time()*1000)
con=sqlite3.connect(p); con.row_factory=sqlite3.Row
inb=con.execute('select settings from inbounds where id=?', (inbound_id,)).fetchone()
if not inb:
    raise SystemExit('inbound not found')
settings=json.loads(inb['settings'])
clients=settings.setdefault('clients', [])
client={{
  'comment':'',
  'created_at':now,
  'updated_at':now,
  'email':email,
  'enable':True,
  'expiryTime':expiry,
  'flow':'xtls-rprx-vision',
  'id':uuid,
  'limitIp':0,
  'reset':0,
  'subId':sub_id,
  'tgId':0,
  'totalGB':traffic
}}
for i,c in enumerate(clients):
    if c.get('email') == email:
        clients[i]=client
        break
else:
    clients.append(client)
con.execute('update inbounds set settings=? where id=?', (json.dumps(settings, ensure_ascii=False, indent=2), inbound_id))
row=con.execute('select id from clients where email=?', (email,)).fetchone()
if row:
    con.execute('update clients set sub_id=?, uuid=?, flow=?, total_gb=?, expiry_time=?, enable=1, updated_at=? where email=?',
                (sub_id, uuid, 'xtls-rprx-vision', traffic, expiry, now, email))
    client_id=row['id']
else:
    con.execute('insert into clients(email,sub_id,uuid,flow,limit_ip,total_gb,expiry_time,enable,created_at,updated_at) values(?,?,?,?,?,?,?,?,?,?)',
                (email, sub_id, uuid, 'xtls-rprx-vision', 0, traffic, expiry, 1, now, now))
    client_id=con.execute('select last_insert_rowid()').fetchone()[0]
con.execute('insert or ignore into client_inbounds(client_id,inbound_id,flow_override,created_at) values(?,?,?,?)',
            (client_id, inbound_id, 'xtls-rprx-vision', now))
ct=con.execute('select id from client_traffics where inbound_id=? and email=?', (inbound_id, email)).fetchone()
if ct:
    con.execute('update client_traffics set enable=1,total=?,expiry_time=? where inbound_id=? and email=?',
                (traffic, expiry, inbound_id, email))
else:
    con.execute('insert into client_traffics(inbound_id,enable,email,up,down,expiry_time,total,reset,last_online) values(?,?,?,?,?,?,?,?,?)',
                (inbound_id, 1, email, 0, 0, expiry, traffic, 0, 0))
con.commit()
print('OK')
"""
    if XUI_MODE == "local":
        result = subprocess.run(["python3", "-c", script], text=True, capture_output=True, timeout=30)
        if result.returncode == 0:
            subprocess.run(["systemctl", "restart", "x-ui"], text=True, capture_output=True, timeout=20)
            return {"ok": True, "mode": "local", "message": result.stdout.strip()}
        return {"ok": False, "mode": "local", "message": result.stderr.strip() or result.stdout.strip()}
    if XUI_MODE == "ssh":
        remote = "python3 - <<'PY'\n" + script + "\nPY\nsystemctl restart x-ui\n"
        result = run_ssh(remote, timeout=45)
        if result.returncode == 0:
            return {"ok": True, "mode": "ssh", "message": result.stdout.strip()}
        return {"ok": False, "mode": "ssh", "message": result.stderr.strip() or result.stdout.strip()}
    return {"ok": False, "mode": XUI_MODE, "message": "Unknown XUI_MODE"}


class App(BaseHTTPRequestHandler):
    routes = {}

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args))

    def send_html(self, status, body, headers=None):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, path):
        self.send_response(303)
        self.send_header("Location", path)
        self.end_headers()

    def get_body(self):
        length = int(self.headers.get("Content-Length", 0))
        return self.rfile.read(length) if length else b""

    def render(self, title, content, status=200):
        user = current_user(self)
        path = urllib.parse.urlparse(self.path).path
        active = {
            "dashboard": "active" if path in ("/", "/dashboard") else "",
            "docs": "active" if path == "/docs" else "",
            "plans": "active" if path.startswith("/plans") or path.startswith("/checkout") else "",
            "orders": "active" if path.startswith("/orders") else "",
            "invitations": "active" if path == "/invitations" else "",
            "nodes": "active" if path == "/nodes" else "",
            "tickets": "active" if path == "/tickets" else "",
            "traffic": "active" if path == "/traffic" else "",
            "profile": "active" if path in ("/profile", "/login", "/register", "/forgot-password", "/reset-password") else "",
            "admin": "active" if path.startswith("/admin") else "",
        }
        if user:
            admin = f"<a class='side-item {active['admin']}' href='/admin'><span class='side-icon icon-admin'></span><span>管理后台</span></a>" if user["role"] == "admin" else ""
            account = html.escape(user["email"])
            side = f"""
            <a class="side-brand" href="/dashboard"><span class="brand-mark">N</span><span>Node1</span></a>
            <nav class="side-menu" aria-label="主菜单">
              <a class="side-item {active['dashboard']}" href="/dashboard"><span class="side-icon icon-home"></span><span>仪表盘</span></a>
              <a class="side-item {active['docs']}" href="/docs"><span class="side-icon icon-doc"></span><span>使用文档</span></a>
              <p class="side-group">财务</p>
              <a class="side-item {active['orders']}" href="/dashboard#orders"><span class="side-icon icon-list"></span><span>我的订单</span></a>
              <a class="side-item {active['invitations']}" href="/invitations"><span class="side-icon icon-invite"></span><span>我的邀请</span></a>
              <p class="side-group">订阅</p>
              <a class="side-item {active['plans']}" href="/plans"><span class="side-icon icon-bag"></span><span>购买订阅</span></a>
              <a class="side-item {active['nodes']}" href="/nodes"><span class="side-icon icon-status"></span><span>节点状态</span></a>
              <p class="side-group">用户</p>
              <a class="side-item {active['profile']}" href="/profile"><span class="side-icon icon-user"></span><span>个人中心</span></a>
              <a class="side-item {active['tickets']}" href="/tickets"><span class="side-icon icon-ticket"></span><span>我的工单</span></a>
              <a class="side-item {active['traffic']}" href="/traffic"><span class="side-icon icon-traffic"></span><span>流量明细</span></a>
              {admin}
            </nav>
            """
        else:
            account = "未登录"
            side = f"""
            <a class="side-brand" href="/plans"><span class="brand-mark">N</span><span>Node1</span></a>
            <nav class="side-menu" aria-label="主菜单">
              <a class="side-item {active['docs']}" href="/docs"><span class="side-icon icon-doc"></span><span>使用文档</span></a>
              <a class="side-item {active['plans']}" href="/plans"><span class="side-icon icon-bag"></span><span>购买订阅</span></a>
              <a class="side-item {active['profile']}" href="/login"><span class="side-icon icon-user"></span><span>登录</span></a>
              <a class="side-item" href="/register"><span class="side-icon icon-doc"></span><span>注册</span></a>
            </nav>
            """
        crumb = html.escape(title)
        top_actions = "<a class='top-link' href='/logout'>退出</a>" if user else "<a class='top-link' href='/login'>登录</a>"
        page = f"""<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{html.escape(title)} · 订阅商城</title>
  <link rel="stylesheet" href="/static/style.css?v=fengqun-menu-20260625">
</head>
<body>
  <div class="app-layout">
    <aside class="sidebar">{side}</aside>
    <section class="workspace">
      <header class="topbar">
        <div class="breadcrumb"><span class="menu-mark"></span><span>首页</span><span>/</span><b>{crumb}</b></div>
        <div class="account-pill"><span class="avatar-dot"></span><span>{account}</span>{top_actions}</div>
      </header>
      <main class="shell">
        {content}
      </main>
    </section>
  </div>
  <script>
    document.addEventListener('click', async function (event) {{
      const button = event.target.closest('[data-copy-value]');
      if (!button || button.disabled) return;
      const value = button.getAttribute('data-copy-value') || '';
      if (!value) return;
      try {{
        await navigator.clipboard.writeText(value);
        const oldText = button.textContent;
        button.textContent = '已复制';
        window.setTimeout(function () {{ button.textContent = oldText; }}, 1400);
      }} catch (err) {{
        button.textContent = '复制失败';
      }}
    }});
  </script>
</body>
</html>"""
        self.send_html(status, page)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/static/style.css":
            return self.static_css()
        name = "get_index" if path == "/" else "get_" + path.strip("/").replace("/", "_").replace("-", "_")
        handler = getattr(self, name, None)
        if handler:
            return handler()
        if path.startswith("/admin/products/") and path.endswith("/edit"):
            return self.get_admin_product_edit(path)
        return self.render("未找到", "<div class='notice danger'>页面不存在。</div>", 404)

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        handler = getattr(self, "post_" + path.strip("/").replace("/", "_").replace("-", "_"), None)
        if handler:
            return handler()
        if path.startswith("/admin/products/") and path.endswith("/edit"):
            return self.post_admin_product_edit(path)
        if path.startswith("/admin/orders/"):
            return self.post_admin_order_action(path)
        if path.startswith("/orders/") and path.endswith("/pay"):
            return self.post_order_pay(path)
        return self.render("未找到", "<div class='notice danger'>操作不存在。</div>", 404)

    def static_css(self):
        with open(os.path.join(APP_DIR, "static", "style.css"), "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/css; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def get_index(self):
        if current_user(self):
            return self.get_dashboard()
        return self.get_plans()

    def get_docs(self):
        content = """
        <section class="page-title docs-title">
          <div>
            <h1>Node1 使用文档</h1>
            <p class="muted">面向普通用户和站点运营方的服务说明。本文不会展示任何真实订阅密钥、节点 UUID 或后台地址。</p>
          </div>
        </section>
        <section class="docs-grid">
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>给用户：这个服务是什么</h2></div>
            <div class="n-card-content doc-copy">
              <p>Node1 是一个轻量订阅服务站。你购买套餐后，系统会为你的账户开通专属订阅，并在仪表盘提供两种入口：订阅链接和单节点链接。</p>
              <ul>
                <li>推荐方式：在 Clash / Mihomo 类客户端中使用 URL 导入订阅。</li>
                <li>备用方式：复制单节点链接，手动添加到支持 VLESS REALITY 的客户端。</li>
                <li>订阅和节点都属于个人凭据，不要发到公开群、论坛或截图里。</li>
              </ul>
            </div>
          </article>
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>用户流程</h2></div>
            <div class="n-card-content doc-copy">
              <ol>
                <li>注册或登录账户。</li>
                <li>进入“购买订阅”，选择适合自己的套餐。</li>
                <li>完成订单后，等待系统或管理员开通。</li>
                <li>回到“仪表盘”，在“捷径”里点击“一键拷贝订阅”。</li>
                <li>打开 Windows 或 Android 上的 Clash / Mihomo 类应用，通过 URL 导入。</li>
              </ol>
              <p>如果客户端不支持订阅导入，可以使用“一键拷贝节点”。优先使用订阅导入，因为以后更新节点参数时更省心。</p>
            </div>
          </article>
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>密码和账户安全</h2></div>
            <div class="n-card-content doc-copy">
              <ul>
                <li>忘记密码时，进入“账户安全”或“找回密码”，使用注册邮箱接收重置邮件。</li>
                <li>重置链接有时效，并且只能使用一次。</li>
                <li>如果怀疑订阅泄漏，请联系管理员处理，不要继续把旧链接发给别人测试。</li>
                <li>客服沟通时尽量只提供注册邮箱和订单号，不要反复发送完整订阅链接。</li>
              </ul>
            </div>
          </article>
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>给运营方：订单和开通</h2></div>
            <div class="n-card-content doc-copy">
              <ul>
                <li>pending_payment：用户已创建订单，等待付款或确认。</li>
                <li>paid：已确认收款，等待开通。</li>
                <li>provisioned：已开通，用户可以在仪表盘复制订阅或节点。</li>
                <li>provision_failed：开通失败，需要检查 x-ui、节点参数或服务器状态后重试。</li>
              </ul>
              <p>处理用户问题时，优先核对订单状态、订阅到期时间、套餐流量和邮箱归属。不要在聊天记录里长期保留完整节点链接。</p>
            </div>
          </article>
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>隐私边界</h2></div>
            <div class="n-card-content doc-copy">
              <p>站点只应展示用户自己的订阅状态、订单和复制入口。页面和文档不公开后台路径、服务器密钥、数据库位置、真实私钥或其他用户信息。</p>
              <p>如果需要协助排障，可以让用户描述客户端、系统、报错和大致时间；只有在必要时再让用户私下提供订阅信息，并在处理后尽快清理。</p>
            </div>
          </article>
          <article class="n-card doc-card">
            <div class="n-card-header"><h2>常见问题</h2></div>
            <div class="n-card-content doc-copy">
              <dl class="faq-list">
                <dt>URL 导入失败怎么办？</dt>
                <dd>先确认复制的是“订阅”而不是“节点”，再检查客户端是否支持 Clash / Mihomo 订阅。</dd>
                <dt>节点能给朋友用吗？</dt>
                <dd>可以分发给指定朋友，但不要公开传播。多人长期共用可能影响稳定性和隐私。</dd>
                <dt>到期后会怎样？</dt>
                <dd>套餐到期后订阅会停止可用，需要重新购买或续费。</dd>
              </dl>
            </div>
          </article>
        </section>
        """
        return self.render("使用文档", content)

    def get_plans(self):
        con = get_db()
        products = con.execute("select * from products where active=1 order by sort_order,id").fetchall()
        con.close()
        cards = []
        for p in products:
            duration = duration_label(p["duration_days"])
            traffic = gb_label(p["traffic_gb"])
            badge = "推荐" if p["duration_days"] >= 90 or p["traffic_gb"] >= 500 else "入门"
            plan_tone = "featured" if p["duration_days"] >= 90 or p["traffic_gb"] >= 500 else "standard"
            cards.append(f"""
            <article class="plan {plan_tone}">
              <div class="plan-ribbon"></div>
              <div class="plan-head">
                <div>
                  <span class="plan-badge">{badge}</span>
                  <h2>{html.escape(p['name'])}</h2>
                </div>
                <p class="plan-price"><b>{money(p['price_cents'])}</b><span>/{duration}</span></p>
              </div>
              <div class="plan-body">
                <div class="plan-feature-grid">
                  <div><b>{traffic}</b><span>可用流量</span></div>
                  <div><b>{p['duration_days']} 天</b><span>有效期</span></div>
                  <div><b>URL</b><span>订阅导入</span></div>
                </div>
                <ul class="plan-benefits">
                  <li>开通后仪表盘复制订阅或节点</li>
                  <li>到期自动停止，减少误用风险</li>
                  <li>支持 Windows / Android Clash 类应用</li>
                </ul>
              </div>
              <form method="post" action="/orders" class="plan-cta">
                <input type="hidden" name="product_id" value="{p['id']}">
                <button type="submit">立即订阅</button>
              </form>
            </article>
            """)
        content = f"""
        <section class="page-title">
          <h1>选择最适合您的计划</h1>
          <div class="radio-tabs"><span class="active">全部</span><span>按周期</span><span>按流量</span></div>
        </section>
        <section class="grid plans">{''.join(cards)}</section>
        """
        return self.render("套餐", content)

    def get_register(self):
        return self.render("注册", form_page("注册", "/register", include_name=False, button="创建账户"))

    def post_register(self):
        form = parse_form(self.get_body())
        email = form.get("email", "").strip().lower()
        password = form.get("password", "")
        if "@" not in email or len(password) < 8:
            return self.render("注册", "<div class='notice danger'>邮箱或密码不符合要求，密码至少 8 位。</div>" + form_page("注册", "/register", button="创建账户"), 400)
        con = get_db()
        try:
            con.execute("insert into users(email,password_hash,role,created_at) values(?,?,?,?)", (email, hash_password(password), "customer", now_ms()))
            con.commit()
        except sqlite3.IntegrityError:
            con.close()
            return self.render("注册", "<div class='notice danger'>邮箱已存在。</div>" + form_page("注册", "/register", button="创建账户"), 400)
        uid = con.execute("select id from users where email=?", (email,)).fetchone()[0]
        con.close()
        self.set_session(uid)
        return self.redirect("/dashboard")

    def get_login(self):
        return self.render("登录", login_page())

    def post_login(self):
        form = parse_form(self.get_body())
        email = form.get("email", "").strip().lower()
        password = form.get("password", "")
        con = get_db()
        user = con.execute("select * from users where email=?", (email,)).fetchone()
        con.close()
        if not user or not verify_password(password, user["password_hash"]):
            return self.render("登录", "<div class='notice danger'>邮箱或密码错误。</div>" + login_page(), 401)
        self.set_session(user["id"])
        return self.redirect("/dashboard")

    def get_forgot_password(self):
        return self.render("找回密码", forgot_password_page())

    def post_forgot_password(self):
        form = parse_form(self.get_body())
        email = form.get("email", "").strip().lower()
        if PASSWORD_RESET_OPERATOR_EMAIL:
            generic_notice = "<div class='notice'>如果这个邮箱已注册，系统会通知管理员处理密码重置请求。</div>"
        else:
            generic_notice = "<div class='notice'>如果这个邮箱已注册，系统会发送一封密码重置邮件。请检查收件箱和垃圾邮件。</div>"
        if "@" not in email:
            return self.render("找回密码", generic_notice + forgot_password_page())
        con = get_db()
        user = con.execute("select id,email from users where email=?", (email,)).fetchone()
        if not user:
            con.close()
            return self.render("找回密码", generic_notice + forgot_password_page())
        token = create_password_reset_token(con, user["id"])
        con.close()
        reset_url = PUBLIC_SUB_BASE.rstrip("/") + "/reset-password?" + urllib.parse.urlencode({"token": token})
        ok, message = send_password_reset_email(user["email"], reset_url)
        if not ok:
            print(f"password reset email failed for user_id={user['id']}: {message}")
            return self.render(
                "找回密码",
                "<div class='notice danger'>邮件服务暂时不可用，请稍后重试或联系管理员。</div>" + forgot_password_page(),
                200,
            )
        return self.render("找回密码", generic_notice + forgot_password_page())

    def get_reset_password(self):
        qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        token = qs.get("token", [""])[0]
        con = get_db()
        row = find_valid_password_reset_token(con, token)
        con.close()
        if not row:
            return self.render("重置密码", "<div class='notice danger'>重置链接无效或已过期，请重新申请。</div>" + forgot_password_page(), 400)
        return self.render("重置密码", reset_password_page(token, row["email"]))

    def post_reset_password(self):
        form = parse_form(self.get_body())
        token = form.get("token", "")
        password = form.get("password", "")
        password_confirm = form.get("password_confirm", "")
        if len(password) < 8 or password != password_confirm:
            return self.render("重置密码", "<div class='notice danger'>两次输入的密码不一致，且密码至少 8 位。</div>" + reset_password_page(token), 400)
        if not reset_password_with_token(token, password):
            return self.render("重置密码", "<div class='notice danger'>重置链接无效或已过期，请重新申请。</div>" + forgot_password_page(), 400)
        return self.render("重置完成", "<div class='notice'>密码已重置，请使用新密码登录。</div>" + login_page())

    def post_payment_wechat_notify(self):
        self.get_body()
        data = b'{"code":"SUCCESS","message":"accepted"}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def post_payment_alipay_notify(self):
        self.get_body()
        data = b"success"
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def set_session(self, uid):
        self.send_response(303)
        self.send_header("Location", "/dashboard")
        self.send_header("Set-Cookie", f"sid={sign(str(uid))}; HttpOnly; SameSite=Lax; Path=/")
        self.end_headers()

    def get_logout(self):
        self.send_response(303)
        self.send_header("Location", "/plans")
        self.send_header("Set-Cookie", "sid=; Max-Age=0; Path=/")
        self.end_headers()

    @require_user
    def get_dashboard(self):
        con = get_db()
        orders = con.execute(
            """
            select o.*, p.name product_name, p.traffic_gb, p.duration_days
            from orders o join products p on p.id=o.product_id
            where o.user_id=? order by o.id desc
            """,
            (self.user["id"],),
        ).fetchall()
        subs = con.execute(
            "select * from subscriptions where user_id=? order by id desc", (self.user["id"],)
        ).fetchall()
        con.close()
        order_rows = "".join(order_row(o, customer=True) for o in orders) or "<tr><td colspan='5'>暂无订单</td></tr>"
        latest_sub = subs[0] if subs else None
        sub_card = subscription_card(latest_sub) if latest_sub else empty_subscription_card()
        shortcut_card = shortcut_panel(latest_sub)
        content = f"""
        <section class="notice-card">
          <span>公告</span>
          <h1>Node1 订阅服务</h1>
          <p>当前站点用于分发你的专属节点和订阅链接。请勿公开转发订阅地址；发现泄漏后请联系管理员处理。</p>
        </section>
        <section id="subscription" class="n-card subscription-panel">
          <div class="n-card-header"><h2>我的订阅</h2></div>
          <div class="n-card-content">{sub_card}</div>
        </section>
        {shortcut_card}
        <section id="orders" class="n-card">
          <div class="n-card-header"><h2>我的订单</h2></div>
          <div class="n-card-content table-wrap">
            <table><thead><tr><th>订单</th><th>套餐</th><th>金额</th><th>状态</th><th>操作</th></tr></thead><tbody>{order_rows}</tbody></table>
          </div>
        </section>
        """
        return self.render("用户中心", content)

    @require_user
    def get_profile(self):
        email = html.escape(self.user["email"])
