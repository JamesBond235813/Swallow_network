def now_ms():
    return int(time.time() * 1000)


def one_time_token(prefix="tok"):
    return prefix + "_" + secrets.token_urlsafe(12).replace("-", "").replace("_", "")


def hash_password(password, salt=None):
    salt = salt or secrets.token_hex(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode(), salt.encode(), 180_000).hex()
    return f"pbkdf2_sha256${salt}${digest}"


def verify_password(password, stored):
    try:
        method, salt, digest = stored.split("$", 2)
    except ValueError:
        return False
    if method != "pbkdf2_sha256":
        return False
    return hmac.compare_digest(hash_password(password, salt), stored)


def money(cents):
    return f"¥{cents / 100:.2f}"


def gb_label(gb):
    return f"{gb:g} GB"


def ms_to_date(ms):
    if not ms:
        return "-"
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ms / 1000))


def duration_label(days):
    if days >= 360:
        return "包年"
    if days >= 90:
        return "季度"
    if days >= 30:
        return "月付"
    return f"{days} 天"


def get_db():
    os.makedirs(DATA_DIR, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    con.execute("pragma foreign_keys=on")
    return con


def init_db():
    con = get_db()
    con.executescript(
        """
        create table if not exists users (
            id integer primary key autoincrement,
            email text unique not null,
            password_hash text not null,
            role text not null default 'customer',
            created_at integer not null
        );

        create table if not exists products (
            id integer primary key autoincrement,
            name text not null,
            billing_period text not null,
            duration_days integer not null,
            traffic_gb integer not null,
            price_cents integer not null,
            active integer not null default 1,
            sort_order integer not null default 100,
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists orders (
            id integer primary key autoincrement,
            order_no text unique not null,
            user_id integer not null references users(id),
            product_id integer not null references products(id),
            amount_cents integer not null,
            status text not null,
            payment_method text not null default 'manual',
            payment_ref text,
            paid_at integer,
            provisioned_at integer,
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists subscriptions (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            order_id integer not null references orders(id),
            product_id integer not null references products(id),
            email_label text not null,
            sub_id text not null,
            uuid text not null,
            traffic_bytes integer not null,
            expires_at integer not null,
            clash_url text not null,
            universal_url text not null,
            xui_status text not null,
            xui_message text,
            created_at integer not null
        );

        create table if not exists password_reset_tokens (
            id integer primary key autoincrement,
            user_id integer not null references users(id),
            token_hash text unique not null,
            expires_at integer not null,
            used_at integer,
            created_at integer not null
        );

        create index if not exists idx_password_reset_tokens_hash
        on password_reset_tokens(token_hash);

        create index if not exists idx_password_reset_tokens_user
        on password_reset_tokens(user_id);

        create table if not exists payment_settings (
            provider text primary key,
            enabled integer not null default 0,
            config_json text not null default '{}',
            created_at integer not null,
            updated_at integer not null
        );

        create table if not exists payment_transactions (
            id integer primary key autoincrement,
            order_id integer not null references orders(id),
            provider text not null,
            provider_order_no text unique not null,
            amount_cents integer not null,
            status text not null,
            request_json text not null default '{}',
            response_json text not null default '{}',
            created_at integer not null,
            updated_at integer not null
        );

        create index if not exists idx_payment_transactions_order
        on payment_transactions(order_id);
        """
    )
    admin = con.execute("select id from users where email=?", (SHOP_ADMIN_EMAIL,)).fetchone()
    if admin:
        con.execute(
            "update users set password_hash=?, role='admin' where email=?",
            (hash_password(SHOP_ADMIN_PASSWORD), SHOP_ADMIN_EMAIL),
        )
    else:
        con.execute(
            "insert into users(email,password_hash,role,created_at) values(?,?,?,?)",
            (SHOP_ADMIN_EMAIL, hash_password(SHOP_ADMIN_PASSWORD), "admin", now_ms()),
        )
    count = con.execute("select count(*) from users").fetchone()[0]
    if SHOP_SEED_DEMO_USER and count == 1:
        con.execute(
            "insert into users(email,password_hash,role,created_at) values(?,?,?,?)",
            ("user@example.com", hash_password("user123456"), "customer", now_ms()),
        )
    products = con.execute("select count(*) from products").fetchone()[0]
    if products == 0:
        seed = [
            ("轻量月付", "monthly", 30, 80, 1900, 10),
            ("标准月付", "monthly", 30, 220, 3900, 20),
            ("大流量月付", "monthly", 30, 500, 6900, 30),
            ("标准季度", "quarterly", 90, 720, 9900, 40),
            ("大流量季度", "quarterly", 90, 1600, 18900, 50),
            ("年度畅用", "yearly", 365, 3600, 59900, 60),
        ]
        for name, period, days, traffic, price, sort in seed:
            con.execute(
                """
                insert into products(name,billing_period,duration_days,traffic_gb,price_cents,active,sort_order,created_at,updated_at)
                values(?,?,?,?,?,1,?,?,?)
                """,
                (name, period, days, traffic, price, sort, now_ms(), now_ms()),
            )
    for provider in ("wechat", "alipay"):
        exists = con.execute("select provider from payment_settings where provider=?", (provider,)).fetchone()
        if not exists:
            con.execute(
                "insert into payment_settings(provider,enabled,config_json,created_at,updated_at) values(?,?,?,?,?)",
                (provider, 0, "{}", now_ms(), now_ms()),
            )
    con.commit()
    con.close()


def sign(value):
    sig = hmac.new(SESSION_SECRET.encode(), value.encode(), hashlib.sha256).hexdigest()
    return f"{value}.{sig}"


def unsign(value):
    if not value or "." not in value:
        return None
    raw, sig = value.rsplit(".", 1)
    good = hmac.new(SESSION_SECRET.encode(), raw.encode(), hashlib.sha256).hexdigest()
    if hmac.compare_digest(sig, good):
        return raw
    return None


def parse_form(body):
    return {k: v[-1] for k, v in urllib.parse.parse_qs(body.decode(), keep_blank_values=True).items()}


def decode_json(value):
    try:
        return json.loads(value or "{}")
    except json.JSONDecodeError:
        return {}


PAYMENT_CONFIG_FIELDS = {
    "wechat": {
        "title": "微信支付",
        "public": ("appid", "mch_id", "merchant_serial_no", "notify_url"),
        "secret": ("api_v3_key", "private_key_pem", "platform_cert_pem"),
    },
    "alipay": {
        "title": "支付宝",
        "public": ("app_id", "gateway_url", "notify_url", "return_url", "sign_type"),
        "secret": ("merchant_private_key", "alipay_public_key"),
    },
}


def get_payment_setting(con, provider):
    row = con.execute("select * from payment_settings where provider=?", (provider,)).fetchone()
    if row:
        return row
    con.execute(
        "insert into payment_settings(provider,enabled,config_json,created_at,updated_at) values(?,?,?,?,?)",
        (provider, 0, "{}", now_ms(), now_ms()),
    )
    con.commit()
    return con.execute("select * from payment_settings where provider=?", (provider,)).fetchone()


def get_all_payment_settings(con):
    return {provider: get_payment_setting(con, provider) for provider in PAYMENT_CONFIG_FIELDS}


def update_payment_setting(con, provider, form):
    fields = PAYMENT_CONFIG_FIELDS[provider]
    old = decode_json(get_payment_setting(con, provider)["config_json"])
    config = {}
    for key in fields["public"]:
        value = (form.get(key, "") or "").strip()
        config[key] = value
    for key in fields["secret"]:
        value = form.get(key, "")
        config[key] = value if value else old.get(key, "")
    con.execute(
        "update payment_settings set enabled=?, config_json=?, updated_at=? where provider=?",
        (1 if form.get("enabled") == "on" else 0, json.dumps(config, ensure_ascii=False), now_ms(), provider),
    )
    con.commit()


def payment_setting_ready(row):
    if not row or not row["enabled"]:
        return False
    config = decode_json(row["config_json"])
    if row["provider"] == "wechat":
        required = ("appid", "mch_id", "api_v3_key", "merchant_serial_no", "private_key_pem")
    elif row["provider"] == "alipay":
        required = ("app_id", "merchant_private_key", "alipay_public_key")
    else:
        return False
    return all((config.get(k) or "").strip() for k in required)


def create_payment_transaction(con, order_id, provider, amount_cents):
    prefix = "PWX" if provider == "wechat" else "PAL"
    provider_order_no = prefix + time.strftime("%Y%m%d%H%M%S") + secrets.token_hex(4).upper()
    now = now_ms()
    con.execute(
        """
        insert into payment_transactions(order_id,provider,provider_order_no,amount_cents,status,request_json,response_json,created_at,updated_at)
        values(?,?,?,?,?,?,?,?,?)
        """,
        (order_id, provider, provider_order_no, amount_cents, "created", "{}", "{}", now, now),
    )
    con.execute(
        "update orders set payment_method=?, payment_ref=?, updated_at=? where id=?",
        (provider, provider_order_no, now, order_id),
    )
    con.commit()
    return {"id": con.execute("select last_insert_rowid()").fetchone()[0], "provider_order_no": provider_order_no}


def token_digest(token):
    return hashlib.sha256(token.encode()).hexdigest()


def create_password_reset_token(con, user_id):
    token = secrets.token_urlsafe(32)
    now = now_ms()
    con.execute(
        "update password_reset_tokens set used_at=? where user_id=? and used_at is null",
        (now, user_id),
    )
    con.execute(
        """
        insert into password_reset_tokens(user_id,token_hash,expires_at,created_at)
        values(?,?,?,?)
        """,
        (user_id, token_digest(token), now + PASSWORD_RESET_TTL_MS, now),
    )
    con.execute("delete from password_reset_tokens where expires_at < ? or used_at is not null", (now - PASSWORD_RESET_TTL_MS,))
    con.commit()
    return token


def find_valid_password_reset_token(con, token):
    if not token:
        return None
    return con.execute(
        """
        select t.*, u.email
        from password_reset_tokens t
        join users u on u.id=t.user_id
        where t.token_hash=? and t.used_at is null and t.expires_at>=?
        """,
        (token_digest(token), now_ms()),
    ).fetchone()


def reset_password_with_token(token, new_password):
    if len(new_password or "") < 8:
        return False
    con = get_db()
    row = find_valid_password_reset_token(con, token)
    if not row:
        con.close()
        return False
    now = now_ms()
    con.execute("update users set password_hash=? where id=?", (hash_password(new_password), row["user_id"]))
    con.execute("update password_reset_tokens set used_at=? where id=?", (now, row["id"]))
    con.commit()
    con.close()
    return True


